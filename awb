    i=0; until [ -n "$(agent_pane zk1)" ]; do i=$((i + 1)); [ $i -lt 20 ] || die "selftest: zk1 pane never registered"; sleep 0.2; done
    ! "$BIN" start zk1 dup 2>/dev/null || die "selftest: start took the id of a live running agent"
