  fi
  # hot-edit safety: the dispatch is a main() function invoked at EOF, so sh
  # parses the whole executable tail before it runs and an in-place rewrite of
  # awb cannot corrupt a running board/nudge loop ("syntax error near
  # unexpected token" hit twice while awb was being edited).
  tail -1 "$BIN" | grep -Fxq 'main "$@"; exit' || die "selftest: dispatch must end in 'main "$@"; exit' (hot-edit unsafe)"

  # Hot-edit injection proof, in a SEPARATE script/process so its background
  # jobs never touch this selftest's tmux sequence. A sh that resumes reading
  # by byte offset after a blocked command (bash 3.2) can, on a LONGER
  # in-place rewrite, read bytes past the original EOF: with a bare
  # `main "$@"` tail it then executes code appended by the rewrite; the fix is
  # `main "$@"; exit` on one line. Two legal main-wrapped programs differ only
  # in that tail; each is rewritten mid-sleep to a longer file carrying an
  # INJECTED_MARKER after the tail. The bare tail MUST run the marker (proves
  # the leak), the `; exit` tail MUST NOT (proves the fix). A whole-file reader
  # (dash) never runs the marker in the probe, so the leg is skipped there.
  ha=$t/hotedit; mkdir -p "$ha"
  cat > "$ha/check.sh" <<'CHK'
#!/bin/sh
set -u
ha=$(dirname "$0")
mk() {
  { printf '#!/bin/sh\nmain() {\nsleep 1\necho MAIN_RAN\n}\n'
    i=1; while [ $i -le 2000 ]; do printf 'echo f-%s-aaaaaaaaaaaaaaaaaaaaaaaa\n' "$i"; i=$((i+1)); done
    printf '%s\n' "$2"; } > "$1"; chmod +x "$1"; }
elongate() {
  { printf '#!/bin/sh\nmain() {\nsleep 1\necho MAIN_RAN\n}\n'
    i=1; while [ $i -le 3000 ]; do printf 'echo g-%s-bbbbbbbbbbbbbbbbbbbbbbbb\n' "$i"; i=$((i+1)); done
    printf '%s\n' "$2"
    printf 'echo INJECTED_MARKER\n'; } > "$1"; }
run1() {
  mk "$ha/$1.sh" "$2"
  /bin/sh "$ha/$1.sh" </dev/null >"$ha/$1.out" 2>"$ha/$1.err" &
  p=$!; sleep 0.4; elongate "$ha/$1.sh" "$2"
  wait "$p" 2>/dev/null; echo $? >"$ha/$1.rc"; }
run1 probe 'main "$@"'
grep -q INJECTED_MARKER "$ha/probe.out" || exit 0   # whole-file reader: leak cannot occur
run1 fixed 'main "$@"; exit'
[ "$(cat "$ha/fixed.rc")" = 0 ] && grep -q MAIN_RAN "$ha/fixed.out" || exit 3
if grep -q INJECTED_MARKER "$ha/fixed.out"; then exit 4; fi  # code appended past old EOF must not run
exit 0
CHK
  /bin/sh "$ha/check.sh" </dev/null || die "selftest: hot-edit exit guard (rc $?): 'main \"$@\"; exit' must stop code appended by a longer rewrite"

  if command -v tmux >/dev/null; then
    # a board inside some tmux server must size itself from THAT server, even when AWB_DIR holds a live awb socket
    tmux -S "$t/sock" new-session -d -s decoy -x 80 -y 24 "sleep 60"
    ep=$(tmux -L "${S}e" new-session -d -x 150 -y 60 -P -F '#{pane_id}' "sleep 60")
    es=$(tmux -L "${S}e" display-message -p '#{socket_path}')
    rows=$(TMUX="$es,0,0" TMUX_PANE=$ep AWB_COLS= AWB_ROWS= AWB_VIEW=full "$BIN" render | wc -l | tr -d ' ')
    tmux -S "$t/sock" kill-server 2>/dev/null; tmux -L "${S}e" kill-server 2>/dev/null
    [ "$rows" -gt 24 ] || die "selftest: board sized from the awb socket's pane, not its own ($rows rows)"
    # a board taller than its pane scrolls: G shows the last task and the hint, g j j moves 2 lines
    sb=$t/scroll; mkdir -p "$sb"
    i=1; while [ $i -le 30 ]; do AWB_DIR=$sb "$BIN" task "s$i" wip "scroll row $i" >/dev/null; i=$((i + 1)); done
    tmux -L "${S}s" new-session -d -x 100 -y 12 "AWB_DIR=$sb AWB_COLS= AWB_ROWS= TMUX= '$BIN' watch"
    cap() { sleep 1.5; tmux -L "${S}s" capture-pane -p; }
    top=$(cap); tmux -L "${S}s" send-keys G; end=$(cap); tmux -L "${S}s" send-keys g j j; two=$(cap)
    tmux -L "${S}s" send-keys q; sleep 1; alive=$(tmux -L "${S}s" ls 2>/dev/null || true)
    tmux -L "${S}s" kill-server 2>/dev/null || true
    printf '%s\n' "$top" | grep -q '还有 .* 行' || die "selftest: a board taller than the pane shows no scroll hint"
    printf '%s\n' "$end" | grep -q 'scroll row 30' || die "selftest: G does not scroll to the last line"
    [ "$(printf '%s\n' "$two" | sed -n 1p)" = "$(printf '%s\n' "$top" | sed -n 3p)" ] \
      || die "selftest: g j j does not scroll 2 lines from the top"
    [ -z "$alive" ] || die "selftest: q does not quit the board"
  fi
  # awb-lark: one board = one topic whose root card carries every update. A fake lark-cli
  # records each call; the flow must create the topic once, then only patch that card.
  lk=$(dirname "$BIN")/awb-lark
  if [ -x "$lk" ]; then
    fb=$t/fakebin; lb=$t/lboard; mkdir -p "$fb" "$lb"
    cat > "$fb/lark-cli" <<'FAKE'
#!/bin/sh
d=$(dirname "$0")/..; printf '%s\n' "$*" >> "$d/lark.log"
c=; p=; for a; do [ "$p" = --content ] && c=$a; [ "$p" = --data ] && c=$a; p=$a; done
[ -z "$c" ] || printf '%s\n' "$c" > "$d/lark-last.json"
case "$*" in
  *is_in_chat*) echo true ;;
  *"+messages-send"*) if [ -e "$d/sent1" ]; then echo om_new; else : > "$d/sent1"; echo om_root; fi ;;
  *"messages patch"*) [ ! -e "$d/patchfail" ] ;;
  *"+messages-reply"*"interactive"*) echo om_card2 ;;
esac
FAKE
    chmod +x "$fb/lark-cli"
    lr() { AWB_DIR=$lb XDG_CONFIG_HOME=$t/xdg PATH=$fb:$PATH AWB=$BIN "$lk" "$@"; }
    lr setup oc_test >/dev/null && [ "$(cat "$t/xdg/awb/lark-chat")" = oc_test ] || die "selftest: awb-lark setup"
    AWB_DIR=$lb "$BIN" goal "L"; AWB_DIR=$lb "$BIN" start k1 kay; AWB_DIR=$lb "$BIN" now k1 "carding"
    AWB_DIR=$lb "$BIN" news "first-news"
    lr sync --dry-run | jq -e '.schema == "2.0" and .header.title.content == "L"
      and (.header.subtitle.content | startswith("lboard · 更新于"))
      and ([.body.elements[] | select(.tag == "markdown") | .content] | any(startswith("**无需你处理")))
      and ([.body.elements[] | select(.tag == "collapsible_panel") | .elements[].content] | any(test("\\*\\*kay\\*\\*")))' >/dev/null \
      || die "selftest: awb-lark card"
    lr sync; grep -c '+messages-send --chat-id oc_test --msg-type interactive' "$t/lark.log" | grep -qx 1 \
      || die "selftest: awb-lark did not create the topic once"
    cp "$t/lark.log" "$t/lark.log.first"
    jq -e '.root == "om_root"' "$lb/lark.json" >/dev/null || die "selftest: awb-lark mapping"
    # every update lands on the one card: news and needs-you are patched in, never posted
    AWB_DIR=$lb "$BIN" news "second-news"; AWB_DIR=$lb "$BIN" task q9 ask "pick-one"; : > "$t/lark.log"; lr sync
    grep -q 'messages patch --message-id om_root' "$t/lark.log" || die "selftest: awb-lark did not patch the card"
    grep -q 'second-news' "$t/lark-last.json" && grep -q 'pick-one' "$t/lark-last.json" \
      || die "selftest: the patched card lacks the new news or needs-you item"
    ! grep -q -e '+messages-send' -e '+messages-reply' "$t/lark.log" || die "selftest: an update posted a message"
    # a failed patch fails that sync only: nothing is posted, and the next sync patches the same card
    : > "$t/patchfail"; : > "$t/lark.log"; ! lr sync 2>/dev/null || die "selftest: a failed patch was reported as success"
    ! grep -q -e '+messages-send' -e '+messages-reply' "$t/lark.log" || die "selftest: a failed patch posted a message"
    rm -f "$t/patchfail"; : > "$t/lark.log"; lr sync
    grep -q 'messages patch --message-id om_root' "$t/lark.log" || die "selftest: the sync after a failed patch did not retry the card"
    # before Lark's 14-day patch limit the board moves to a new topic; the old card points there
    jq '.card_ep = 1' "$lb/lark.json" > "$lb/lark.json.t" && mv "$lb/lark.json.t" "$lb/lark.json"
    : > "$t/lark.log"; lr sync
    jq -e '.root == "om_new"' "$lb/lark.json" >/dev/null || die "selftest: an old card did not roll to a new topic"
    grep -q 'messages patch --message-id om_root' "$t/lark.log" && grep -q '新话题' "$t/lark-last.json" \
      || die "selftest: the old card does not point to the new topic"
    ! grep -q '+messages-reply' "$t/lark.log" || die "selftest: rolling over posted into the old topic"
    # the lock (model/tla/AwbLark.tla): a dead holder's lock is taken over, a live holder's
    # never is, however old; a lock directory left by awb 0.0.7 is taken over too
    sh -c 'exit 0' & dp=$!; wait $dp
    ln -s "$dp" "$lb/lock-lark"; : > "$t/lark.log"; lr sync
    grep -q 'messages patch' "$t/lark.log" || die "selftest: a dead sync's lock stopped the refresh"
    [ ! -e "$lb/lock-lark" ] || die "selftest: awb-lark left its lock behind"
    sleep 30 & lp=$!; ln -s "$lp" "$lb/lock-lark"; : > "$t/lark.log"; lr sync
    ! grep -q 'messages patch' "$t/lark.log" || die "selftest: awb-lark took a live sync's lock"
    kill $lp; wait $lp 2>/dev/null || true; rm -f "$lb/lock-lark"
    mkdir "$lb/lock-lark"; : > "$t/lark.log"; lr sync
    grep -q 'messages patch' "$t/lark.log" || die "selftest: an old lock directory stopped the refresh"
    # the topic is created with a key derived from the board, so a repeated send is deduplicated
    grep -q 'idempotency-key awb-' "$t/lark.log.first" || die "selftest: the topic was created without an idempotency key"
    # the refresh itself: a running board (watch) patches the card on its own, again and
    # again, and each patch carries the board's latest state
    : > "$t/lark.log"
    AWB_DIR=$lb XDG_CONFIG_HOME=$t/xdg PATH=$fb:$PATH AWB_LARK_EVERY=1 AWB_INTERVAL=0.2 "$BIN" watch >/dev/null 2>&1 &
    wp=$!
    i=0; until [ "$(grep -c 'messages patch' "$t/lark.log")" -ge 2 ]; do
      i=$((i + 1)); [ $i -lt 40 ] || { kill $wp; die "selftest: the board did not refresh its Lark card"; }; sleep 0.25; done
    AWB_DIR=$lb "$BIN" now k1 "refresh-probe"; AWB_DIR=$lb "$BIN" news "news-while-watching"
    i=0; until grep -q 'refresh-probe' "$t/lark-last.json" 2>/dev/null && grep -q 'news-while-watching' "$t/lark-last.json"; do
      i=$((i + 1)); [ $i -lt 40 ] || { kill $wp; die "selftest: a refresh did not carry the new state"; }; sleep 0.25; done
    kill $wp; wait $wp 2>/dev/null || true
    ! grep -q -e '+messages-send' -e '+messages-reply' "$t/lark.log" || die "selftest: a refresh posted a message"
  fi
  [ ! -s "$t/guard/calls" ] || die "selftest: a test reached lark-cli: $(head -1 "$t/guard/calls")"
  echo "selftest ok"
}

# Dispatch lives in main(), invoked at EOF and followed by `; exit` on the
# SAME line. Wrapping makes the executable tail a function sh fully parses
# before the call, and the exit stops sh from re-reading bytes a LONGER
# in-place rewrite appends past the original EOF (bash 3.2 resumes by byte
# offset after a blocked command). Without both, a hot edit either desyncs a
# running board/nudge loop ("syntax error near unexpected token") or runs
# newly appended code after main returns.
main() {
cmd=${1:-}; shift 2>/dev/null || true
# `awb up --help` used to start a session and create AWB_DIR in the cwd; help never has side effects
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
case "$cmd" in
  up)       up "$@" ;;
  down)     init_dir; tm kill-session -t awb 2>/dev/null || true ;;
  run)      run "$@" ;;
  tui)      tui "$@" ;;
  start)
    [ $# -ge 1 ] || die "usage: $PROG start ID NAME [KIND] [GROUP]"
    append '{t:"start",time:$time,ep:$ep,id:$id,name:$name,kind:$kind,pane:$pane,group:$group}' \
      --arg id "$1" --arg name "${2:-$1}" --arg kind "${3:-agent}" --arg pane "" \
      --arg group "${4:-default}"
    ;;
  task)     [ $# -ge 2 ] || die "usage: $PROG task ID STATE [TEXT] [PARENT] [OWNER]"
            case $2 in todo|wip|review|blocked|done|drop|ask) ;; *) die "state: todo|wip|review|blocked|done|drop|ask" ;; esac
            append '{t:"task",time:$time,ep:$ep,id:$id,state:$st,text:$text,parent:$par,owner:$own}' \
              --arg id "$1" --arg st "$2" --arg text "${3:-}" --arg par "${4:-}" --arg own "${5:-}" ;;
  stale)    init_dir; now=$(date +%s)
            { [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s -r --argjson now "$now" --argjson stale "${AWB_STALE:-600}" '
              rtrimstr("\n") | if . == "" then [] else split("\n") | map(fromjson? | select(type == "object")) end
              | reduce .[] as $e ({};
                  if $e.id == null or $e.t == "nudge" then .
                  elif $e.t == "status" then .[$e.id].last = $e.ep | .[$e.id].st = $e.status
                  elif $e.t == "now" then .[$e.id].last = $e.ep | .[$e.id].st = (if .[$e.id].st == "done" then "running" else (.[$e.id].st // "running") end)
                  elif ($e.t | IN("start","done")) then .[$e.id].last = $e.ep | .[$e.id].st = (.[$e.id].st // "running")
                  else . end)
              | to_entries[] | select(.value.st == "running" and $now - .value.last >= $stale)
              | "\(.key) \((($now - .value.last) / 60) | floor)"'
            # agents on a permission dialog, whatever they reported: "ID MINUTES waiting"
            sessions_json | jq -r --argjson now "$now" 'to_entries[] | select(.value.status == "waiting")
              | "\(.key) \((($now - .value.since) / 60) | floor) waiting"' ;;
  nudge)    init_dir; if [ "${1:-}" = "--once" ]; then nudge_once
            else while :; do nudge_once; sleep "${AWB_NUDGE_POLL:-60}"; done; fi ;;
  news)     [ $# -ge 1 ] || die "usage: $PROG news TEXT"
            append '{t:"news",time:$time,ep:$ep,text:$text}' --arg text "$*" ;;
  goal)     [ $# -ge 1 ] || die "usage: $PROG goal TEXT"
            append '{t:"goal",time:$time,ep:$ep,text:$text}' --arg text "$*" ;;
  metric)   # --at EPOCH records a past reading at its own time; --step N is its x (a training step)
            _at=; _x=
            while :; do case "${1:-}" in
              --at) _at=${2:-}; shift 2 || die "--at needs an epoch" ;;
              --step) _x=${2:-}; shift 2 || die "--step needs a number" ;;
              *) break ;; esac; done
            [ $# -ge 3 ] || die "usage: $PROG metric [--at EPOCH] [--step N] NAME VALUE TARGET [NOTE]"
            # jq tonumber rejects '1.2.3'/'-'/''; the finite/self-equal guard
            # additionally rejects NaN/Infinity (jq 1.8 has no finite/0).
            _numok='tonumber as $n | $n == $n and $n < 1e309 and $n > -1e309'
            printf '%s' "$2" | jq -eR "$_numok" >/dev/null || die "metric VALUE must be numeric (got: $2)"
            printf '%s' "$3" | jq -eR "$_numok" >/dev/null || die "metric TARGET must be numeric (got: $3)"
            # render-only: no id / agent. The fold's `($e.id|type)!="string" or
            # .agents[id]==null` arm (matching Lean parseLine's `_ => none`)
            # drops the unknown event, so it never reaches agent state; render
            # reads it from the same piped event array, not a second log read.
            [ -z "$_at" ] || printf '%s' "$_at" | grep -Eqx '[0-9]{9,11}' || die "--at wants epoch seconds (got: $_at)"
            [ -z "$_x" ] || printf '%s' "$_x" | jq -eR "$_numok" >/dev/null || die "--step must be numeric (got: $_x)"
            append '{t:"metric", name:$name, value:($value|tonumber), target:($target|tonumber), note:$note}
                    + (if $at == "" then {time:$time, ep:$ep}
                       else ($at | tonumber) as $a | {time:($a | strflocaltime("%H:%M:%S")), ep:$a} end)
                    + (if $x == "" then {} else {x:($x | tonumber)} end)' \
              --arg name "$1" --arg value "$2" --arg target "$3" --arg note "${4-}" --arg at "$_at" --arg x "$_x" ;;
  now)      [ $# -ge 2 ] || die "usage: $PROG now ID MILESTONE"
            append '{t:"now",time:$time,ep:$ep,id:$id,text:$text}' --arg id "$1" --arg text "${2-}" ;;
  done)     [ $# -ge 1 ] || die "usage: $PROG done ID [TEXT]"
            append '{t:"done",time:$time,ep:$ep,id:$id,text:(if $text == "" then null else $text end)}' \
              --arg id "$1" --arg text "${2:-}" ;;
  block)    [ $# -ge 2 ] || die "usage: $PROG block ID REASON"
            append '{t:"status",time:$time,ep:$ep,id:$id,status:"blocked",reason:$r}' \
              --arg id "$1" --arg r "${2-}" ;;
  unblock)  [ $# -ge 1 ] || die "usage: $PROG unblock ID"
            append '{t:"status",time:$time,ep:$ep,id:$id,status:"running",reason:""}' --arg id "$1" ;;
  fail)     [ $# -ge 2 ] || die "usage: $PROG fail ID REASON"
            append '{t:"status",time:$time,ep:$ep,id:$id,status:"failed",reason:$r}' \
              --arg id "$1" --arg r "${2-}" ;;
  finish)   [ $# -ge 1 ] || die "usage: $PROG finish ID [NOTE]"
            append '{t:"done",time:$time,ep:$ep,id:$id,text:(if $text == "" then null else $text end)}' \
              --arg id "$1" --arg text "${2:-}"
            append '{t:"status",time:$time,ep:$ep,id:$id,status:"done",reason:""}' --arg id "$1" ;;
  status)   [ $# -ge 2 ] || die "usage: $PROG status ID running|blocked|failed|done [REASON]"
            case $2 in running|blocked|failed|done) ;; *) die "status: running|blocked|failed|done" ;; esac
            append '{t:"status",time:$time,ep:$ep,id:$id,status:$st,reason:$r}' \
              --arg id "$1" --arg st "$2" --arg r "${3:-}" ;;
  reset)    init_dir; : > "$EV" ;;
  render)   init_dir; render ;;
  snapshot) init_dir; ( AWB_VIEW=snapshot AWB_COLS=100 AWB_ROWS=200; export AWB_VIEW AWB_COLS AWB_ROWS; render ) ;;
  watch)    init_dir; watch ;;
  _enter)   _enter ;;
  _leave)   _leave "${1:-0}" ;;
  check)    check "$@" ;;
  pr)       pr "$@" ;;
  send)     send "$@" ;;
  reply)    reply "$@" ;;
  idle)     idle "$@" ;;
  pending)  pending ;;
  state)    state ;;
  board)    board ;;
  audit)    audit ;;
  version|--version|-V) echo "$PROG $VERSION" ;;
  skill)    skill ;;
  tell)     tell "$@" ;;
  peers)    peers ;;
  selftest) selftest ;;
  ""|-h|--help|help) usage ;;
  *) usage; die "unknown command: $cmd" ;;
esac
}

main "$@"; exit
