  AWB_VIEW=full "$BIN" render | grep -q "◔ rerun" || die "selftest: re-start kept done"
  ! "$BIN" status r1 bogus 2>/dev/null || die "selftest: bogus status accepted"

  if command -v tmux >/dev/null; then
    boardpane=$(tmux -L "$S" new-session -d -s awb -n board -x 200 -y 120 -P -F '#{pane_id}' \
      "AWB_VIEW=full AWB_DIR=$(q "$t") $(q "$BIN") watch")
    work=$(tmux -L "$S" split-window -v -t "$boardpane" -d -p 60 -P -F '#{pane_id}' "$SHELL")
    sleep 1
    cap=$(tmux -L "$S" capture-pane -p -t "$boardpane")
    printf '%s' "$cap" | grep -Fq "SHIP THE WORKBENCH" || die "selftest: board not live-rendering"

    printf '%s\n' "$work" > "$t/work-pane"
    tmux -L "$S" send-keys -t "$work" "export AWB_DIR=$(q "$t")" Enter
    tmux -L "$S" send-keys -t "$work" "$(q "$BIN") run z1 demo -- sleep 2" Enter
    # poll the live board, capped at 10s per expectation
    seen() { i=0; while [ $i -lt 20 ]; do
      tmux -L "$S" capture-pane -p -t "$boardpane" | grep -Fq -- "$1" && return 0
      sleep 0.5; i=$((i + 1)); done; return 1; }
    seen "demo" || die "selftest: spawned agent not shown"
    seen "✓1" || die "selftest: exit 0 not marked done"
    AWB_TMUX_SOCKET=$(tmux -L "$S" display-message -p '#{socket_path}') "$BIN" tell z1 "echo told-\$((6*7))"
    i=0; until tmux -L "$S" capture-pane -p -t "$(agent_pane z1)" | grep -q told-42; do
      i=$((i + 1)); [ $i -lt 20 ] || die "selftest: tell not delivered"; sleep 0.5; done
    # a process that unlocked must not remove, when it exits, the lock another one took since
    ( lock t9; unlock t9; sleep 0.5 ) &
    sleep 0.2; ( lock t9; sleep 0.6; [ -d "$AWB_DIR/lock-t9" ] ) || die "selftest: an exiting process removed another's lock"
    wait; unlock t9
    # concurrent tells into one pane arrive as two separate commands
    AWB_TMUX_SOCKET=$(tmux -L "$S" display-message -p '#{socket_path}'); export AWB_TMUX_SOCKET
    "$BIN" tell z1 "echo told-A" & "$BIN" tell z1 "echo told-B" & wait
    sleep 1; cap=$(tmux -L "$S" capture-pane -p -t "$(agent_pane z1)")
    { printf '%s\n' "$cap" | grep -qx "told-A" && printf '%s\n' "$cap" | grep -qx "told-B"; } \
      || die "selftest: concurrent tells merged or lost"

    # tell must confirm a paste actually submitted. A real Claude pane does NOT
    # end on the input line: it is `❯ <text>`, then a divider, then a ⏵⏵
    # footer. faketui mirrors that: while pending it draws the `❯` input line
    # with a divider + footer BELOW it (so the input is not the last screen
    # line -- a probe that only reads the tail would miss it, as in review);
    # on submit the input clears to `❯` and a sentinel footer appears.
    cat > "$t/faketui.sh" <<'FT'
#!/bin/sh
# read the pasted line (tell's first Enter ends this read), then need NEED more
# Enters while the pasted text stays in the ❯ input box (with footer below);
# on submit the box clears to an empty ❯ and the sentinel is the footer.
read -r pending
i=0
while [ "$i" -lt "$1" ]; do
  printf '❯ %s\n' "$pending"
  printf -- '────────────────────────────\n'
  printf '  ⏵⏵ fake-footer\n'
  read -r _x; i=$((i+1))
done
printf '❯\n'
printf -- '────────────────────────────\n'
printf 'FAKE_SUBMITTED_OK\n'; sleep 2
FT
    chmod +x "$t/faketui.sh"
    ft_paste() { # $1=NEED
      tmux -L "$S" new-window -d -P -F '#{pane_id}' "$t/faketui.sh $1"; }
    # positive: TUI needs 1 extra Enter; tell (default max 2) must succeed
    fp=$(ft_paste 1)
    printf 'ft %s\n' "$fp" > "$t/panes"
    # a loaded machine redraws slowly; the settle time is not what this case tests
    AWB_DIR=$t AWB_TMUX_SOCKET=$AWB_TMUX_SOCKET AWB_TELL_SETTLE=1.5 "$BIN" tell ft "ft-marker-ok-1234567890" \
      || die "selftest: tell gave up on a TUI that submits on the 2nd Enter"
    sleep 0.6
    tmux -L "$S" capture-pane -J -p -t "$fp" | grep -Fq "FAKE_SUBMITTED_OK" \
      || die "selftest: tell reported success but the TUI never submitted"
    # negative control: TUI needs 3 extra Enters; with max 2 tell MUST fail.
    # The stuck input shows Claude's collapsed-paste style for this marker too.
    fb=$(ft_paste 3)
    printf 'ft %s\n' "$fb" > "$t/panes"
    ! AWB_DIR=$t AWB_TMUX_SOCKET=$AWB_TMUX_SOCKET AWB_TELL_MAX_ENTER=2 \
        AWB_TELL_SETTLE=0.2 "$BIN" tell ft "ft-marker-bad-0987654321" 2>/dev/null \
      || die "selftest: tell returned 0 though the text stayed unsubmitted"
    # collapsed-paste case: input line holds "[Pasted text #1 +N lines]", not
    # the text; tell must still treat it as unsubmitted.
    fc=$(ft_paste 3)
    printf 'ft %s\n' "$fc" > "$t/panes"
    ! AWB_DIR=$t AWB_TMUX_SOCKET=$AWB_TMUX_SOCKET AWB_TELL_MAX_ENTER=1 \
        AWB_TELL_SETTLE=0.2 "$BIN" tell ft "[Pasted text #7 +3 lines]" 2>/dev/null \
      || die "selftest: collapsed [Pasted text] placeholder treated as submitted"
    tmux -L "$S" kill-window -t "$fp" 2>/dev/null || true
    tmux -L "$S" kill-window -t "$fb" 2>/dev/null || true
    tmux -L "$S" kill-window -t "$fc" 2>/dev/null || true
    # session truth from a fake ~/.claude/sessions entry on z1's pane (pid = this shell):
    # A. a permission dialog shows on the board and in stale, and tell will not type into it;
    # B. a self-report the session contradicts is flagged. Each has its negative control.
    zp=$(agent_pane z1); zs=$(tmux -L "$S" display-message -p -t "$zp" '#{session_name}')
    mkdir -p "$t/home/.claude/sessions"
    reg() { printf '{"pid":%s,"name":"zz-1","status":"%s","waitingFor":"%s","startedAt":1,"statusUpdatedAt":%s000,"tmux":"%s:@0.%s"}\n' \
              $$ "$1" "${2-}" "$(($(date +%s) - ${3:-0}))" "$zs" "$zp" > "$t/home/.claude/sessions/1.json"; }
    ht() { HOME=$t/home "$BIN" "$@"; }
    reg waiting "permission prompt"
    ht render | grep -Fq "待批准：permission prompt" || die "selftest: permission dialog not on the board"
    ht stale | grep -Eq '^z1 [0-9]+ waiting$' || die "selftest: permission dialog not in stale"
    ! ht tell z1 "echo typed-into-dialog" 2>/dev/null || die "selftest: tell typed into a permission dialog"
    # a dialog reported after the paste stops the Enter
    reg idle; ( sleep 0.2; reg waiting "permission prompt" ) &
    ! ht tell z1 "echo mid-tell-enter" 2>/dev/null || die "selftest: tell ignored a dialog opened mid-tell"
    wait; sleep 0.3
    ! tmux -L "$S" capture-pane -p -t "$zp" | grep -qx "mid-tell-enter" || die "selftest: tell pressed Enter into a dialog opened mid-tell"
    tmux -L "$S" send-keys -t "$zp" C-u
    reg idle
    ! ht render | grep -Fq "待批准" || die "selftest: idle session shown as waiting for approval"
    ! ht stale | grep -q waiting || die "selftest: idle session listed as waiting"
    reg busy        # z1 reported done
    ht render | grep -Fq "自报完成，会话在忙" || die "selftest: done agent with a busy session not flagged"
    reg idle
    ! ht render | grep -Fq "会话在忙" || die "selftest: done agent with an idle session flagged"
    "$BIN" now z1 "still going"
    reg idle "" 900
    ht render | grep -Fq "自报进行，会话空闲" || die "selftest: running agent idle 15m not flagged"
    reg idle "" 10
    ! ht render | grep -Fq "会话空闲" || die "selftest: running agent idle 10s flagged"
    "$BIN" finish z1
    [ "$(ht peers | grep '^z1 ')" = "z1 $zp zz-1 idle" ] || die "selftest: peers lost the session"
    # a pane given as session:window.pane in .awb/panes resolves to the same session
    printf 'zt %s\n' "$(tmux -L "$S" display-message -p -t "$zp" '#{session_name}:#{window_index}.#{pane_index}')" >> "$t/panes"
    [ "$(ht peers | grep '^zt ')" = "zt $zp zz-1 idle" ] || die "selftest: a session:window.pane target was not resolved"
    unset AWB_TMUX_SOCKET

    # no-code-change detection drives the REAL freeze_once, not just render:
    # (a) a milestone done without finish keeps the agent running+fingerprinted;
    # (b) one dead pane must not abort the poll and drop the live agent's row.
    fz=$t/fz; gf=$t/gitrepo; mkdir -p "$fz" "$gf"
    ( cd "$gf" && git init -q && echo hi > f && git add -A \
        && git -c user.email=a@b -c user.name=a commit -qm init )
    fsock=$(tmux -L "$S" display-message -p '#{socket_path}')
    pl=$(tmux -L "$S" new-window -d -P -F '#{pane_id}' "$SHELL")
    pd=$(tmux -L "$S" new-window -d -P -F '#{pane_id}' "$SHELL")
    tmux -L "$S" kill-pane -t "$pd"; sleep 0.5
    AWB_DIR=$fz "$BIN" start zl liveagent >/dev/null
    AWB_DIR=$fz "$BIN" now zl "t1" >/dev/null
    AWB_DIR=$fz "$BIN" done zl >/dev/null          # milestone done, NO finish
    AWB_DIR=$fz "$BIN" start zd deadagent >/dev/null
    AWB_DIR=$fz "$BIN" now zd "t1" >/dev/null
    printf 'zl %s %s\nzd %s %s\n' "$pl" "$gf" "$pd" "$gf" > "$fz/panes"
    AWB_DIR=$fz AWB_TMUX_SOCKET=$fsock AWB_FROZEN=0 "$BIN" nudge --once
    grep -q '^zl ' "$fz/diffs" || die "selftest: milestone done agent lost from freeze scan"
    grep -q '^zd ' "$fz/diffs" || die "selftest: dead-pane agent row not written"
    sleep 0.6
    tmux -L "$S" capture-pane -p -t "$pl" | grep -Fq "没有代码改动" \
      || die "selftest: live frozen agent not reminded past a dead pane"
  fi
  "$BIN" start zf frozen; "$BIN" now zf "idle"
  "$BIN" start zfb blk; "$BIN" now zfb "wait"; "$BIN" block zfb "remote job"
  printf 'zf 1 %s\nzfb 1 %s\n' "$(($(date +%s) - 1000))" "$(($(date +%s) - 1000))" > "$t/diffs"
  fr=$("$BIN" render)
  printf '%s' "$fr" | grep -F " frozen " | grep -Fq "无改动 " || die "selftest: stale fingerprint not shown frozen"
  ! printf '%s' "$fr" | grep -F " blk " | grep -Fq "无改动" || die "selftest: blocked agent marked frozen"
  printf 'zf 1 %s\nzfb 1 %s\n' "$(date +%s)" "$(date +%s)" > "$t/diffs"
  ! "$BIN" render | grep -Fq "无改动 " || die "selftest: fresh fingerprint shown frozen"
  "$BIN" skill | grep -q "awb check" || die "selftest: skill manual not found"
  if m=$(model_bin); then
    "$BIN" audit | grep -q "^g1 done-while-check-rejected" || die "selftest: audit missed done after rejection"
    # fixed differential case: unknown events with NO id (and unknown t with an
    # id that never started) interleaved with real ones must be ignored by both
    # folds -- this pins jq's `($e.id|type)!="string" or .agents[id]==null` arm
    # to Lean parseLine's `_ => none`.
    mkdir -p "$t/diff0"
    printf '%s\n' \
      '{"t":"start","id":"u","name":"u","ep":1}' \
      '{"t":"weird-no-id","ep":2}' \
      '{"t":"now","id":"u","ep":3,"text":"m"}' \
      '{"t":"zzz","ep":4}' \
      '{"t":"status","id":"ghost","status":"running","ep":5}' \
      '{"t":"done","id":"u","ep":6}' > "$t/diff0/events.jsonl"
    a0=$(AWB_DIR=$t/diff0 "$BIN" state); b0=$("$m" fold < "$t/diff0/events.jsonl")
    [ "$a0" = "$b0" ] || { printf 'jq:\n%s\nlean:\n%s\n' "$a0" "$b0" >&2; die "selftest: jq/Lean differ on unknown events"; }
    # differential test: jq fold (awb state) vs the proven Lean fold on random logs
    mkdir -p "$t/diff"; n=0
    while [ $n -lt "${AWB_DIFF_N:-200}" ]; do
      n=$((n + 1))
      "$m" gen $n 80 > "$t/diff/events.jsonl"
      a=$(AWB_DIR=$t/diff "$BIN" state); b=$("$m" fold < "$t/diff/events.jsonl")
      [ "$a" = "$b" ] || { printf 'jq:\n%s\nlean:\n%s\n' "$a" "$b" >&2; die "selftest: jq fold != Lean model (awbmodel gen $n 80)"; }
      # every 4th log: the brief view's sections (awb snapshot) match Brief.sec, which is
      # proven to show every agent; each agent must appear in exactly one section
      if [ $((n % 4)) = 0 ]; then
        a=$(AWB_DIR=$t/diff "$BIN" snapshot 2>"$t/diff/err" | jq -r '[(.agents[] | "\(.id) work"), (.idle[] | "\(.id) idle"),
              (.need[] | select(.kind == "fail") | "\(.id) need")] | sort[]')
        b=$("$m" brief < "$t/diff/events.jsonl")
        [ "$a" = "$b" ] || { printf 'jq:\n%s\nlean:\n%s\n' "$a" "$b" >&2; die "selftest: brief sections != Lean Brief.sec (awbmodel gen $n 80)"; }
