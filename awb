#!/bin/sh
# awb — tmux agent workbench.
# Source of truth: .awb/events.jsonl (append-only). Any agent that can exec a
# process can drive the board; the renderer shows goals and milestones, never
# agent process output.
set -eu

VERSION=0.0.12
PROG=$(basename "$0")
AWB_SET=${AWB_DIR:+1}   # empty: the board is ./.awb by default, which must already exist
AWB_DIR=${AWB_DIR:-$PWD/.awb}
# awb exports its tmux socket into the panes it opens, with the board it belongs to
# (AWB_TMUX_FOR). Under another AWB_DIR the socket is not used: a worker that experiments with
# its own board, or runs the selftest, once killed its parent board and every worker on it.
if [ -n "${AWB_TMUX_FOR:-}" ] && [ "$(cd "$AWB_DIR" 2>/dev/null && pwd)" != "$AWB_TMUX_FOR" ]; then
  unset AWB_TMUX_SOCKET AWB_TMUX_FOR
fi
EV=$AWB_DIR/events.jsonl
TS_FMT=%H:%M:%S
ESC=$(printf '\033')

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

init_dir() {
  # a command without AWB_DIR in a directory with no board once started a new board there
  # silently, and the writes of an agent that forgot AWB_DIR went to it: only awb up makes one
  if [ -z "$AWB_SET" ] && [ ! -d "$AWB_DIR" ] && [ "${cmd:-}" != up ]; then
    die "no board in $PWD (.awb): set AWB_DIR to the board, or start one here with '$PROG up'"
  fi
  mkdir -p "$AWB_DIR" || die "cannot create $AWB_DIR"
  AWB_DIR=$(cd "$AWB_DIR" && pwd)
  EV=$AWB_DIR/events.jsonl
}

# append '<jq filter>' [jq args...] — $time (clock) and $ep (epoch) available
append() {
  init_dir
  _f=$1; shift
  jq -cn --arg time "$(date +$TS_FMT)" --argjson ep "$(date +%s)" "$_f" "$@" >> "$EV"
  # once per command, so a caller sees which board it wrote to
  [ -n "${AWB_TOLD:-}" ] || { AWB_TOLD=1; printf '%s: recorded in %s\n' "$PROG" "$AWB_DIR" >&2; }
}

q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# tmux socket; unix socket paths are capped near 104 bytes, deep dirs fall back to /tmp
sock_path() {
  _s=$AWB_DIR/sock
  [ ${#_s} -lt 100 ] || _s=/tmp/awb-$(id -u)-$(printf %s "$AWB_DIR" | cksum | cut -d' ' -f1).sock
  printf %s "$_s"
}

# talk to the awb server even when called outside its tmux (main agent, nested sessions)
tm() {
  if [ -n "${AWB_TMUX_SOCKET:-}" ] && [ -S "$AWB_TMUX_SOCKET" ]; then tmux -S "$AWB_TMUX_SOCKET" "$@"
  elif [ -S "$(sock_path)" ]; then tmux -S "$(sock_path)" "$@"
  else tmux "$@"; fi
}

BIN=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")

# event fold: the state machine modelled and proven in model/AwbModel.lean;
# `awb _state` prints it for the differential test against the compiled model
JQ_FOLD='
# an open sent task ends without a reply: lost (a restart, a failure, a newer task), or
# finished (awb finish, the run exited 0) with no result
def lose($id): (.agents[$id].key // null) as $k
  | if $k == null then . else .tasks[$k].state = "drop" | .tasks[$k].lost = true | .agents[$id].key = null end;
def finish($id): (.agents[$id].key // null) as $k
  | if $k == null then . else .tasks[$k].state = "done" | .agents[$id].key = null end;
def fold:
reduce (. // [])[] as $e (
  {goal:"", agents:{}, gorder:{}, gseen:[], tasks:{}, torder:[], news:[], checks:{}};
  if   $e.t == "goal" then .goal = $e.text
  elif $e.t == "news" then .news += [{text:$e.text, time:($e.time // ""), key:($e.key // "")}]
  elif $e.t == "task" then
    (if .tasks[$e.id] == null then .torder += [$e.id] else . end)
    | .tasks[$e.id] = ((.tasks[$e.id] // {id:$e.id, state:"todo", text:$e.id, parent:"", owner:""})
        + ({state:$e.state, text:$e.text, parent:$e.parent, owner:$e.owner}
           | with_entries(select(.value != null and .value != ""))))
  elif $e.t == "start" then
    if .agents[$e.id] != null then
      lose($e.id)
      | .agents[$e.id] += {status:"running", reason:"", endEp:null,
                         pane:($e.pane // .agents[$e.id].pane), lastEp:($e.ep // .agents[$e.id].lastEp)}
    else ($e.group // "default") as $g
      | .agents[$e.id] = {id:$e.id, name:($e.name // $e.id), kind:($e.kind // "agent"),
                          pane:($e.pane // ""), group:$g, status:"running",
                          current:null, done:[], reason:"", gate:false, key:null,
                          startEp:($e.ep // 0), lastEp:($e.ep // 0), endEp:null}
      | .gorder[$g] = ((.gorder[$g] // []) + [$e.id])
      | (if (.gseen | index($g)) then . else .gseen += [$g] end)
    end
  elif $e.t == "chk" then
    (if (.checks[$e.id].run // "") != $e.run
     then .checks[$e.id] = {id:$e.id, what:$e.what, run:$e.run, startEp:$e.ep, steps:[]} else . end)
    | (.checks[$e.id].steps | map(.s) | index($e.step)) as $i
    | if $i == null then .checks[$e.id].steps += [{s:$e.step, state:$e.state, ep0:$e.ep, ep1:null, note:""}]
      else .checks[$e.id].steps[$i] += {state:$e.state, ep1:$e.ep, note:$e.note} end
  elif ($e.id | type) != "string" or .agents[$e.id] == null then .
  elif $e.t == "now" then
    (if .agents[$e.id].status == "done" then .agents[$e.id].status = "running" | .agents[$e.id].endEp = null | .agents[$e.id].reason = "" else . end)
    | .agents[$e.id].current = {text:($e.text // ""), time:($e.time // ""), ep:($e.ep // 0)}
    | .agents[$e.id] += {status:"running", reason:"", endEp:null}
    | .agents[$e.id].lastEp = ($e.ep // .agents[$e.id].lastEp)
    # awb send: the task is a node of the task tree, owned by the worker; its key is its id
    | if ($e.key // "") == "" then .
      else lose($e.id) | .agents[$e.id] += {key:$e.key, keyEp:($e.ep // 0), sent:true}
        | (if .tasks[$e.key] == null then .torder += [$e.key] else . end)
        # a planned task sent as it is (awb send ID TASKID) keeps its text and parent
        | .tasks[$e.key] = (((.tasks[$e.key] | select(. != null and (.state | IN("done","drop") | not)))
                               // {text:($e.text // ""), parent:""})
            + {id:$e.key, state:"wip", owner:$e.id} + (if ($e.parent // "") == "" then {} else {parent:$e.parent} end))
      end
  elif $e.t == "done" then
    (.agents[$e.id]) as $a | ($e.ep // $a.lastEp) as $ep
    # a passing check with no open milestone verifies the last finished one
    | (if $e.verified and $a.current == null and $e.text == null and ($a.done | length) > 0
       then .agents[$e.id].done[-1].text |= (if startswith("⊢ ") then . else "⊢ " + . end)
       else .agents[$e.id].done += [{text:((if $e.verified then "⊢ " else "" end) + ($e.text // $a.current.text // "milestone")),
                                     time:($e.time // ""), dur:([0, $ep - ($a.current.ep // $ep)] | max)}] end)
    | .agents[$e.id].current = null
    | .agents[$e.id].lastEp = $ep
    # awb reply: the reply closes the task with its key and keeps the result
    | (if ($e.key // "") != "" and .agents[$e.id].key == $e.key
       then .tasks[$e.key] += {state:"done", result:($e.text // "")} | .agents[$e.id].key = null else . end)
    | (if $e.verified then .agents[$e.id].gate = false
         | (if .agents[$e.id].status == "failed"
            then .agents[$e.id] += {status:"running", reason:"", endEp:null} else . end)
       else . end)
  elif $e.t == "status" and (($e.status // "running") | IN("running","blocked","failed","done") | not) then .
  elif $e.t == "status" and $e.status == "done" and .agents[$e.id].gate then
    .agents[$e.id] += {status:"failed", endEp:($e.ep // 0)}
  elif $e.t == "status" then
    (if $e.status == "done" then finish($e.id) elif $e.status == "failed" then lose($e.id) else . end)
    | .agents[$e.id].gate = (.agents[$e.id].gate or ($e.gate == true))
    | .agents[$e.id].status = ($e.status // "running")
    | .agents[$e.id].reason = ($e.reason // "")
    | .agents[$e.id].lastEp = ($e.ep // .agents[$e.id].lastEp)
    | (if ($e.status == "done" or $e.status == "failed") then .agents[$e.id].endEp = ($e.ep // 0)
       elif ($e.status == "running" or $e.status == "blocked") then .agents[$e.id].endEp = null
       else . end)
  else . end);
'

# formatting helpers shared by the snapshot (JQ_SNAP) and the brief view drawn from it (JQ_BRIEF)
JQ_DEFS='
def wide($c):
  ($c >= 4352 and $c <= 4447) or ($c >= 11904 and $c <= 42191)
  or ($c >= 44032 and $c <= 55203) or ($c >= 63744 and $c <= 64255)
  or ($c >= 65072 and $c <= 65103) or ($c >= 65280 and $c <= 65376)
  or ($c >= 65504 and $c <= 65510) or ($c >= 131072 and $c <= 262141);
def cw($c): if wide($c) then 2 else 1 end;
def dwidth: [explode[] | cw(.)] | add // 0;
def clip($n):
  (gsub("[[:cntrl:]]"; " ")) as $s
  | if $n <= 0 then ""
    elif ($s | dwidth) <= $n then $s
    else ([($s | explode[]) as $c | {c:$c, w:cw($c)}]
          | reduce .[] as $x ({a:[], w:0};
              if .w + $x.w > ($n - 1) then .
              else .a += [$x.c] | .w += $x.w end)
          | (.a | implode) + "…")
    end;
def pad($n):
  . as $s | ($n - ($s | dwidth)) as $slack
  | if $slack <= 0 then $s else $s + (" " * $slack) end;
def pad2: if . < 10 then "0" + tostring else tostring end;
def sdur:
  if . == null then "·"
  elif . < 60 then "\(.)s"
  elif . < 3600 then "\((. / 60 | floor)):\((. % 60) | pad2)"
  else "\((. / 3600 | floor)):\(((. % 3600) / 60 | floor) | pad2):\((. % 60) | pad2)" end;
def ago: if . >= 86400 then "\((. / 8640 | floor) / 10)天" elif . >= 3600 then "\(. / 3600 | floor)小时"
  else "\(. / 60 | floor)分钟" end;
def spark($mx): map(if $mx > 0 then (. / $mx * 7 | floor | if . < 0 then 0 elif . > 7 then 7 else . end) else 0 end
  | ["▁","▂","▃","▄","▅","▆","▇","█"][.]) | add;
def bar($d; $t; $n):
  (if $t == 0 then 0 else ($d * $n / $t | floor) end) as $f
  | ("█" * $f) + ("░" * ($n - $f));
def kids($T; $O; $id): [$O[] | select(($T[.].parent // "") == $id and (($T[.].state) | IN("ask","drop") | not))];
def leaves($T; $O; $id): kids($T; $O; $id) as $k
  | if ($k | length) == 0 then [$id] else [$k[] | leaves($T; $O; .)[]] end;
def prog($T; $ids): [$ids[] | $T[.] | select(.state != "drop")] as $x
  | {d:([$x[] | select(.state == "done")] | length), t:($x | length)};
# one count of finished work since an epoch: a sent task replied, a milestone of a
# self-reporting agent, a tree task set done (a passing check that only verifies earlier work
# is not new work)
def finished($raw; $since): [$raw[] | select(type == "object" and (.ep // 0) >= $since)]
  | ([.[] | select(.t == "done" and ((.verified == true and .text == null and (.key // "") == "") | not))] | length)
    + ([.[] | select(.t == "task" and .state == "done") | .id] | unique | length);
def wrap($n):
  # CJK (no spaces) wraps per character; when the current line has a space, an overflow wraps at
  # its last space so a Latin word is not split across lines
  if length == 0 then [""]
  else (reduce (explode[]) as $c ({lines:[[]], w:0};
          cw($c) as $cw
          | if .w + $cw <= $n then .lines[-1] += [$c] | .w += $cw
            elif ([ range(.lines[-1] | length) as $i | select(.lines[-1][$i] == " ") | $i ] | last) != null then
                ([ range(.lines[-1] | length) as $i | select(.lines[-1][$i] == " ") | $i ] | last) as $sp
                | (.lines[-1][$sp + 1:] + [$c]) as $next
                | .lines[-1] = .lines[-1][:$sp]
                | .lines += [$next]
                | .w = ($next | map(cw(.)) | add // 0)
            else .lines += [[$c]] | .w = $cw end)
        | [.lines[] | implode | rtrimstr(" ")])
  end;
'

# the snapshot: the board as JSON (awb view --json), drawn by JQ_BRIEF on the pane and by
# awb-lark as a card. It answers, in order, how far from the goal and is it moving; what needs
# you; what each agent is doing; how much of it is verified.
JQ_SNAP=$JQ_FOLD$JQ_DEFS'

. as $raw
# the newest reading by its time, so a backfilled older one (metric --at) does not replace it.
# A series whose newest reading says ref (metric --ref) is a reference: drawn beside the
# metric on the chart, never the metric itself nor part of its trend
| ([$raw[] | select(type == "object" and .t == "metric" and (.name | type) == "string")] | sort_by(.ep // 0)) as $mev
| ([$mev | group_by(.name)[] | select(last.ref == true) | .[0].name]) as $refn
| ([$mev[] | select(.name | IN($refn[]) | not)] | last // {}) as $metric
| ([$mev | group_by(.name)[] | select(last.ref == true)
    | {name:.[0].name, target:(last.target | tonumber?),
       history:([.[] | select(.x != null) | {x, value:(.value | tonumber?)} | select(.value != null)]
                | group_by(.x) | map(last))}]) as $refs
# held resources (awb hold/release) and stuck-session nudges: no agent state, render only
| ([$raw[] | select(type == "object" and (.t == "hold" or .t == "release") and (.res | type) == "string")]
   | group_by(.res) | map(sort_by(.ep // 0) | last | select(.t == "hold")
     | {res, owner:(.owner // ""), since:(.ep // 0), note:(.note // "")})) as $holds
| ([$raw[] | select(type == "object" and .t == "nudge" and .why == "stuck" and (.id | type) == "string")]
   | group_by(.id) | map(sort_by(.ep // 0) | last | {key:.id, value:.}) | from_entries) as $stk
# the last sign of work of each agent besides its own reports: a reply it sent (observed) or a
# change to a task it owns. A self-reported milestone left open is not the only truth
| ([$raw[] | select(type == "object")
    | if .t == "msg" and .dir == "in" and has("mid") and (.id | type) == "string" then {k:.id, ep:(.ep // 0)}
      elif .t == "task" and ((.owner // "") | type) == "string" and (.owner // "") != "" then {k:.owner, ep:(.ep // 0)}
      else empty end]
   | group_by(.k) | map({key:.[0].k, value:(map(.ep) | max)}) | from_entries) as $work
| ($raw | fold)
# with the Lean model built, the status, gate and end of every agent come from the proven fold
# (model/AwbModel.lean, awbmodel fold); the jq fold equals it only by the differential test
| reduce ($lean | split("\n")[] | select(. != "") | split(" ")) as $l (.;
    if .agents[$l[0]] == null then .
    else .agents[$l[0]] += {status:$l[1], gate:($l[2] == "true"),
                            endEp:(if $l[3] == "-" then null else ($l[3] | tonumber) end)} end)

# pane closed without a finish/fail event -> dead (empty pane = remote agent)
| .agents |= map_values(
    (.pane) as $p
    | if $p != "" and $live != null and (($live | index($p)) == null) and (.status | IN("running","blocked"))
      then .status = "dead" | .reason = "pane closed" | .endEp = .lastEp
      else . end)

# live Claude session state ($sess, from ~/.claude/sessions, not the proven fold): a
# permission dialog overrides the self-report; a self-report the session contradicts is flagged
| .agents |= with_entries(($sess[.key] // null) as $x
    | if $x == null then .
      else .value.live = $x.status end
    | if $x == null then .
      elif $x.status == "waiting" then .value.wait = true
        | .value.sess = "待批准：" + (if $x.waiting != "" then $x.waiting else "对话框" end) + " " + (($nowep - $x.since) | sdur)
      elif $x.status == "busy" and (.value.status | IN("done","failed")) then
        .value.sess = "自报" + {"done":"完成","failed":"失败"}[.value.status] + "，会话在忙"
      # a task sent to a session idle since before it, still idle: the message may never have
      # left the main agent (SendMessage is its step, outside awb)
      elif $x.status == "idle" and (.value.key // null) != null and $x.since <= (.value.keyEp // 0)
           and ($nowep - (.value.keyEp // $nowep)) >= $undeliv then
        .value.sess = "任务 #" + .value.key + " 派出 " + (($nowep - .value.keyEp) | ago) + "仍没开始：消息可能没发出"
      # only an agent that claims work (a milestone or a sent task open): a worker idle
      # between tasks, or started and waiting for its first, is not a contradiction
      # (and none since it began: a reply or a task change since then means the milestone is
      # stale, not the agent)
      elif $x.status == "idle" and .value.status == "running" and .value.current != null and ($nowep - $x.since) >= $silent
           and ($work[.key] // 0) < (.value.current.ep // 0) then
        .value.sess = "自报进行，会话空闲 " + (($nowep - $x.since) | sdur)
      else . end)

| . as $s
# the last change of each task: its task events, and the send and reply of a sent task
| ([$raw[] | select(type == "object")
    | if .t == "task" and .id != null then {k:.id, ep:(.ep // 0)}
      elif (.t == "now" or .t == "done") and (.key // "") != "" then {k:.key, ep:(.ep // 0)} else empty end]
   | group_by(.k) | map({key:.[0].k, value:(map(.ep) | max)}) | from_entries) as $tep
| ([$s.agents[] | select(.status == "running")] | length) as $nrun
| (if ([$raw[] | select(type == "object")] | length) == 0 then 0
   else $nowep - ([$raw[] | select(type == "object") | .ep // 0] | max // 0) end) as $quiet
# needs you: a permission dialog, a failed or dead agent, a decision
| ([ $s.agents[] | select(.wait) | {kind:"wait", id, name, text:.sess, age:null} ]
   + [ $s.agents[] | select((.wait | not) and (.status | IN("failed","dead")))
       | {kind:"fail", id, name, text:(.reason // ""), age:($nowep - (.endEp // .lastEp))} ]
   + [ $s.torder[] | $s.tasks[.] | select(.state == "ask")
       | {kind:"ask", id, name:"", text, age:($nowep - ($tep[.id] // $nowep))} ]) as $need
# one record per working agent: what it does now, for how long, verified/claimed
# milestones, flags (no code change, session disagrees); idle agents by name
| (([ $diffs[] | {key:.id, value:.} ] | from_entries) as $df
   | [ $s.agents[] | select((.wait | not)
          and ((.status | IN("running","blocked")) or ((.sess // "") != "")))
       | . as $a | ($nowep - ([$a.lastEp, ($work[$a.id] // 0)] | max)) as $idle
       | ($df[$a.id] // null) as $d
       # silence is an anomaly after AWB_SILENT (3600 s), not AWB_STALE (600 s, the nudge):
       # on a real three-day log (awb replay) the median gap between two updates of one agent
       # was 772 s, so half of all normal gaps crossed 600 s
       | ($idle >= $silent and ($a.status | IN("running","blocked"))) as $sil
       | {id:$a.id, name:$a.name, status:$a.status, idle:$idle, silent:$sil, live:($a.live // null),
          dn:($a.done | length), dv:([$a.done[] | select(.text | startswith("⊢ "))] | length),
          age:(if $a.status == "running" and $a.current then $nowep - $a.current.ep else $idle end),
          text:(if $a.status == "blocked" then (($a.reason // "") | ltrimstr("等：") | ltrimstr("等:")
                                               | if startswith("等") then . else "等 " + . end)
                elif $a.status == "running" and $a.current then ($a.current.text // "")
                elif ($a.done | length) > 0 then "✓ " + ($a.done[-1].text // "") else ($a.reason // "") end),
          flag:([ (($stk[$a.id] // null) as $n | ($sess[$a.id] // null) as $x
                   | if $n != null and $x != null and $x.status != "busy" and $x.since <= $n.ep
                     then "工具调用没执行，提醒后仍停着 " + (($nowep - $n.ep) | sdur) else empty end),
                  # a worker driven by awb send with no open task is waiting, not frozen (as in freeze_once)
                  (if $a.status == "running" and $d != null and ($nowep - $d.ep) >= $frz
                      and ((($a.sent // false) and $a.key == null) | not)
                    then "无改动 " + (($nowep - $d.ep) | ago) else empty end),
                  (if ($a.sess // "") != "" then "≠ " + $a.sess else empty end) ] | join(" · "))} ]
   | sort_by([(if .status == "blocked" then 0 elif .status == "running" then 1 else 2 end), -.idle])) as $act
# what is off: a bottleneck (an issue or PR, #N, that two or more blocked agents wait
# for), a silent running agent, no code change or a contradicting session, a board
# nobody has written to while agents run
| ([ $act[] | select(.status == "blocked")
     | .name as $n | [(.text | match("#[0-9]+"; "g") | .string)] | unique[] | {ref:., name:$n} ]
   | group_by(.ref) | map(select(length >= 2) | {ref:.[0].ref, names:map(.name)})) as $bott
# messages between the main agent and each agent, observed from its Claude transcript
# (observe_once): counts of the last 24 hours, and the first message still without a reply
| ([$raw[] | select(type == "object" and .t == "msg" and (.id | type) == "string" and has("mid"))]
   | group_by(.id) | map(sort_by(.ep // 0) | .[0].id as $i
     | ([.[] | select(.dir == "in") | .ep // 0] | max // 0) as $li
     | {id:$i, name:(($s.agents[$i].name) // $i),
        to_agent:([.[] | select(.dir == "out" and (.ep // 0) >= $nowep - 86400)] | length),
        from_agent:([.[] | select(.dir == "in" and (.ep // 0) >= $nowep - 86400)] | length),
        wait:([.[] | select(.dir == "out" and (.ep // 0) > $li) | .ep // 0] | min)})) as $talk
| ([ ($bott[] | {kind:"bottleneck", text:"\(.ref) 卡住 \(.names | join("、"))"}),
     # one line per agent: a flag (no code change, session disagrees) over silence; silence
     # counts only for an agent with no Claude session, since a live session reports itself
     ($act[] | if .flag != "" then {kind:"flag", text:"\(.name) \(.flag)"}
               elif .status == "running" and .silent and .live == null
               then {kind:"silent", text:"\(.name) \(.idle | ago)没有更新"} else empty end),
     # a held resource whose holder has not worked for AWB_STALE: the rest queue behind it
     ($holds[] | . as $hd | ($s.agents[$hd.owner] // null) as $a | ($sess[$hd.owner] // null) as $x
      | (if $x != null then (if $x.status == "busy" then 0 else $nowep - $x.since end)
         elif $a != null then $nowep - $a.lastEp else 0 end) as $q
      | select($q >= ($stale | tonumber))
      | {kind:"hold", text:"\($hd.res) 被 \(($a.name) // $hd.owner) 占着 \((($nowep - $hd.since) | ago))，它 \($q | ago)没在干活"}),
     # a message from the main agent with no reply while the session of the agent sits idle for
     # AWB_REPLY_IDLE: it finished without replying, or never started (unless a flag says so)
     ($talk[] | select(.wait != null) | . as $k | ($sess[$k.id] // null) as $x
      # many messages are notices that need no reply: one unanswered for a day is dropped
      # a worker driven by awb send with no open task: its messages are notices, not tasks
      | select((($s.agents[$k.id].sent // false) and $s.agents[$k.id].key == null) | not)
      # a worker that replied with the key of its open task waits for awb reply: "replied" says so,
      # a later message from the main agent is not a second thing to answer (aupai, jan)
      | ($s.agents[$k.id]) as $ka
      | select(($ka.key != null and any($raw[]; type == "object" and .t == "msg" and .dir == "in"
                 and .id == $k.id and .key == $ka.key and (.ep // 0) >= ($ka.keyEp // 0))) | not)
      | select($x != null and $x.status == "idle" and (($s.agents[$k.id].sess // "") == "")
               and $nowep - ([$k.wait, $x.since] | max) >= $replyidle and $nowep - $k.wait < 86400)
      | {kind:"noreply", text:"\($k.name) 空闲 \(($nowep - $x.since) | ago)，主控 \(($nowep - $k.wait) | ago)前的消息还没回"}),
     # an observed reply with the key of the open task, then an idle session: done, or a progress
     # report; only the main agent tells which, so the task stays open until awb reply
     ($s.agents[] | select(.key != null) | . as $a | ($sess[$a.id] // null) as $x
      | ([$raw[] | select(type == "object" and .t == "msg" and .dir == "in" and .id == $a.id
                          and .key == $a.key and (.ep // 0) >= ($a.keyEp // 0)) | .ep // 0] | max) as $r
      | select($r != null and $x != null and $x.status == "idle" and $nowep - ([$r, $x.since] | max) >= $replyidle)
      | {kind:"replied", text:"\($a.name) 回复了 #\($a.key)（\(($nowep - $r) | ago)前）后空闲；做完了就 awb reply \($a.id) \($a.key)"}),
     (if $quiet >= $silent and $nrun > 0
      then {kind:"board", text:"看板 \($quiet | ago)没有新事件，主控可能停了"} else empty end),
     # a caller (a script, often with stderr thrown away) ran a command awb does not have: in the
     # last 24 hours, one line per command
     ([$raw[] | select(type == "object" and .t == "badcmd" and (.ep // 0) >= $nowep - 86400)]
      | group_by(.cmd)[] | {kind:"badcmd",
        text:"不存在的命令 awb \(.[0].cmd | tostring | .[0:24])\(if (.[0].sug // "") != "" then "（应为 awb \(.[0].sug)）" else "" end) 用了 \(length) 次，最近 \(($nowep - (map(.ep // 0) | max)) | ago)前"}) ]) as $anom
# the live roots of the task tree: a fully-done root untouched for an hour is
# folded away (counted in tasks_old) and left out of the total progress
| ([ kids($s.tasks; $s.torder; "")[] as $root
     | leaves($s.tasks; $s.torder; $root) as $lv | prog($s.tasks; $lv) as $rp
     | ([$root, $lv[]] | map($tep[.] // 0) | max) as $last
     | {id:$root, old:($rp.t > 0 and $rp.d == $rp.t and ($nowep - $last) >= 3600)} ]) as $roots
| ([$roots[] | select(.old | not) | .id]) as $lroots
| ([$roots[] | select(.old)] | length) as $nold
| ($viol | split("\n") | map(select(. != "") | split(" "))) as $vs
  | prog($s.tasks; [$lroots[] | leaves($s.tasks; $s.torder; .)[]]) as $tp
  | ($nowep - 3600) as $h1
  | ([$s.agents[].done[]? | .text // ""]) as $mdone
  | ([$mdone[] | select(startswith("⊢ "))] | length) as $mver
  # the metric and its history (same name); a linear ETA from the first reading, an estimate
  | (if ($metric.name // "") == "" then null
     else ([$raw[] | select(type == "object" and .t == "metric" and .name == $metric.name)] | sort_by(.ep // 0)) as $mh
       | ($metric.value | tonumber?) as $v | ($metric.target | tonumber?) as $tt
       | ($mh[0].value | tonumber?) as $v0 | (($metric.ep // $nowep) - ($mh[0].ep // $nowep)) as $el
       | {name:$metric.name, value:$v, target:$tt, note:($metric.note // ""),
          frac:(if $v != null and $tt != null and $tt > 0 then ([0, $v / $tt, 1] | sort | .[1]) else null end),
          history:[$mh[] | {ep:(.ep // 0), value:(.value | tonumber?), x:(.x // null)} | select(.value != null)],
          v0:(if ($mh | length) >= 2 then $v0 else null end),
          since:(if ($mh | length) >= 2 then $nowep - ($mh[0].ep // $nowep) else null end),
          # an estimate needs readings spread over time: 10 minutes at least, and none under
          # a minute (backfilled readings in one second once gave "0 minutes")
          eta:(if ($mh | length) >= 2 and $tt != null and $v != null and $v0 != null and $v > $v0 and $v < $tt and $el >= 600
               then (($tt - $v) / (($v - $v0) / $el)) | if . >= 60 then . else null end else null end),
          by:([$mh[] | .by // empty] | last),
          age:($nowep - ($metric.ep // $nowep))}
     # the estimate runs from the latest reading, not from now: count the time since it, and
     # none at all from a reading older than AWB_METRIC_STALE (a day-old trend is not a forecast)
     | .stale = (.age >= $mstale)
     | .eta = (if .eta == null or .stale then null else (.eta - .age) | if . >= 60 then . else null end end)
     # an estimate past the deadline (metric --by) is not shown; the board says the trend misses it
     | if .by != null and .value != null and .target != null and .value < .target
          and (.eta == null or $nowep + .eta > .by) then .eta = null | .late = true else .late = false end
     end) as $M
  | ([ $s.agents[] | select((.wait | not) and .status == "done" and ((.sess // "") == "")) | {id, name} ]) as $idl
  | ([ $lroots[] as $root | $s.tasks[$root] as $rt
       | prog($s.tasks; leaves($s.tasks; $s.torder; $root)) as $rp
       | kids($s.tasks; $s.torder; $root) as $k0
       | [$k0[] | select($s.tasks[.].state == "done")] as $dk
       | ($dk[:-2]) as $fold
       | (if $rp.d < $rp.t then $nowep - ([$root, leaves($s.tasks; $s.torder; $root)[]] | map($tep[.] // 0) | max)
          else 0 end) as $tage
       | {id:$root, text:$rt.text, state:$rt.state, owner:($rt.owner // ""), d:$rp.d, t:$rp.t, folded:($fold | length),
          quiet:(if $tage >= $tstale then $tage else null end),
          kids:[ $k0[] | select(. as $x | $fold | index($x) | not) | $s.tasks[.] as $t
                 | leaves($s.tasks; $s.torder; .) as $lv
                 | {id:$t.id, text:$t.text, state:$t.state, owner:($t.owner // ""),
                    prog:(if ($lv | length) > 1 then prog($s.tasks; $lv) else null end)} ]} ]) as $trees
  # the goal: its first line is the title, the rest says what it is
  | (($s.goal | gsub("\r"; "") | split("\n")) as $gl
     | {title:($gl[0] // ""), about:($gl[1:] | map(select(. != "")))}) as $G
  # the last 24 hours in numbers
  | ($nowep - 86400) as $d1
  | ([$raw[] | select(type == "object" and (.ep // 0) >= $d1)]) as $day
  | {done:finished($raw; $d1),
     verified:([$day[] | select(.t == "done" and .verified == true)] | length),
     metric:(if $M == null or ($M.history | length) < 2 or $M.value == null then null
             else (([$M.history[] | select(.ep < $d1)] | last | .value) // $M.history[0].value) as $vd
               | ($M.value - $vd) end),
     # when the first reading is newer than 24h ago the delta spans less than a day; name the
     # real span (the footer/lark tile otherwise imply a full 24-hour window)
     mspan:(if $M == null or ($M.history | length) < 2 then null
            else ($nowep - ([$M.history[].ep] | min)) as $sp | (if $sp < 86400 then $sp else null end) end)} as $D
  # the next open steps of the main line: open children of the live roots, and a root handed to
  # a worker (awb send without --under); work in flight (wip) first, with its owner
  | ([ $trees[] | if (.kids | length) == 0 then (select(.owner != "") | {id, text, state, owner, prog:null}) else .kids[] end
       | select(.state | IN("done","drop") | not) ]
     | sort_by(if .state == "wip" then 0 else 1 end)[:3]
     | map(.text = ((if .owner != "" then "\(($s.agents[.owner].name) // .owner)：" else "" end) + .text))) as $next
  # the tree below leaves out the steps already shown as 下一步
  | ([$next[].id]) as $nid
  | [ $trees[] | select((.kids | length) > 0 or ((.id as $i | $nid | index([$i])) | not))
      | .kids |= map(select(.id as $i | $nid | index([$i]) | not)) ] as $trees
  # news: one line per fact. Lines written with the same key (awb news --key) are one fact,
  # and only the latest is shown; lines without a key are all shown.
  | ([$s.news | to_entries[] | .key as $i | .value | (.key // "") as $k
      | select($k == "" or ([$s.news[($i + 1):][] | .key // ""] | index([$k]) | not))
      | {text, time}]) as $news
  | ([ (if ($need | length) > 0 then "需要你 \($need | length) 件" else "无需你处理" end),
       # a judgement only: the numbers are on the metric line and the footer
       (if $M == null or $M.value == null or $M.target == null then empty
        elif $M.value >= $M.target then "\($M.name) 已达标"
        elif $M.late then "\($M.name) 按当前趋势截止前达不到"
        elif $D.metric == null then empty
        else (if $D.mspan != null then "近 \($D.mspan | ago)" else "24 小时" end) as $win
          | if $D.metric > 0 then "\($M.name) \($win)在涨"
            elif $D.metric < 0 then "\($M.name) \($win)在降"
            else "\($M.name) \($win)没变" end end),
       (if ($anom | length) > 0 then "异常 \($anom | length)" else empty end) ] | join(" · ")) as $headline
  | {goal:$s.goal, title:$G.title, about:$G.about, headline:$headline, quiet:$quiet,
       now:$nowep, clock:$now, progress:$tp, hour:{done:finished($raw; $h1)}, day:$D,
       verified:{v:$mver, n:($mdone | length)}, running:$nrun, metric:$M, need:$need,
       anomalies:$anom, next:$next, holds:$holds,
       agents:$act, idle:$idl, tasks:$trees, tasks_old:$nold, talk:$talk, observe:$obs,
       news:$news, refs:$refs,
       checks:[$s.checks[] | {id, name:(($s.agents[.id].name) // .id), what, startEp,
         ok:(all(.steps[]; .state == "ok")), fail:any(.steps[]; .state == "fail"),
         steps:[.steps[] | {s, state, el:((.ep1 // $nowep) - .ep0), note}]}],
       violations:[$vs[] | {id:.[0], name:(($s.agents[.[0]].name) // .[0]), kind:.[1]}]} | tojson
'

# the brief view, drawn from the snapshot alone (awb view --json); the Lark card is the other view
# of it. README "What the brief view shows" is the rule each line is held to.
JQ_BRIEF=$JQ_DEFS'
({"todo":["○",$dm],"wip":["◔",$cy],"review":["◑",$cy],"blocked":["▲",$y],
  "done":["✓",$g],"drop":["–",$dm],"ask":["?",$y]}) as $TI
| ([$w - 1, 100] | min) as $bw
| . as $S | .metric as $M | .day as $D
| (if $S.title == "" then "╭" + ("─" * ($bw - 2)) + "╮"
   else ($S.title | clip($bw - 6)) as $tt | "╭─ " + $tt + " " + ("─" * ([$bw - 5 - ($tt | dwidth), 2] | max)) end) as $btop
| ([$S.about[] | wrap($bw - 4)[] | "│ " + $dm + . + $rs]) as $babout
| ("│ " + (if ($S.need | length) > 0 then $y elif ($S.anomalies | length) > 0 then $cy else $g end)
   + "▶ " + $S.headline + $rs) as $bhead
| (if $M == null then []
   else (if $M.frac != null then " ▕" + bar($M.frac; 1; 10) + "▏" + (($M.frac * 100) | floor | tostring) + "%" else "" end) as $bar
     | (if $M.stale then "  最新读数 \($M.age | ago)前" else "" end) as $old
     # narrow panes keep the verdict (stale reading / ETA / misses deadline); the start
     # point and then the sparkline are dropped whole before the verdict is clipped
     | (if $M.eta != null then " · 按均速约 \($M.eta | ago)达标（估）"
        elif $M.late then " · 按当前趋势截止前达不到" else "" end) as $verdict
     | (if $M.v0 != null then "  起 \($M.v0) · \($M.since | ago)前" else "" end) as $start
     | ("│ " + ($M.name | clip(14)) + " \($M.value) / \($M.target)" + $bar) as $braw
     | ([$M.history[].value] | .[-12:]) as $vals
     | (if ($vals | length) >= 2 then " " + ($vals | spark([$M.target // 0, max] | max)) else "" end) as $sp
     | ($bw - ($braw | dwidth)) as $room
     # verdict first (stale reading / ETA / misses deadline), then the start point, then the
     # sparkline; each whole segment is dropped before the verdict is clipped to the pane
     | (reduce [{t:($dm + $old + $verdict + $rs)}, {t:($dm + $start)}, {t:$sp}][] as $z
         ({r:$room, out:[]};
          . as $acc
          | ($z.t | gsub("\u001b\\[[0-9;]*m"; "")) as $vis
          | if ($vis | dwidth) == 0 then $acc
            elif ($vis | dwidth) <= $acc.r then {r:($acc.r - ($vis | dwidth)), out:($acc.out + [$z.t])}
            elif ($acc.out | length) == 0 then {r:0, out:[($vis | clip($acc.r))]}
            else $acc end)
         | .out | join("")) as $tail
     | ["│ " + $cy + ($M.name | clip(14)) + $rs + " \($M.value) / \($M.target)" + $bar + $tail]
       + (if $M.note != "" then ["│   " + $dm + ($M.note | clip($bw - 6)) + $rs] else [] end)
   end) as $mlines
| ("╰─ " + (if $S.progress.t > 0 then "进度 " + bar($S.progress.d; $S.progress.t; 16) + " \($S.progress.d)/\($S.progress.t)   " else "" end) + $S.clock
   + (if ($S.quiet // 0) >= 60 then " · 更新于 \($S.quiet | ago)前" else "" end)) as $bfoot
# movement, one line: the last hour, the last 24 hours, and how much of it is verified
| ((if $S.hour.done > 0 then $g + "近 1 小时 完成 +\($S.hour.done)" + $rs
    elif $S.running > 0 then $y + "近 1 小时无新完成" + $rs
    else $dm + "近 1 小时无变化" + $rs end)
   + $dm + " · 24 小时 完成 +\($D.done)"
   + (if $D.metric != null then " \($M.name) " + (if $D.metric >= 0 then "+" else "" end) + ($D.metric * 100 | round / 100 | tostring)
        + (if $D.mspan != null then "/" + ($D.mspan | ago) else "" end) else "" end)
   + " · 已核 \($S.verified.v)/\($S.verified.n)" + $rs) as $move0
| (($move0 | gsub("\u001b\\[[0-9;]*m"; "") | dwidth) as $mw
   | if $mw <= ($bw - 3) then $move0 else ($move0 | gsub("\u001b\\[[0-9;]*m"; "") | clip($bw - 3)) end) as $move
| (if ($S.need | length) > 0 then ["", $y + "需要你（\($S.need | length)）" + $rs]
     + [ $S.need[] | (if .age != null then $dm + " · 已 \(.age | ago)" + $rs else "" end) as $ag
         | if .kind == "wait" then $y + "  ▲ " + $rs + (.name | clip(10) | pad(10)) + " " + (.text | clip($bw - 16))
           elif .kind == "fail" then $r + "  ✗ " + $rs + (.name | clip(10) | pad(10)) + " " + (.text | clip($bw - 26)) + $ag
           else $y + "  ? " + $rs + (.text | clip($bw - 16)) + $ag end ]
   else [] end) as $needb
| (if ($S.next | length) > 0 then ["", $cy + "下一步" + $rs]
     + [ $S.next[] | ($TI[.state] // ["•",$dm]) as $ic | "  " + $ic[1] + $ic[0] + $rs + " " + (.text | clip($bw - 6)) ]
   else [] end) as $nextb
| (if ($S.anomalies | length) > 0 then ["", $y + "异常（\($S.anomalies | length)）" + $rs]
     + [ $S.anomalies[] | "  " + $y + "! " + $rs + (.text | clip($bw - 6)) ] else [] end) as $anomb
| (if ($S.news | length) > 0 then ["", $g + "进展" + $rs]
     + [ $S.news[-3:] | reverse[] | "  ✓ " + $dm + .time[0:5] + $rs + " " + (.text | clip($bw - 12)) ] else [] end) as $newsb
| (if ($S.tasks | length) + $S.tasks_old == 0 then [] else [""]
   + [ $S.tasks[] | . as $tr
       | ((if $tr.quiet then " · \($tr.quiet | ago)没更新" else "" end)) as $qs
       | ($bw - 25 - ($qs | dwidth)) as $tw
       | $cy + "■ " + ($tr.text | clip([$tw, 10] | max) | pad($tw)) + $rs + " " + bar($tr.d; $tr.t; 12) + $dm + " \($tr.d)/\($tr.t)"
         + $qs + $rs,
         (if $tr.folded > 0 then $dm + "  ├─ ✓ 另 \($tr.folded) 项已完成" + $rs else empty end),
         (range(0; $tr.kids | length) as $i | $tr.kids[$i] as $t | ($TI[$t.state] // ["•",$dm]) as $ic
          | (if $i == ($tr.kids | length) - 1 then "  └─ " else "  ├─ " end) as $pre
          | $ic[1] + $pre + $ic[0] + " " + ($t.text | clip($bw - 26) | pad($bw - 26)) + $rs
            + (if $t.prog then bar($t.prog.d; $t.prog.t; 6) + $dm + " \($t.prog.d)/\($t.prog.t)" + $rs else "" end)) ]
   + (if $S.tasks_old > 0 then [$dm + "✓ 另有 \($S.tasks_old) 项已完成（1 小时前）" + $rs] else [] end) end) as $tasksb
| (($S.checks | sort_by(-.startEp) | .[:3]) as $cks
   | (if ($cks | length) == 0 then [] else ["", $g + "验收" + $rs]
      + [ $cks[] | .steps as $ss
          | (if .fail then ["✗",$r] elif any($ss[]; .state == "run") then ["◔",$cy] else ["⊢",$g] end) as $ov
          | ([ $ss[] | ({"ok":"✓","fail":"✗","run":"◔"}[.state] // "·") as $i
               | .s + " " + $i + (if .state == "run" and ($ss | length) > 1 then " " + (.el | sdur) else "" end) ]
             | join(" → ")) as $chain
          | ([$ss[] | select(.state == "fail") | .note] | first // "") as $why
          | ("  " + $ov[1] + $ov[0] + $rs + " " + (.name | clip(10) | pad(10)) + " "
            + $dm + (.what | clip(18) | pad(18)) + $rs + " "
            + ($chain | clip([$bw - 43, 10] | max)) + $dm + "  " + ([$ss[].el] | add // 0 | sdur) + $rs,
            (if $why != "" then "    " + $r + "└ " + ($why | clip($bw - 8)) + $rs else empty end)) ] end)
   + (if ($S.violations | length) == 0 then [] else ["", $r + "审计违规（Lean 监控）" + $rs]
      + [ $S.violations[] | "  " + $r + "✗ " + $rs + (.name | clip(10) | pad(10)) + " "
          + ({"verified-without-passing-check":"验收标记前没有通过的验收（疑似伪造）",
              "pr-without-passing-check":"没有通过的验收就开了 PR",
              "done-while-check-rejected":"验收被拒后仍报完成"}[.kind] // .kind) ] end)) as $chk
| ([$btop] + $babout + [$bhead] + $mlines + [($bfoot | clip($bw)), "   " + $move]) as $fx
# needs and anomalies are packed against the pane height: the header always shows, as many
# items as fit, then a "还有 N" line (a short pane used to cut the rest with no trace)
| (def pack($title; $items; $label; $cur):
     ($h - $cur) as $bud
     | (if ($items | length) == 0 or $bud < 2 then []
        else (if $bud > 2 then [""] else [] end) as $gap
          | ($bud - ($gap | length) - 1) as $cap
          | (if $cap < 1 then 0
             elif ($items | length) <= $cap then ($items | length)
             else [($cap - 1), 1] | max end) as $k
          | $gap + [$title] + ($items[:$k])
            + (if $k < ($items | length) then [$dm + "    还有 \((($items | length) - $k)) " + $label + $rs] else [] end)
        end);
   pack($needb[1]; $needb[2:]; "件"; ($fx | length)) as $pb
   | pack($anomb[1]; $anomb[2:]; "条"; (($fx | length) + ($pb | length) + ($nextb | length))) as $ab
   | ($fx + $pb + $nextb + $ab) as $core
   | ($core + $newsb + $tasksb + $chk) as $all
   # needs/anomalies already carry their own "还有 N" count when packed; a global scroll hint
   # is added only when the cut falls on news/tasks/checks below them
   | if ($all | length) <= $h then $all
     elif ($core | length) >= $h then $all[:$h]
     else $all[:($h - 1)] + [$dm + "↓ 还有 \((($all | length) - ($h - 1))) 行 · j/k ↑↓ 滚轮 · 空格翻页" + $rs] end)
   | .[]
'

dims() {
  if [ -n "${AWB_ROWS:-}" ] && [ -n "${AWB_COLS:-}" ]; then
    echo "$AWB_COLS $AWB_ROWS"
  elif [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    # $TMUX_PANE names a pane of the server this process runs in ($TMUX); tm would prefer AWB_DIR's socket.
    # Without $TMUX the default server answers, with the size of some other pane of the same id
    tmux display-message -p -t "$TMUX_PANE" '#{pane_width} #{pane_height}' 2>/dev/null
  else
    stty size 2>/dev/null | awk '{print $2, $1}'
  fi || echo "80 24"
}

# the log as a JSON array, tolerating a half-appended line from a concurrent writer
events_json() {
  { [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s \
    'rtrimstr("\n") | if . == "" then [] else split("\n")
       | map(fromjson? | select(type == "object" and has("t"))) end'
}

# directory of the real script (through the install symlink): clone root
src_dir() { cd "$(dirname "$BIN")" && cd "$(dirname "$(readlink "$BIN" 2>/dev/null || echo "$BIN")")" && pwd; }

# compiled Lean model (model/Main.lean), built with: cd model && lake build
model_bin() {
  _m=${AWB_MODEL:-$(src_dir)/model/.lake/build/bin/awbmodel}
  [ -x "$_m" ] && printf %s "$_m"
}

# per-agent state from the jq fold, same format as `awbmodel fold`
state() {
  init_dir
  events_json | jq -r "$JQ_FOLD"' fold
    | (.agents | to_entries | sort_by(.key)[] | .value as $a
       | "\(.key) \($a.status) \($a.gate // false) \($a.endEp // "-") \(($a.done | last | .dur) // 0) \($a.done | length)")'
}

# the snapshot JSON of the board now, or as of AWB_NOW=EPOCH from the log alone (awb replay):
# the live facts (panes, sessions, code fingerprints, audit) describe now, so none is read then
snapshot() {
  init_dir
  nowep=${AWB_NOW:-$(date +%s)}
  live=null; viol=; lean=; diffs='[]'; sess='{}'
  if [ -z "${AWB_NOW:-}" ]; then
    sess=$(sessions_json)
    # live panes of the server awb uses; no reachable server = liveness unknown (null)
    if live=$(tm list-panes -a -F '#{pane_id}' 2>/dev/null); then
      live=$(printf '%s\n' "$live" | jq -Rn '[inputs | select(. != "")]')
    else live=null; fi
    if m=$(model_bin) && [ -s "$EV" ]; then
      viol=$("$m" audit < "$EV" 2>/dev/null || true); lean=$("$m" fold < "$EV" 2>/dev/null || true)
    fi
    # working-tree fingerprints written by freeze_once: "ID HASH EP" (epoch of
    # last change). Fed to the snapshot as data, never through the proven fold.
    if [ -s "$AWB_DIR/diffs" ]; then
      diffs=$(jq -Rn '[inputs | select(length > 0) | split(" ")
               | {id:.[0], hash:.[1], ep:(.[2] | tonumber)}]' < "$AWB_DIR/diffs")
    fi
  fi
  # the last observation round (the obs file is rewritten by each) and how many transcripts it read
  obs=null; [ ! -f "$AWB_DIR/obs" ] || [ -n "${AWB_NOW:-}" ] || \
    obs=$(printf '{"last":%s,"files":%s}' "$(stat -f %m "$AWB_DIR/obs" 2>/dev/null || stat -c %Y "$AWB_DIR/obs")" "$(grep -c . "$AWB_DIR/obs" || true)")
  events_json | jq -r --arg viol "$viol" --arg lean "$lean" --argjson undeliv "${AWB_UNDELIVERED:-180}" --argjson obs "$obs" \
    --arg now "$(jq -nr --argjson t "$nowep" '$t | strflocaltime("%H:%M:%S")')" --argjson nowep "$nowep" \
    --argjson live "$live" --arg stale "${AWB_STALE:-600}" --argjson replyidle "${AWB_REPLY_IDLE:-600}" \
    --argjson diffs "$diffs" --argjson frz "${AWB_FROZEN:-900}" --argjson silent "${AWB_SILENT:-3600}" \
    --argjson mstale "${AWB_METRIC_STALE:-21600}" --argjson tstale "${AWB_TASK_STALE:-21600}" --argjson sess "$sess" \
    "$JQ_SNAP"
}

# the board drawn once at the pane size (or AWB_COLS x AWB_ROWS)
render() { set -- $(dims); snapshot | brief_view "${1:-80}" "${2:-24}"; }

# replay: the board's anomalies over the log's history, one snapshot every STEP seconds as of
# that time (AWB_NOW), grouped into episodes (one anomaly on consecutive snapshots). This is
# how a rule's thresholds are judged against what really happened, not by guess. Its last
# section measures the core goal on the same log: tasks the main agent sent and whether their
# replies came, how long a 需要你 item stayed on the board, how often workers restarted.
replay() {
  init_dir
  step=${1:-1800}
  printf '%s' "$step" | grep -Eqx '[0-9]+' && [ "$step" -ge 60 ] || die "usage: $PROG replay [STEP-SECONDS >= 60]"
  [ -s "$EV" ] || return 0
  set -- $(events_json | jq -r '[.[] | .ep // empty | numbers] | "\(min // 0) \(max // 0)"')
  _t=$1; _end=$2; _rd=$(mktemp -d "${TMPDIR:-/tmp}/awb-replay.XXXXXX"); _n=0
  # ponytail: one full fold per step, O(steps x log); fine for days of hourly steps
  while [ "$_t" -le "$_end" ] && [ "$_n" -lt "${AWB_REPLAY_MAX:-2000}" ]; do
    _t=$((_t + step)); _n=$((_n + 1))
    jq -Rc --argjson T "$_t" 'fromjson? | select(type == "object" and (.ep // 0) <= $T)' < "$EV" > "$_rd/events.jsonl"
    AWB_DIR=$_rd AWB_NOW=$_t "$BIN" view --json | jq -c --argjson T "$_t" '{T:$T, a:.anomalies, n:[.need[] | {kind, id, text}]}'
  done > "$_rd/series"
  jq -rs --argjson step "$step" --slurpfile E "$_rd/events.jsonl" '
    def at: strflocaltime("%m-%d %H:%M");
    def dur: if . == null then "-" elif . >= 86400 then "\((. / 8640 | floor) / 10)天" elif . >= 3600 then "\((. / 360 | floor) / 10)小时"
             else "\(. / 60 | floor)分钟" end;
    def med: sort | if length == 0 then null else .[length / 2 | floor] end;
    # one item on consecutive snapshots is one episode
    def episodes: group_by(.key) | [ .[] | sort_by(.T)
        | reduce .[] as $x ([]; if length > 0 and $x.T - .[-1].last <= $step
                               then .[-1].last = $x.T else . + [$x + {first:$x.T, last:$x.T}] end)[]
        | . + {span:(.last - .first + $step)} ];
    . as $S
    # a sent task (keyed now) ends with its reply (keyed done); with `finish` (status done, no
    # reply recorded); or is lost: a restart, a failure or a newer task came first. The rest are
    # open at the end of the log
    | (reduce ($E[] | select(type == "object" and (.id | type) == "string")) as $e ({o:{}, r:[], seen:{}, restart:0, exit:0};
        (if $e.t == "start" then (if .seen[$e.id] then .restart += 1 else . end) | .seen[$e.id] = true
         elif $e.t == "status" and $e.status == "failed" and ($e.gate | not) then .exit += 1 else . end)
        | if $e.t == "now" and ($e.key // "") != "" then
            (if .o[$e.id] then .r += [.o[$e.id] + {how:"lost"}] else . end) | .o[$e.id] = {t0:$e.ep}
          elif .o[$e.id] == null then .
          elif $e.t == "done" and ($e.key // "") != "" then .r += [.o[$e.id] + {how:"reply", d:($e.ep - .o[$e.id].t0)}] | del(.o[$e.id])
          elif $e.t == "status" and $e.status == "done" then .r += [.o[$e.id] + {how:"finish"}] | del(.o[$e.id])
          elif $e.t == "start" or ($e.t == "status" and $e.status == "failed") then .r += [.o[$e.id] + {how:"lost"}] | del(.o[$e.id])
          else . end)) as $K
    # messages observed from the transcript of the main agent: consecutive messages before a
    # reply are one wait, closed by the reply
    | ([$E[] | select(type == "object" and .t == "msg" and (.id | type) == "string" and has("mid"))] | group_by(.id)
       | map(sort_by(.ep // 0) | reduce .[] as $m ({w:null, r:[], o:0};
           if $m.dir == "out" then .o += 1 | (if .w == null then .w = $m.ep else . end)
           elif .w != null then .r += [$m.ep - .w] | .w = null else . end))) as $T
    | ([ $S[] | .T as $T | (.n // [])[] | . + {T:$T, key:(.kind + " " + .id)} ] | episodes) as $N
    | [ $S[] | .T as $T | .a[] | {T:$T, kind, text,
          key:(.kind + " " + (.text | gsub("[0-9]+([:.][0-9]+)*(s|分钟|小时|天)?"; "#")))} ]
    | episodes as $E
    | "回放 \($S[0].T - $step | at) → \($S[-1].T | at)，每 \($step / 60 | floor) 分钟一个时间点，共 \($S | length) 个",
      "只用日志：会话状态、pane 存活、代码指纹不在日志里，依赖它们的规则不会触发；\"没有更新\"对 Claude 会话会多报",
      "",
      "规则\t段数\t累计时长",
      ( $E | group_by(.kind)[] | "\(.[0].kind)\t\(length)\t\([.[].span] | add | dur)" ),
      "",
      "开始\t持续\t规则\t异常（第一次出现时的文字）",
      ( $E | sort_by(.first)[] | "\(.first | at)\t\(.span | dur)\t\(.kind)\t\(.text)" ),
      "",
      "核心指标",
      ([$K.r[] | select(.how == "reply") | .d] as $d | ($K.o | length) as $open
       | "派单 \($K.r | length + $open)：回报 \($d | length)（中位 \($d | med | dur)，最长 \($d | max | dur)），finish 收尾未回报 \([$K.r[] | select(.how == "finish")] | length)，丢失 \([$K.r[] | select(.how == "lost")] | length)（重启、失败或新任务先到），未结 \($open)"),
      ([$N[] | select(.last < $S[-1].T) | .span] as $d
       | "需要你 \($N | length) 次：已解决 \($d | length)（在板上中位 \($d | med | dur)，最长 \($d | max | dur)），回放结束时仍在 \([$N[] | select(.last == $S[-1].T)] | length)"),
      "下属重启 \($K.restart) 次，异常退出 \($K.exit) 次",
      (if ($T | length) == 0 then "主控消息（从会话记录观察）：没有记录。看板开着时每分钟观察一轮（AWB_OBSERVE=0 为关）；awb view --json 的 observe 是最近一轮"
         else ([$T[].r[]]) as $d
           | "主控消息（从会话记录观察）：发出 \([$T[].o] | add)，得到回复 \($d | length)（中位 \($d | med | dur)，最长 \($d | max | dur)），结束时等回复的 agent \([$T[] | select(.w != null)] | length) 个" end)' "$_rd/series"
  rm -rf "$_rd"
}

# the brief view of a snapshot on stdin (awb view --json | awb _view renders the same board)
brief_view() {
  jq -r --argjson w "$1" --argjson h "$(( $2 < 12 ? 12 : $2 ))" \
    --arg g  "${ESC}[32m"  --arg cy "${ESC}[36m" --arg y "${ESC}[33m" \
    --arg r  "${ESC}[31m"  --arg dm "${ESC}[2m"  --arg rs "${ESC}[0m" \
    "$JQ_BRIEF"
}

# no-code-change detection: runs on the nudge loop's cadence AWB_NUDGE_POLL
# (default 60 s). It fingerprints each agent's working tree and remembers the
# epoch of its LAST change in $AWB_DIR/diffs ("ID HASH EP"). A running agent
# unchanged for AWB_FROZEN seconds (default 900) is pasted at most ONE reminder
# per AWB_NUDGE_EVERY (default 900 s, throttled via $AWB_DIR/fnudged, "ID EP")
# — the 60 s poll cadence is not the reminder throttle. Blocked agents and
# non-git dirs are skipped. Working dir: $AWB_DIR/panes column 3 if present,
# else the live tmux pane path.
freeze_once() {
  init_dir
  command -v git >/dev/null || return 0
  lock "freeze"
  now=$(date +%s); frz=${AWB_FROZEN:-900}; every=${AWB_NUDGE_EVERY:-900}
  df=$AWB_DIR/diffs; nf=$AWB_DIR/fnudged
  # status straight from the (read-only) event log. A milestone `done` event is
  # NOT agent state: only `finish` emits status:"done", so the `done` event is
  # ignored here and a runner between milestones stays running (a `now` after a
  # real finish revives, mirroring nudge_once's fold). The third column is "idle" for a worker
  # driven by awb send with no open task: it waits for the main agent, and a reminder only
  # woke it every round (Meshy, spec: it marked itself blocked to stop them)
  statuses=$( { [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s -r '
    rtrimstr("\n") | if . == "" then [] else split("\n") | map(fromjson? | select(type == "object")) end
    | reduce .[] as $e ({};
        if ($e.id | type) != "string" then .
        elif $e.t == "status" then .[$e.id].s = $e.status
          | (if $e.status == "running" or $e.status == "blocked" then . else .[$e.id].k = null end)
        elif $e.t == "now" then (if .[$e.id].s == "done" then .[$e.id].s = "running" else . end)
          | (if ($e.key // "") != "" then .[$e.id] += {k:$e.key, sent:true} else . end)
        elif $e.t == "done" and ($e.key // "") != "" and .[$e.id].k == $e.key then .[$e.id].k = null
        elif $e.t == "start" then .[$e.id].k = null
        else . end)
    | to_entries[] | "\(.key) \(.value.s // "running") \(if .value.sent and .value.k == null then "idle" else "-" end)"')
  live=$(tm list-panes -a -F '#{pane_id}' 2>/dev/null || true)
  tmp=$(mktemp "${df}.XXXXXX")
  agent_panes | while read -r id pane; do
    [ -n "$id" ] && [ -n "$pane" ] || continue
    st=$(printf '%s\n' "$statuses" | awk -v i="$id" '$1 == i {print $2; exit}')
    md=$(printf '%s\n' "$statuses" | awk -v i="$id" '$1 == i {print $3; exit}')
    # only a start event -> running (empty); nudge only live runners, so skip
    # every known non-running state and treat the rest as running.
    case $st in blocked|done|failed) continue ;; esac
    p=$(awk -v i="$id" 'index($0, i" ") == 1 && NF >= 3 {sub(/^[^ ]+ +[^ ]+ +/, ""); print; exit}' \
        "$AWB_DIR/panes" 2>/dev/null || true)
    if [ -z "$p" ]; then p=$(tm display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true); fi
    [ -n "$p" ] || continue
    if ! git -C "$p" rev-parse --git-dir >/dev/null 2>&1; then continue; fi
    h=$({ git -C "$p" rev-parse HEAD; git -C "$p" status --porcelain; git -C "$p" diff HEAD; } 2>/dev/null \
        | cksum | cut -d' ' -f1)
    old=$(awk -v i="$id" '$1 == i {print $2" "$3; exit}' "$df" 2>/dev/null || true)
    oldh=${old% *}; olde=${old#* }
    if [ -n "$oldh" ] && [ "$oldh" = "$h" ]; then ep=$olde; else ep=$now; fi
    printf '%s %s %s\n' "$id" "$h" "$ep" >> "$tmp"
    age=$((now - ep))
    if [ "$age" -lt "$frz" ] || [ "$md" = idle ]; then continue; fi
    # the file gains a line per reminder: the last one counts (the first let every round remind)
    last=$(awk -v i="$id" '$1 == i {l = $2} END {print l}' "$nf" 2>/dev/null || true)
    if [ $((now - ${last:-0})) -lt "$every" ]; then continue; fi
    mins=$((age / 60))
    # tell() dies on a dead pane; a per-agent poll must not abort the whole
    # round (that would drop every agent's fingerprint). Check liveness first.
    if ! printf '%s\n' "$live" | grep -Fxq "$pane"; then continue; fi
    if tell "$id" "[看板自动提醒] 你已 ${mins} 分钟没有代码改动。若在等远端作业，awb block $id \"等：<作业>\"；否则把任务切到一个能 30 分钟内提交的最小 commit 先交。" 2>/dev/null; then
      printf '%s %s\n' "$id" "$now" >> "$nf"
    fi
  done
  # drop stale ids, keep the just-seen set
  if [ -s "$tmp" ]; then mv "$tmp" "$df"; else rm -f "$tmp"; fi
  if [ -s "$nf" ]; then
    awk 'NR==FNR {seen[$1]=1; next} ($1 in seen)' "$df" "$nf" > "$nf.new" && mv "$nf.new" "$nf"
  fi
  unlock "freeze"
}

# nudge: paste a reminder into the pane of every agent silent >= AWB_STALE,
# at most once per AWB_NUDGE_EVERY. Panes map: $AWB_DIR/panes, lines "ID PANE".
# one nudge round at a time per board: the nudge loop and every open board (watch) start
# rounds, and a round already running in a live process is not repeated
nudge_round() {
  _nl=$AWB_DIR/lock-nudge
  if ! ln -s "$$" "$_nl" 2>/dev/null; then
    _hp=$(readlink "$_nl" 2>/dev/null || true)
    if [ -n "$_hp" ] && [ "$_hp" != "$$" ] && kill -0 "$_hp" 2>/dev/null; then return 0; fi
    rm -f "$_nl"; ln -s "$$" "$_nl" 2>/dev/null || return 0
  fi
  nudge_once
  rm -f "$_nl"
}

# the main agent's messaging, observed read-only in the Claude Code transcripts of this
# board's agents (~/.claude/projects/*/SESSION.jsonl, never written; no other session is read):
# a peer message an agent received from a session that is not one of this board's agents is
# "out" (the main agent to it), its own SendMessage to such a session is "in" (its reply). Only
# metadata is kept: time, direction, agent, the other session, the [awb ID#KEY] key and the
# message id; a reply with an open task's key does not close it (awb reply does). Each transcript is
# read from where the last round stopped ($AWB_DIR/obs: "OFFSET PATH"); a new or rewound one
# from the last 24 hours of its last 50 MB. A message id already on the board is not recorded
# again. AWB_OBSERVE=0 turns it off.
observe_once() {
  [ "${AWB_OBSERVE:-1}" != 0 ] && [ -s "$EV" ] || return 0
  _reg=$({ awk 1 "$HOME"/.claude/sessions/*.json 2>/dev/null || true; } \
         | jq -Rsc '[split("\n")[] | fromjson? | select(type == "object")]') || return 0
  _ag=$(sessions_json | jq -c 'to_entries | map({key:.value.name, value:.key}) | from_entries')
  [ "$_ag" != '{}' ] || return 0
  lock obs     # one round at a time: two open boards of one .awb would record a message twice
  _of=$AWB_DIR/obs; touch "$_of"; _nf=$(mktemp "$_of.XXXXXX"); _new=$(mktemp "$_of.XXXXXX")
  _since=$(($(date +%s) - 86400))
  printf '%s' "$_reg" | jq -r --argjson ag "$_ag" '.[] | select($ag[.name // ""] != null and (.sessionId // "") != "")
    | "\(.sessionId) \($ag[.name])"' | while read -r sid id; do
    f=$(ls "$HOME"/.claude/projects/*/"$sid.jsonl" 2>/dev/null | head -1); [ -n "$f" ] || continue
    sz=$(wc -c < "$f" | tr -d ' ')
    off=$(awk -v p="$f" '{o = $1; sub(/^[^ ]+ /, "")} $0 == p {print o}' "$_of")
    # ponytail: at most 50 MB per transcript per round; a longer gap is not replayed whole
    [ -n "$off" ] && [ "$off" -le "$sz" ] || off=0
    [ $((sz - off)) -le 50000000 ] || off=$((sz - 50000000))
    [ "$off" -lt "$sz" ] || { printf '%s %s\n' "$off" "$f" >> "$_nf"; continue; }
    # only whole lines: a line being written is read next round (a cut first line fails to parse)
    _c=$_new.c; tail -c +$((off + 1)) "$f" | head -c $((sz - off)) > "$_c"
    n=$(wc -c < "$_c" | tr -d ' ')
    [ "$n" = 0 ] || [ "$(tail -c 1 "$_c" | od -An -tx1 | tr -d ' ')" = 0a ] || n=$((n - $(tail -n 1 "$_c" | wc -c)))
    printf '%s %s\n' $((off + n)) "$f" >> "$_nf"
    [ "$n" -gt 0 ] || continue
    head -c "$n" "$_c" | jq -Rc --argjson ag "$_ag" --argjson reg "$_reg" --arg id "$id" --argjson since "$_since" '
      fromjson? | select(type == "object") | (.timestamp // "") as $ts
      | ($ts | sub("\\.[0-9]+Z$"; "Z") | fromdate? // empty) as $ep | select($ep >= $since)
      | def key: (capture("^\\[awb [^#\\]]+#(?<k>[^\\]]+)\\]").k // "");
        def name($p): first($reg[] | select(.pid == $p) | .name) // "";
        def ev($d; $n; $k; $m): select($ag[$n] == null)
          | {t:"msg", time:($ep | strflocaltime("%H:%M:%S")), ep:$ep, id:$id, dir:$d, via:$n, mid:$m}
            + (if $k == "" then {} else {key:$k} end);
      if .type == "assistant" then
        .message.content[]? | select(type == "object" and .type == "tool_use" and .name == "SendMessage")
        | (.input.to // "" | tostring) as $to
        | (if ($to | startswith("uds:")) then name($to | capture("cc-socks/(?<p>[0-9]+)\\.sock").p | tonumber)
           else $to | sub(" \\[[0-9a-f]+\\]$"; "") end) as $n
        | ev("in"; $n; (.input.message // "" | tostring | key); (.id // ""))
      # a message to the agent is written when it is queued (enqueue, the tag and the body)
      # and again when delivered: a peer turn if the agent was idle, a queued_command if busy.
      # All three give one id: the sender, the length and the code point sum of the body
      else
        def tagged: tostring | capture("^<cross-session-message(?<a>[^>]*)>(?<b>[\\s\\S]*?)(</cross-session-message>)?\\s*$");
        def from: .a | (capture("from-name=\"(?<n>[^\"]*)\"").n // "");
        def mid($n; $b): ($b | gsub("^\\s+|\\s+$"; "")) as $t | "\($n)/\($t | length)/\($t | explode | add // 0)";
        def got($n; $b): ev("out"; $n; ($b | gsub("^\\s+"; "") | key); mid($n; $b));
        if .type == "queue-operation" and .operation == "enqueue" then (.content | tagged? // empty) | got(from; .b)
        elif .type == "attachment" and (.attachment.type // "") == "queued_command" then
          (.attachment.prompt | tagged? // empty) | got(from; .b)
        elif (.origin.kind // "") == "peer" then
          .origin | got(.name // name(.verifiedPeerPid); .body // "" | tostring)
        else empty end end' 2>/dev/null
  done > "$_new"
  rm -f "$_new.c"
  mv "$_nf" "$_of"
  if [ -s "$_new" ]; then
    jq -sc --argjson seen "$(grep -F '"t":"msg"' "$EV" | jq -Rsc '[split("\n")[] | fromjson? | .mid // empty | select(. != "")]
          | map({key:., value:true}) | from_entries')" \
      '[.[] | select(.mid == "" or ($seen[.mid] | not))] | (map(select(.mid == "")) + (map(select(.mid != "")) | unique_by(.mid)))
       | sort_by(.ep)[]' "$_new" > "$_new.u"
    # a keyed reply is only recorded: a progress report carries the key too (Meshy, 2026-09-28:
    # "[awb env#K] 进度：…安装中" closed the task), so the main agent closes it with awb reply
    cat "$_new.u" >> "$EV"
  fi
  rm -f "$_new" "$_new.u"; unlock obs
}

nudge_once() {
  observe_once
  freeze_once
  stuck_once
  hold_once
  [ -s "$AWB_DIR/panes" ] || return 0
  now=$(date +%s)
  { [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s -r \
    --argjson now "$now" --argjson stale "${AWB_STALE:-600}" --argjson every "${AWB_NUDGE_EVERY:-900}" '
    rtrimstr("\n") | if . == "" then [] else split("\n") | map(fromjson? | select(type == "object")) end
    | reduce .[] as $e ({};
        if $e.id == null then .
        elif $e.t == "nudge" then .[$e.id].nudged = $e.ep
        elif $e.t == "status" then .[$e.id].last = $e.ep | .[$e.id].st = $e.status
        elif $e.t == "now" then .[$e.id].last = $e.ep | .[$e.id].st = (if .[$e.id].st == "done" then "running" else (.[$e.id].st // "running") end)
        elif ($e.t | IN("start","done")) then .[$e.id].last = $e.ep | .[$e.id].st = (.[$e.id].st // "running")
        else . end)
    | to_entries[]
    | select((.value.st // "running") == "running")
    | select($now - (.value.last // $now) >= $stale)
    | select($now - (.value.nudged // 0) >= $every)
    | "\(.key) \((($now - .value.last) / 60) | floor)"' |
  while read -r id mins; do
    msg="[看板自动提醒] 你（${id}）已 ${mins} 分钟没更新看板。请现在报一句结果：AWB_DIR=$AWB_DIR awb now $id \"<结果>\"；卡住用 awb block $id \"<原因>\"；做完用 awb finish $id \"<成果>\"。"
    # in a subshell: tell exits for an agent it cannot reach, which must not end the round
    ( tell "$id" "$msg" ) 2>/dev/null || continue
    append '{t:"nudge",time:$time,ep:$ep,id:$id}' --arg id "$id"
  done
}

# a Claude session that stopped with an unexecuted tool call printed as text (a model that
# emits its call syntax instead of calling) looks idle, not silent: it may have reported a
# minute ago. Its pane tail matches AWB_STUCK_RE while the registry says idle for
# AWB_STUCK_AFTER seconds; it is told to re-issue, at most once per AWB_STUCK_EVERY.
stuck_once() {
  re=${AWB_STUCK_RE-DSML|<invoke name=|</?function_calls>}
  [ -n "$re" ] || return 0
  now=$(date +%s); sj=$(sessions_json)
  agent_panes | while read -r id pane; do
    since=$(printf '%s' "$sj" | jq -r --arg i "$id" '.[$i] | select(.status == "idle") | .since')
    [ -n "$since" ] && [ $((now - since)) -ge "${AWB_STUCK_AFTER:-120}" ] || continue
    hit=$(tm capture-pane -p -t "$pane" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -15 | grep -Eo "$re" | tail -1)
    [ -n "$hit" ] || continue     # the pipeline's status is tail's, so test the match itself
    last=$(grep -F "\"id\":\"$id\"" "$EV" 2>/dev/null | grep -F '"why":"stuck"' | tail -1 | jq -R -r 'fromjson? | .ep' || true)
    [ $((now - ${last:-0})) -ge "${AWB_STUCK_EVERY:-600}" ] || continue
    ( tell "$id" "[看板自动提醒] 你上一条输出里的工具调用（${hit}）被打印成了文本，没有执行，会话已停。请重新发出那条调用，然后继续。" ) 2>/dev/null || continue
    append '{t:"nudge",time:$time,ep:$ep,id:$id,why:"stuck",hit:$h}' --arg id "$id" --arg h "$hit"
  done
}

# a holder that has not worked for AWB_STALE keeps everyone queued behind the resource (a
# session that died mid-turn held a GPU for hours while the board showed it): it is told to
# report or release, at most once per AWB_NUDGE_EVERY. Quiet is the render's: a busy session
# is working; otherwise the session's idle time, or the board silence of an agent without one.
hold_once() {
  now=$(date +%s); sj=$(sessions_json)
  { [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s -r --argjson now "$now" --argjson sess "$sj" '
    rtrimstr("\n") | if . == "" then [] else split("\n") | map(fromjson? | select(type == "object")) end
    | (reduce .[] as $e ({}; if ($e.id | type) == "string" and $e.t != "nudge" then .[$e.id] = ($e.ep // 0) else . end)) as $last
    | [.[] | select((.t == "hold" or .t == "release") and (.res | type) == "string")]
    | group_by(.res)[] | sort_by(.ep // 0) | last | select(.t == "hold")
    | ($sess[.owner] // null) as $x
    | (if $x != null then (if $x.status == "busy" then 0 else $now - $x.since end)
       else $now - ($last[.owner] // $now) end) as $q
    | "\(.res) \(.owner) \($q) \($now - (.ep // $now))"' |
  while read -r res own q held; do
    [ "$q" -ge "${AWB_STALE:-600}" ] || continue
    last=$(grep -F "\"id\":\"$own\"" "$EV" 2>/dev/null | grep -F '"why":"hold"' | tail -1 | jq -R -r 'fromjson? | .ep' || true)
    [ $((now - ${last:-0})) -ge "${AWB_NUDGE_EVERY:-900}" ] || continue
    ( tell "$own" "[看板自动提醒] 你占着 ${res} 已 $((held / 60)) 分钟，最近 $((q / 60)) 分钟没在干活，别人在排队。还在用就报一句进度（awb now $own \"...\"）；用完了就恢复现场并 awb release ${res} ${own}。" ) 2>/dev/null || continue
    append '{t:"nudge",time:$time,ep:$ep,id:$id,why:"hold",res:$r}' --arg id "$own" --arg r "$res"
  done
}

watch() {
  printf '\033[?1049h\033[H\033[2J'
  # The board is rendered in full and scrolls: j/k, arrows or the mouse wheel by lines,
  # space/b by pages, g/G to the top/end, q quits. Keys are read with a timeout of one
  # refresh (stty time); the wheel arrives as SGR mouse reports, which tmux forwards once
  # the pane asks for them. Without a terminal on stdin the board just refreshes.
  kb=0; [ -t 0 ] && kb=1
  if [ $kb = 1 ]; then
    _stty=$(stty -g)
    stty -icanon -echo min 0 time "$(awk -v i="${AWB_INTERVAL:-1}" 'BEGIN { t = int(i * 10); print (t < 1 ? 1 : t) }')"
    printf '\033[?1000h\033[?1006h'
    trap 'printf "\033[?1000l\033[?1006l\033[?1049l"; stty "$_stty"' EXIT
  else
    # INT/TERM must end the loop (a bare trap on them ignored kill); EXIT restores the screen
    trap 'printf "\033[?1049l"' EXIT
  fi
  trap 'exit 130' INT TERM
  # an open board also runs the nudge rounds (awb nudge), so agents are reminded wherever a
  # board is up; AWB_NUDGE=0 turns that off. The first round waits one AWB_NUDGE_POLL.
  last=; synced=0; off=0; full=; rt=0; nudged=$(date +%s)
  # the script as this loop read it: a new install (a moved pin, a release) re-execs the board,
  # so a running board takes it without its user restarting the pane
  _self=$(cksum < "$BIN")
  # a board linked to a Lark topic (awb-lark sync ran once for it: lark.json) syncs it once a
  # minute, in the background. An unlinked board stays local: with only the group set, every
  # sandbox and scratch board a worker opened used to post a topic of its own to the group
  lk=$(dirname "$(readlink "$BIN" 2>/dev/null || echo "$BIN")")/awb-lark
  [ -x "$lk" ] || lk=$(command -v awb-lark || true)
  # A tick starts a sync only when the last one has ended (its pid is in lock-lark); one
  # running for AWB_LARK_STALE seconds is killed with its lark-cli (model/tla/AwbLark.tla)
  while :; do
    if [ -n "$lk" ] && [ -s "$AWB_DIR/lark.json" ] && [ -s "${XDG_CONFIG_HOME:-$HOME/.config}/awb/lark-chat" ] \
       && [ $(($(date +%s) - synced)) -ge "${AWB_LARK_EVERY:-60}" ]; then
      synced=$(date +%s)
      lp=$(readlink "$AWB_DIR/lock-lark" 2>/dev/null || true)
      if [ -n "$lp" ] && kill -0 "$lp" 2>/dev/null; then
        la=$(stat -f %m "$AWB_DIR/lock-lark" 2>/dev/null || stat -c %Y "$AWB_DIR/lock-lark" 2>/dev/null || echo "$synced")
        if [ $((synced - la)) -ge "${AWB_LARK_STALE:-300}" ]; then
          pkill -TERM -P "$lp" 2>/dev/null || true; kill -TERM "$lp" 2>/dev/null || true
        fi
      else
        ( AWB="$BIN" "$lk" sync >/dev/null 2>&1 & )
      fi
    fi
    if [ $(($(date +%s) - nudged)) -ge "${AWB_NUDGE_POLL:-60}" ]; then
      nudged=$(date +%s)
      if [ "$(cksum < "$BIN" 2>/dev/null)" != "$_self" ] && sh -n "$BIN" 2>/dev/null; then
        if [ $kb = 1 ]; then printf '\033[?1000l\033[?1006l'; stty "$_stty"; fi
        exec "$BIN" view
      fi
      # AWB_NUDGE=0 stops the reminders typed into agents, not the read-only observation
      if [ "${AWB_NUDGE:-1}" != 0 ]; then ( "$BIN" nudge --once >/dev/null 2>&1 & )
      else ( "$BIN" _observe >/dev/null 2>&1 & ); fi
    fi
    set -- $(dims); cols=${1:-80}; rows=${2:-24}
    # a key within the same second scrolls what is on screen instead of rendering again
    now=$(date +%s)
    if [ "$now" != "$rt" ] || [ -z "$full" ]; then
      rt=$now; full=$(AWB_COLS=$cols AWB_ROWS=5000 render)
    fi
    n=$(printf '%s\n' "$full" | wc -l | tr -d ' ')
    if [ "$n" -le "$rows" ]; then off=0; out=$full
    elif [ "$off" -eq 0 ]; then
      # the first screen renders at the real pane height so the brief view packs needs/anomalies
      # and prints its own "还有 N 行" line; $full (5000 rows) is only for scrolling below
      out=$(AWB_COLS=$cols AWB_ROWS=$rows render)
    else
      max=$((n - rows + 1)); [ "$off" -le "$max" ] || off=$max; [ "$off" -ge 0 ] || off=0
      out=$(printf '%s\n' "$full" | sed -n "$((off + 1)),$((off + rows - 1))p")
      below=$((n - off - rows + 1))
      if [ "$below" -gt 0 ]; then hint="↓ 还有 $below 行 · j/k ↑↓ 滚轮 · 空格翻页 · g 顶部"
      else hint="↑ 上面 $off 行 · k ↑ 滚轮 · g 顶部"; fi
      out="$out
${ESC}[2m  ${hint}${ESC}[0m"
    fi
    if [ "$out" != "$last" ]; then
      last=$out
      printf '\033[H\033[2J%s' "$out"
    fi
    if [ $kb = 1 ]; then
      # one read can hold several keys (a fast wheel, typed ahead): take them in turn
      k=$(dd bs=256 count=1 2>/dev/null || true); i=0
      while [ -n "$k" ] && [ $i -lt 256 ]; do
        i=$((i + 1))
        case "$k" in
          "${ESC}["\<*)   # SGR mouse report: ESC [ < button ; x ; y M|m
            case "$k" in "${ESC}[<64;"*) off=$((off - 3)) ;; "${ESC}[<65;"*) off=$((off + 3)) ;; esac
            r=${k#*[Mm]}; [ "$r" != "$k" ] || r=; k=$r; continue ;;
          "${ESC}[A"*|"${ESC}OA"*) off=$((off - 1)); k=${k#???}; continue ;;
          "${ESC}[B"*|"${ESC}OB"*) off=$((off + 1)); k=${k#???}; continue ;;
          "${ESC}[5~"*) off=$((off - rows + 2)); k=${k#????}; continue ;;
          "${ESC}[6~"*) off=$((off + rows - 2)); k=${k#????}; continue ;;
        esac
        c=${k%"${k#?}"}; k=${k#?}
        case "$c" in
          q) exit 0 ;;
          k) off=$((off - 1)) ;;
          j) off=$((off + 1)) ;;
          " ") off=$((off + rows - 2)) ;;
          b) off=$((off - rows + 2)) ;;
          g) off=0 ;;
          G) off=$n ;;
        esac
      done
      [ "$off" -ge 0 ] || off=0
    else
      sleep "${AWB_INTERVAL:-1}"
    fi
  done
}

up() {
  command -v tmux >/dev/null || die "tmux not installed"
  init_dir
  SOCK=$(sock_path)
  _have=0
  [ -S "$SOCK" ] && tmux -S "$SOCK" has-session -t awb 2>/dev/null && _have=1
  # inside tmux a nested attach does not work: the board opens beside this pane. But when
  # this board already has a session on its own socket, say where it is instead of opening
  # a second board next to the current pane.
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    if [ "$_have" = 1 ]; then
      echo "awb session already up for $AWB_DIR; attach in another terminal: tmux -S $(q "$SOCK") attach -t awb"
      return 0
    fi
    board; return
  fi
  # without a terminal (an agent runs awb up) the session is made and the user attaches later
  _att() {
    if [ -t 0 ] && [ -t 1 ]; then exec tmux -S "$SOCK" attach-session -t awb; fi
    echo "awb session ready (board + work pane); to watch it, run in a terminal: tmux -S $(q "$SOCK") attach -t awb"
  }
  if [ "$_have" = 1 ]; then _att; return 0; fi
  rm -f "$SOCK"
  tmux -S "$SOCK" new-session -d -s awb -n board -P -F '#{pane_id}' \
    -e "AWB_DIR=$AWB_DIR" -e "AWB_TMUX_SOCKET=$SOCK" -e "AWB_TMUX_FOR=$AWB_DIR" \
    "AWB_DIR=$(q "$AWB_DIR") AWB_TMUX_SOCKET=$(q "$SOCK") AWB_TMUX_FOR=$(q "$AWB_DIR") $(q "$BIN") view" >/dev/null
  board=$(tmux -S "$SOCK" list-panes -t awb:board -F '#{pane_id}' | head -1)
  work=$(tmux -S "$SOCK" split-window -v -t "$board" -d -p 45 -P -F '#{pane_id}' \
           -e "AWB_DIR=$AWB_DIR" -e "AWB_TMUX_SOCKET=$SOCK" -e "AWB_TMUX_FOR=$AWB_DIR" "$SHELL")
  printf '%s\n' "$work" > "$AWB_DIR/work-pane"
  tmux -S "$SOCK" select-pane -t "$board" -T board
  tmux -S "$SOCK" select-pane -t "$work"  -T work
  tmux -S "$SOCK" setw -t awb:board pane-border-status top
  tmux -S "$SOCK" setw -t awb:board pane-border-format ' #{?pane_title,#{pane_title},pane} '
  _att
}

# the pane of a new agent (globals id name group sock work): split beside the work pane; a
# window with no room left (tmux: "no space for new pane", about 5 agents) gets a new window
agent_split() {
  set -- -P -F '#{pane_id}' -e "AWB_DIR=$AWB_DIR" -e "AWB_TMUX_SOCKET=$sock" -e "AWB_TMUX_FOR=$AWB_DIR" \
    -e "AWB_GROUP=$group" -e "AWB_AGENT_ID=$id" -e "AWB_AGENT_NAME=$name" -e "AWB_AGENT_KIND=$1" "$2"
  tm split-window -h -t "$work" "$@" 2>/dev/null \
    || tm new-window -a -d -t "$(tm display-message -p -t "$work" '#{window_id}')" "$@"
  # ponytail: one window per agent past a full one; split the newest window first if it matters
}
# a second agent with a live id took over its events, and the first ran on untracked
not_running() {
  _p=$(agent_pane "$1"); [ -n "$_p" ] && tm list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$_p" || return 0
  _st=$({ grep -F "\"id\":\"$1\"" "$EV" 2>/dev/null || true; } | jq -R -s -r \
    '[split("\n")[] | fromjson? | select(type == "object" and (.t == "start" or .t == "status"))] | last | .status // "running"')
  case $_st in failed|done) ;; *) die "$1 is running in pane $_p; use another id, or end it first ($PROG fail $1 REASON)" ;; esac
}

run() {
  group=${AWB_GROUP:-default}
  case "${1:-}" in
    -g) [ $# -ge 2 ] || die "usage: $PROG run [-g GROUP] ID NAME -- CMD..."
        group=$2; shift 2 ;;
  esac
  [ $# -ge 3 ] || die "usage: $PROG run [-g GROUP] ID NAME -- CMD..."
  id=$1; name=$2; shift 2
  [ "${1:-}" = -- ] && shift
  [ $# -ge 1 ] || die "usage: $PROG run [-g GROUP] ID NAME -- CMD..."
  case $id in *[!A-Za-z0-9_-]* ) die "id must match [A-Za-z0-9_-] (got: $id)";; esac
  init_dir; not_running "$id"
  work=$(cat "$AWB_DIR/work-pane" 2>/dev/null) && [ -n "$work" ] || die "run '$PROG up' first"
  tm list-panes -t "$work" >/dev/null 2>&1 || die "work pane $work gone; restart with '$PROG up'"
  kind=$(basename -- "$1")
  cmdq=$(for a in "$@"; do printf '%s ' "$(q "$a")"; done)
  sock=${AWB_TMUX_SOCKET:-$(sock_path)}
  inner="AWB_DIR=$(q "$AWB_DIR") AWB_TMUX_SOCKET=$(q "$sock") AWB_TMUX_FOR=$(q "$AWB_DIR") AWB_GROUP=$(q "$group") \
AWB_AGENT_ID=$(q "$id") AWB_AGENT_NAME=$(q "$name") AWB_AGENT_KIND=$(q "$kind") \
$(q "$BIN") _enter; rc=0; $cmdq || rc=\$?; \
AWB_DIR=$(q "$AWB_DIR") $(q "$BIN") _leave \$rc; exec $(q "$SHELL")"
  pane=$(agent_split "$kind" "$inner")
  tm select-pane -t "$pane" -T "$name"
}

tui() {
  group=${AWB_GROUP:-default}
  case "${1:-}" in
    -g) [ $# -ge 2 ] || die "usage: $PROG tui [-g GROUP] ID NAME [TASK...]"
        group=$2; shift 2 ;;
  esac
  [ $# -ge 2 ] || die "usage: $PROG tui [-g GROUP] ID NAME [TASK...]"
  id=$1; name=$2; shift 2
  case $id in *[!A-Za-z0-9_-]* ) die "id must match [A-Za-z0-9_-] (got: $id)";; esac
  init_dir; not_running "$id"
  work=$(cat "$AWB_DIR/work-pane" 2>/dev/null) && [ -n "$work" ] || die "run '$PROG up' first"
  tm list-panes -t "$work" >/dev/null 2>&1 || die "work pane gone; restart with '$PROG up'"
  tui_cmd=${AWB_TUI_CMD:-$(command -v claude-db >/dev/null && echo claude-db || echo claude)}
  command -v "${tui_cmd%% *}" >/dev/null || die "$tui_cmd not on PATH (set AWB_TUI_CMD)"
  sock=${AWB_TMUX_SOCKET:-$(sock_path)}
  # resident TUI: register, run interactive claude, drop to shell on exit (pane stays)
  inner="AWB_DIR=$(q "$AWB_DIR") AWB_TMUX_SOCKET=$(q "$sock") AWB_TMUX_FOR=$(q "$AWB_DIR") AWB_GROUP=$(q "$group") \
AWB_AGENT_ID=$(q "$id") AWB_AGENT_NAME=$(q "$name") AWB_AGENT_KIND=claude \
$(q "$BIN") _enter; $tui_cmd; exec $(q "$SHELL")"
  pane=$(agent_split claude "$inner")
  tm select-pane -t "$pane" -T "$name"
  # first message: Chinese working rules + optional task.
  # paste via buffer — a plain Enter does not submit inside the claude TUI.
  task=$*
  # first line = the task; the main agent keeps the board from the worker's replies
  prompt="${task:-待命，等主控派任务}
（你是 awb 工作台上的 worker ${id}，组 ${group}，请用中文。任务会由主控发来；每个任务做完用一句话汇报结果，主控据此更新看板。完整规则：awb skill）"
  # Claude registers its pane in ~/.claude/sessions once it is ready, i.e. after startup
  # prompts such as folder trust, which awb leaves to the user. Then the first message goes
  # in, and the main agent messages the worker by that session name (SendMessage).
  i=0; sess=; warned=
  while [ $i -lt "${AWB_TUI_WAIT:-120}" ]; do
    sess=$(peers | awk -v i="$id" '$1 == i && $3 != "-" {print $3}')
    [ -n "$sess" ] && break
    if [ -z "$warned" ] && tm capture-pane -p -t "$pane" 2>/dev/null | grep -q "trust this folder"; then
      echo "$id: answer the folder-trust prompt in pane $pane; awb does not answer it"; warned=1
    fi
    sleep 1; i=$((i + 1))
  done
  [ -n "$sess" ] || { echo "$id: Claude not ready; message it later ('$PROG peers', '$PROG tell')"; return 1; }
  tell "$id" "$prompt"
  echo "$id session: $sess"
}

# ID PANE per agent: $AWB_DIR/panes ("ID PANE" lines, for agents started outside awb)
# overrides the pane of the latest start event
# mutual exclusion under $AWB_DIR (mkdir is atomic). Waits up to AWB_LOCK_WAIT seconds;
# a lock whose holder died is taken over. Released on exit. Races found in model/tla/.
# ponytail: takeover reads the pid then removes the dir, so two takers can race after a crash
lock() {
  _l=$AWB_DIR/lock-$1; _n=0
  until mkdir "$_l" 2>/dev/null; do
    _o=$(cat "$_l/pid" 2>/dev/null || true)
    if [ -n "$_o" ] && ! kill -0 "$_o" 2>/dev/null; then rm -rf "$_l"; continue; fi
    _n=$((_n + 1)); [ $_n -le $((${AWB_LOCK_WAIT:-600} * 5)) ] || die "$1 is locked by pid ${_o:-?}"
    sleep 0.2
  done
  echo $$ > "$_l/pid"
  LOCKS="${LOCKS:-} $_l"; trap 'rm -rf $LOCKS' EXIT; trap 'exit 130' INT TERM
}
# drop it from LOCKS too: otherwise this process's EXIT trap would later remove the lock
# another process has taken since, and a third one could enter
unlock() {
  rm -rf "$AWB_DIR/lock-$1"
  _k=; for _x in ${LOCKS:-}; do [ "$_x" = "$AWB_DIR/lock-$1" ] || _k="$_k $_x"; done; LOCKS=$_k
}

# the agent's open milestone ("EP TEXT" of its last `now`, if no `done` came after)
open_ms() {
  [ -s "$EV" ] || return 0
  grep -F "\"id\":\"$1\"" "$EV" | grep -E '"t":"(now|done)"' | tail -1 | jq -R -r 'fromjson? | select(.t == "now") | "\(.ep) \(.text)"'
}

# dispatch/report loop with a worker over the session socket (model/tla/AwbLoop.tla):
# one open task per worker, each with a key its reply must echo; an idle notice never closes a
# task: the first makes the main ask once, the second marks the task blocked for the user.
# a sent task is a node of the task tree; the fold (the board's own rule) says which is open:
# "ID KEY" per agent. A reply closes it; a restart, a failure or a newer task loses it; a
# finish closes it with no result. blocked keeps it open: the reply may still come.
open_keys() {
  [ -s "$EV" ] || return 0
  events_json | jq -r "$JQ_FOLD"' fold | .agents[] | select(.key != null) | "\(.id) \(.key)"'
}
open_key() { open_keys | awk -v i="$1" '$1 == i {print $2}'; }
# now/done are for agents that report themselves (awb run); a sent task is closed by its
# reply, which the main agent records: a worker's own stage report once closed it
self_report() {
  need_agent "$1"; _k=$(open_key "$1")
  [ -z "$_k" ] || die "$1 has task #$_k from awb send; its reply closes it ($PROG reply $1 $_k RESULT)"
}
send() {
  _par=; if [ "${1:-}" = --under ]; then _par=${2:-}; shift 2 || die "--under needs a task id"; fi
  [ $# -ge 2 ] || die "usage: $PROG send [--under PARENT] ID TASK|TASKID [TEXT]   (prints the message to SendMessage)"
  id=$1; shift; need_agent "$id"
  k=$(open_key "$id"); [ -z "$k" ] || die "$id already has open task #$k; wait for its reply (or: $PROG idle $id)"
  # a planned task (awb task T1 todo ...) not yet done or sent is sent as it is: its id is the key
  _pt=$(events_json | jq -r --arg t "$1" "$JQ_FOLD"' fold | select(all(.agents[]; .key != $t))
    | .tasks[$t] // empty | select(.state | IN("done","drop") | not) | .text' || true)
  if [ -n "$_pt" ]; then
    k=$1; shift; [ $# -gt 0 ] || set -- "$_pt"
  else
    # a fresh key names no task or key on the board yet (time and pid digits can repeat)
    _b=$(date +%s | tail -c 5)$(printf %02d $(( $$ % 100 ))); k=$_b; _i=0
    while grep -qE "\"(id|key)\":\"$k\"" "$EV" 2>/dev/null && [ $_i -lt 100 ]; do _i=$((_i + 1)); k=$_b$_i; done
  fi
  append '{t:"now",time:$time,ep:$ep,id:$id,text:$x,key:$k} + (if $p == "" then {} else {parent:$p} end)' \
    --arg id "$id" --arg x "$*" --arg k "$k" --arg p "$_par"
  printf '[awb %s#%s] %s\n做完后回复一行：以 [awb %s#%s] 开头，写结果（做不了也照此格式说明原因）。\n' "$id" "$k" "$*" "$id" "$k"
  # the task is only recorded here; the text above still has to reach the worker
  echo "$PROG: recorded $id #$k; deliver the text above with SendMessage (or: $PROG tell $id \"\$msg\")" >&2
}
reply() {
  [ $# -ge 2 ] || die "usage: $PROG reply ID KEY [RESULT]"
  id=$1; k=$2; shift 2; init_dir
  [ "$(open_key "$id")" = "$k" ] || die "no open task #$k for $id (stale or duplicate reply): ignored"
  append '{t:"done",time:$time,ep:$ep,id:$id,text:(if $x == "" then null else $x end),key:$k}' \
    --arg id "$id" --arg x "$*" --arg k "$k"
  echo "closed $id #$k"
}
idle() {
  [ $# -ge 1 ] || die "usage: $PROG idle ID"
  id=$1; init_dir
  k=$(open_key "$id"); [ -n "$k" ] || { echo "$id: no open task"; return 0; }
  if grep -F "\"id\":\"$id\"" "$EV" | grep -F '"t":"ask"' | grep -qF "\"key\":\"$k\""; then
    append '{t:"status",time:$time,ep:$ep,id:$id,status:"blocked",reason:$r}' --arg id "$id" \
      --arg r "空闲两次仍未汇报 #${k}：消息可能在对方会话里等用户批准，请用户去看"
    echo "blocked $id #$k: tell the user (the worker's session may be holding the message for approval)"
  else
    append '{t:"ask",time:$time,ep:$ep,id:$id,key:$k}' --arg id "$id" --arg k "$k"
    printf '[awb %s#%s] 请汇报这个任务的结果：以 [awb %s#%s] 开头回复一行。\n' "$id" "$k" "$id" "$k"
  fi
}
# open a PR for an agent's work from the current git checkout, only when the agent's
# latest `awb check` passed; the body lists its milestones and that check's steps
pr() {
  _u="usage: $PROG pr ID [--expect REGEX] [gh pr create args...] -- CMD..."
  [ $# -ge 1 ] || die "$_u"
  id=$1; shift; need_agent "$id"
  _gh=; _acc=; _pexp=
  while [ $# -gt 0 ]; do
    if [ "$1" = -- ]; then shift; _acc=1; break; fi
    if [ "$1" = --expect ] && [ $# -ge 2 ]; then _pexp=$2; shift 2; continue; fi
    _gh="$_gh $(q "$1")"; shift
  done
  [ -n "$_acc" ] && [ $# -ge 1 ] || die "$_u (the acceptance runs here, then the PR)"
  # the acceptance runs in this process: a passing check read from the log could have been
  # written there by the agent, check events and all
  if [ -n "$_pexp" ]; then "$BIN" check "$id" --expect "$_pexp" -- "$@" || die "acceptance failed: no PR"
  else "$BIN" check "$id" -- "$@" || die "acceptance failed: no PR"; fi
  eval "set -- $_gh"
  lock "gate-$id"     # no check of this agent can interleave between the gate and the PR
  info=$({ [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s --arg id "$id" '
    [split("\n")[] | fromjson? | select(type == "object" and .id == $id)] as $es
    | ([$es[] | select(.t == "chk")] | group_by(.run) | sort_by(.[0].ep) | last // []) as $run
    | ($run | reduce .[] as $e ({o:[], s:{}};
        (if .s[$e.step] == null then .o += [$e.step] else . end) | .s[$e.step] = $e.state)) as $st
    | (reduce $es[] as $e ({cur:null, ms:[]};
        if $e.t == "now" then .cur = $e.text
        elif $e.t == "done" and $e.verified and .cur == null and $e.text == null and (.ms | length) > 0
          then .ms[-1] |= (if startswith("⊢ ") then . else "⊢ " + . end)
        elif $e.t == "done" then .ms += [(if $e.verified then "⊢ " else "" end) + ($e.text // .cur // "milestone")] | .cur = null
        else . end) | .ms) as $ms
    | {pass: (($st.o | length) > 0 and all($st.s[]; . == "ok")),
       name: ([$es[] | select(.t == "start") | .name] | first // $id),
       title: ($ms | last // "" | ltrimstr("⊢ ")),
       body: ("## Milestones\n" + ([$ms[] | "- " + .] | join("\n"))
              + "\n\n## Acceptance\n`" + ($run[0].what // "") + "`: "
              + ([$st.o[] | . + " " + (if $st.s[.] == "ok" then "✓" else "✗" end)] | join(" → ")))}')
  [ "$(printf '%s' "$info" | jq -r .pass)" = true ] || die "$id has no passing awb check; run '$PROG check $id ...' first"
  if m=$(model_bin); then
    v=$("$m" audit < "$EV" | awk -v i="$id" '$1 == i {print $2}' | sort -u | tr '\n' ' ')
    [ -z "$v" ] || die "audit: $id has protocol violations: $v"
  fi
  br=$(git rev-parse --abbrev-ref HEAD) || die "not a git checkout"
  def=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name) || die "gh cannot see this repo"
  [ "$br" != "$def" ] || die "on $def; commit the agent's work on a branch first"
  git push -q -u origin HEAD
  url=$(gh pr create --title "$(printf '%s' "$info" | jq -r '.name + ": " + .title')" \
    --body "$(printf '%s' "$info" | jq -r .body)" "$@") || return 1
  echo "$url"
  append '{t:"pr",time:$time,ep:$ep,id:$id,url:$u}' --arg id "$id" --arg u "$url"
}

# shared resources (a GPU card, a staging host): one holder at a time. hold/release events
# carry no agent id, so the proven fold drops them like metric; render reads them for the board.
holder() {   # "OWNER EP NOTE" of RES; exit 1 when free
  init_dir
  _h=$({ [ -s "$EV" ] && cat "$EV" || true; } | jq -R -r --arg r "$1" 'fromjson?
    | select(type == "object" and (.t == "hold" or .t == "release") and .res == $r)
    | "\(.t) \(.owner // "-") \(.ep // 0) \(.note // "")"' | tail -1)
  case $_h in hold\ *) printf '%s\n' "${_h#hold }" ;; *) return 1 ;; esac
}
hold() {
  if [ $# -eq 0 ]; then   # every held resource: RES OWNER SINCE NOTE
    init_dir; events_json | jq -r '[.[] | select((.t == "hold" or .t == "release") and (.res | type) == "string")]
      | group_by(.res)[] | sort_by(.ep // 0) | last | select(.t == "hold")
      | "\(.res) \(.owner // "-") \((.ep // 0) | strflocaltime("%H:%M")) \(.note // "")"'
    return 0
  fi
  [ $# -ge 2 ] || die "usage: $PROG hold [RES OWNER [NOTE]]"
  res=$1; own=$2; shift 2; init_dir
  lock "res-$res"
  if cur=$(holder "$res"); then
    o=${cur%% *}
    [ "$o" = "$own" ] || die "$res is held by $o since $(date -r "$(echo "$cur" | cut -d' ' -f2)" +%H:%M 2>/dev/null || echo '?'); ask $o, or: $PROG release $res $o"
  fi
  append '{t:"hold",time:$time,ep:$ep,res:$r,owner:$o,note:$n}' --arg r "$res" --arg o "$own" --arg n "$*"
  unlock "res-$res"
}
release() {
  [ $# -ge 1 ] || die "usage: $PROG release RES [OWNER]"
  res=$1; init_dir
  lock "res-$res"
  cur=$(holder "$res") || { echo "$res is free"; unlock "res-$res"; return 0; }
  o=${cur%% *}
  [ -z "${2:-}" ] || [ "$2" = "$o" ] || die "$res is held by $o, not $2"
  append '{t:"release",time:$time,ep:$ep,res:$r,owner:$o}' --arg r "$res" --arg o "$o"
  unlock "res-$res"
}

# merge a PR only when the newest verdict on its CURRENT head approves and the required checks
# actually ran green. A verdict is a PR review on the head, or a comment whose first line names
# the head's short sha; a comment verdict counts only when that whole line matches
# AWB_APPROVE_RE, so "APPROVE ... with one fix" or a later correction does not. A check that
# never started is not green: at least AWB_MIN_CHECKS successes named by AWB_REQUIRE_CHECKS.
merge() {
  [ $# -ge 1 ] || die "usage: $PROG merge PR [--watch]"
  n=$1; _watch=0; [ "${2:-}" != --watch ] || _watch=1; init_dir
  for _i in $(seq 1 "${AWB_MERGE_POLLS:-240}"); do
    j=$(gh pr view "$n" --json state,headRefOid,reviews,comments,statusCheckRollup) || die "gh cannot read PR $n"
    v=$(printf '%s' "$j" | jq -r --arg re "${AWB_APPROVE_RE:-^\\*\\*APPROVE \\([^)]*\\)\\*\\*\$}" \
          --arg req "${AWB_REQUIRE_CHECKS:-.}" --argjson min "${AWB_MIN_CHECKS:-1}" '
      .headRefOid as $sha | $sha[:8] as $h
      | ([(.reviews // [])[] | select((.commit.oid // "") == $sha and (.state | IN("APPROVED","CHANGES_REQUESTED")))
          | {ep:.submittedAt, ok:(.state == "APPROVED")}]
         + [(.comments // [])[] | (.body | split("\n")[0]) as $l
            | select(($l | contains($h)) and ($l | test("APPROVE|REQUEST CHANGES|CHANGES REQUESTED")))
            | {ep:.createdAt, ok:($l | test($re))}]
         | sort_by(.ep) | last) as $v
      | [(.statusCheckRollup // [])[] | {name:(.name // .context // ""), c:((.conclusion // "") | if . == "" then null else . end) // (.state // "")}] as $cs
      | ([$cs[] | select(.c | IN("","PENDING","EXPECTED","QUEUED","IN_PROGRESS"))] | length) as $pend
      | ([$cs[] | select(.c | IN("FAILURE","ERROR","CANCELLED","TIMED_OUT","ACTION_REQUIRED","STARTUP_FAILURE"))] | length) as $bad
      | ([$cs[] | select(.c == "SUCCESS" and (.name | test($req)))] | length) as $good
      | (if $v == null then "none" elif $v.ok then "approve" else "changes" end) as $vd
      | (if $bad > 0 then "red" elif $pend > 0 then "pending" elif $good < $min then "missing" else "green" end) as $ck
      | "\(.state) \($sha) \($vd) \($ck) \($good)/\($min)"')
    set -- $v
    echo "#$n $(date +%H:%M) head ${2%"${2#????????}"} verdict $3 checks $4 ($5 required-green)"
    [ "$1" != MERGED ] || return 0
    if [ "$3" = approve ] && [ "$4" = green ]; then
      gh pr merge "$n" "--${AWB_MERGE_METHOD:-merge}" --match-head-commit "$2" || die "merge of #$n refused"
      append '{t:"news",time:$time,ep:$ep,text:$x,key:$k}' --arg k "pr#$n" --arg x "PR #$n merged (head ${2%"${2#????????}"})"
      echo "#$n merged"; return 0
    fi
    [ "$4" != red ] || [ "$3" != approve ] || die "#$n: approved but checks are red"
    [ "$_watch" = 1 ] || return 1
    sleep "${AWB_MERGE_POLL:-60}"
  done
  die "#$n not mergeable after ${AWB_MERGE_POLLS:-240} polls"
}

# board beside the current tmux pane (the conversation), for chat-driven use
board() {
  init_dir; [ -f "$EV" ] || : > "$EV"
  if [ -z "${TMUX_PANE:-}" ]; then
    echo "not in tmux; watch it from another terminal: AWB_DIR=$AWB_DIR $PROG view"; return 0
  fi
  printf '%s\n' "$TMUX_PANE" > "$AWB_DIR/work-pane"      # awb tui/run split from here
  # one board per .awb: a board already open anywhere on this server is reused, not repeated
  # (workers that each ran awb board once left five 7-column boards squeezed between them)
  _b=$(tmux list-panes -a -F '#{pane_id} #{session_name}:#{window_index}.#{pane_index} #{pane_start_command}' 2>/dev/null \
       | grep -F "AWB_DIR=$(q "$AWB_DIR") " | grep -E ' (view|watch)' | head -n 1 | cut -d' ' -f2)
  if [ -n "$_b" ]; then echo "board: $AWB_DIR already open in pane $_b"; return 0; fi
  tmux split-window -h -d -l 45% -t "$TMUX_PANE" "AWB_DIR=$(q "$AWB_DIR") $(q "$BIN") view"
  echo "board: $AWB_DIR (right of this pane)"
}

# the agent manual: the skill next to the real script (clone), else the installed skill
skill() {
  for f in "$(src_dir)/skills/awb-workbench/SKILL.md" \
           "${AWB_SKILL_DIR:-$HOME/.claude/skills}/awb-workbench/SKILL.md"; do
    [ -f "$f" ] && { cat "$f"; return 0; }
  done
  echo "manual: https://github.com/cklxx/awb/blob/main/skills/awb-workbench/SKILL.md"
  echo "install it: curl -fsSL https://raw.githubusercontent.com/cklxx/awb/main/install.sh | sh"
}

agent_panes() {
  # a torn (half-appended) line is skipped, as in events_json
  { [ -s "$EV" ] && jq -R -r 'fromjson? | select(.t=="start" and (.pane // "") != "") | "\(.id) \(.pane)"' "$EV"
    [ -s "$AWB_DIR/panes" ] && awk 'NF >= 2 {print $1, $2}' "$AWB_DIR/panes"; } \
  | awk '{ p[$1] = $2; if (!($1 in o)) o[$1] = NR } END { for (i in p) print o[i], i, p[i] }' \
  | sort -n | cut -d' ' -f2- \
  | M=$(tm list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id}' 2>/dev/null || true) \
    awk 'BEGIN { n = split(ENVIRON["M"], L, "\n"); for (i = 1; i <= n; i++) { split(L[i], f, " "); id[f[1]] = f[2] } }
         { print $1, (($2 in id) ? id[$2] : $2) }'
  # ponytail: session:window.pane targets resolve to pane ids (%N), which tell, peers and the
  # session registry use; other target forms (window names) pass through unresolved
}
agent_pane() { agent_panes | awk -v i="$1" '$1 == i {print $2}'; }
# an event for an id never started is dropped by the fold; a typo'd id must not pass silently
need_agent() {
  init_dir
  { [ -s "$EV" ] && grep -F "\"id\":\"$1\"" "$EV" | grep -qF '"t":"start"'; } \
    || { [ -s "$AWB_DIR/panes" ] && awk -v i="$1" '$1 == i {f = 1} END {exit !f}' "$AWB_DIR/panes"; } \
    || die "unknown agent: $1 (a worker registers with $PROG run, tui or start; the main agent needs no id: $PROG task ID STATE TEXT, $PROG goal, $PROG news)"
}

# type a message into an agent's TUI (claude, codex, any): a named buffer, then Enter.
# Claude queues it if a turn is running. Plain send-keys Enter does not submit in claude.
# a run agent back at a plain shell prompt is a command line, not an agent TUI: a rejected
# check must not type at it (foreground: sh/bash/zsh/fish)
shell_pane() {
  case $(tm display-message -p -t "$1" '#{pane_current_command}' 2>/dev/null) in
    sh|bash|zsh|fish) return 0 ;; *) return 1 ;;
  esac
}
tell() {
  [ $# -ge 2 ] || die "usage: $PROG tell ID MESSAGE"
  _id=$1; shift; init_dir
  _msg=$*
  _p=$(agent_pane "$_id")
  [ -n "$_p" ] && tm list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$_p" || die "$_id has no live pane"
  # Typed text + Enter answers a permission dialog (Enter picks the highlighted "Yes"), so
  # the registry is read again before every keystroke: a dialog reported before a key is
  # never typed into (model/tla/AwbWait.tla). One that opens between the read and the key
  # still takes it; no check can close that window.
  _dialog() { [ "$(sessions_json | jq -r --arg i "$_id" '.[$i].status // ""')" = waiting ]; }
  if _dialog; then   # return, not die: check and nudge call tell as a function
    echo "$PROG: $_id is waiting on a permission dialog; answer it in pane $_p, awb will not type into it" >&2
    return 1
  fi
  # one tell per pane at a time, each with its own buffer: concurrent tells merged or lost
  # messages otherwise (model/tla/AwbTell.tla)
  lock "tell-$_p"
  printf '%s' "$_msg" | tm load-buffer -b "awb-tell-$$" -
  tm paste-buffer -p -d -b "awb-tell-$$" -t "$_p"
  # Confirm the paste actually submitted. A TUI can keep it in the input box
  # after one Enter: Claude leaves the text (or a collapsed "[Pasted text #N
  # +K lines]" placeholder) on the PROMPT line, with a divider and a ⏵⏵ footer
  # below it -- so the input is NOT the last screen line. We therefore inspect
  # the last line that begins with a prompt (❯ Claude / > codex/shell); if
  # absent, fall back to the last non-empty line. capture -J joins wrapped
  # lines so a long paste is read as one prompt line. That prompt line still
  # showing the pasted tail or a collapsed-paste placeholder = unsubmitted ->
  # re-send Enter, up to AWB_TELL_MAX_ENTER. A submitted command moves off it
  # (echoed command runs -> output / empty prompt), so shells are not retried.
  _probe=$(printf '%s' "$_msg" | jq -Rr '.[-60:]')  # char-safe tail; UTF-8 safe
  _try=1; _max=${AWB_TELL_MAX_ENTER:-2}
  # capture the prompt/input line: last line starting with ❯ or >, else last non-empty
  _inputline() {
    tm capture-pane -J -p -t "$_p" 2>/dev/null       | awk 'NF {l=$0; if ($0 ~ /^[[:space:]]*(❯|>)/) p=$0} END{ if (p != "") print p; else print l }'
  }
  _unsubmitted() { # $1 = input line -> 0 if it still holds the unsubmitted paste
    case "$1" in
      *"[Pasted text #"*) return 0 ;;
      *"$_probe"*) return 0 ;;
      *) return 1 ;;
    esac
  }
  # every Enter re-reads the registry first (model/tla/AwbWait.tla, MaxEnter = 2)
  _enter() {
    if _dialog; then
      echo "$PROG: $_id opened a permission dialog mid-tell; text left unsent in pane $_p" >&2
      return 1
    fi
    tm send-keys -t "$_p" Enter
  }
  sleep ${AWB_TELL_SETTLE:-0.5}
  _enter || { unlock "tell-$_p"; return 1; }
  while [ "$_try" -lt "$_max" ]; do
    sleep ${AWB_TELL_SETTLE:-0.5}
    _il=$(_inputline)
    if _unsubmitted "$_il"; then _try=$((_try + 1)); _enter || { unlock "tell-$_p"; return 1; }
    else _try=$_max; fi
  done
  _il=$(_inputline)
  if _unsubmitted "$_il"; then
    # return, not die: check/nudge call tell as a function and must keep going
    # (a die here would abort check's logging or skip the rest of a nudge round)
    printf '%s: %s tell not submitted after %s Enter; text still in input box: %s
'       "$PROG" "$_id" "$_max" "$_il" >&2
    unlock "tell-$_p"
    return 1
  fi
  unlock "tell-$_p"
}

# Claude Code sessions of awb agents, read from ~/.claude/sessions (never written):
# {ID: {name, status, waiting, since}}, status busy|idle|waiting|shell. One pass over the
# registry; an entry being rewritten or of a dead pid is skipped. A session belongs to the
# pane whose process it descends from: the registry's tmux field ("awb:@0.%2") names no
# server, and every awb board runs its own server with a session "awb" and panes from %0,
# so matching on it gave one board's agent another board's Claude. Always prints JSON.
sessions_json() {
  _panes=$(tm list-panes -a -F '#{pane_id} #{pane_pid}' 2>/dev/null) || { echo '{}'; return 0; }
  { awk 1 "$HOME"/.claude/sessions/*.json 2>/dev/null || true; } | jq -Rnc \
    --arg ag "$(agent_panes)" --arg panes "$_panes" --arg ps "$(ps -Ao pid=,ppid=)" '
    ($ps | split("\n") | map([splits(" +")] | map(select(. != "")) | select(length == 2)
       | {key:.[0], value:.[1]}) | from_entries) as $pp
    | def up($p; $n): if $n == 0 or $p == null or $p == "0" or $p == "1" then empty else $p, up($pp[$p]; $n - 1) end;
    [inputs | fromjson? | select(type == "object" and $pp["\(.pid)"] != null)] as $reg
    | ($panes | split("\n") | map(select(. != "") | split(" ") | {key:.[0], value:.[1]}) | from_entries) as $pid
    | [ $ag | split("\n")[] | select(. != "") | split(" ") | .[0] as $id | ($pid[.[1]] // null) as $root
        | select($root != null)
        | ([$reg[] | select(any(up("\(.pid)"; 32); . == $root))] | max_by(.startedAt // 0)) as $r
        | select($r != null)
        | {key:$id, value:{name:$r.name, status:$r.status, waiting:($r.waitingFor // ""),
                           since:((($r.statusUpdatedAt // 0) / 1000) | floor)}} ]
    | from_entries' 2>/dev/null || echo '{}'
}

# "ID MINUTES" for running agents that reported nothing for AWB_STALE seconds
silent_min() {
  now=$(date +%s)
  { [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s -r --argjson now "$now" --argjson stale "${AWB_STALE:-600}" '
    rtrimstr("\n") | if . == "" then [] else split("\n") | map(fromjson? | select(type == "object")) end
    | reduce .[] as $e ({};
        if $e.id == null or $e.t == "nudge" then .
        elif $e.t == "status" then .[$e.id].last = $e.ep | .[$e.id].st = $e.status
        elif $e.t == "now" then .[$e.id].last = $e.ep | .[$e.id].st = (if .[$e.id].st == "done" then "running" else (.[$e.id].st // "running") end)
        elif ($e.t | IN("start","done")) then .[$e.id].last = $e.ep | .[$e.id].st = (.[$e.id].st // "running")
        else . end)
    | to_entries[] | select(.value.st == "running" and $now - .value.last >= $stale)
    | "\(.key) \((($now - .value.last) / 60) | floor)"'
}

# every agent, one line: ID PANE SESSION STATUS [#KEY] [silent MINm]. SESSION is the Claude
# session a main Claude agent messages with SendMessage(to: SESSION), - if none; STATUS is
# busy|idle|waiting|shell, not-claude, gone, or - for an agent without a pane; #KEY its open
# task (awb send); silent when running with no report for AWB_STALE seconds and no Claude
# session (a live session reports itself, the board's rule too). It answers, in
# one command, what the main agent needs after a restart (it replaced stale and pending).
peers() {
  init_dir
  _s=$(sessions_json); _l=$(tm list-panes -a -F '#{pane_id}' 2>/dev/null || true); _ap=$(agent_panes); _q=$(silent_min)
  _k=$(open_keys)
  { printf '%s\n' "$_ap" | cut -d' ' -f1; [ -s "$EV" ] && jq -R -r 'fromjson? | select(.t == "start") | .id' "$EV"; } \
  | awk 'NF && !s[$0]++' | while read -r id; do
      pane=$(printf '%s\n' "$_ap" | awk -v i="$id" '$1 == i {print $2}')
      if [ -z "$pane" ]; then l="$id - - -"
      elif ! printf '%s\n' "$_l" | grep -Fxq "$pane"; then l="$id $pane - gone"
      else l=$(printf '%s' "$_s" | jq -r --arg i "$id" --arg p "$pane" \
               '.[$i] | if . then "\($i) \($p) \(.name) \(.status)" else "\($i) \($p) - not-claude" end'); fi
      k=$(printf '%s\n' "$_k" | awk -v i="$id" '$1 == i {print $2}'); [ -z "$k" ] || l="$l #$k"
      m=$(printf '%s\n' "$_q" | awk -v i="$id" '$1 == i {print $2}')
      [ -z "$m" ] || [ "$(printf '%s' "$l" | cut -d' ' -f3)" != - ] || l="$l silent ${m}m"
      echo "$l"
    done
}

# one acceptance step for the board: step NAME run|ok|fail [NOTE]
step() {
  append '{t:"chk",time:$time,ep:$ep,id:$id,run:$run,what:$what,step:$s,state:$st,note:$n}' \
    --arg id "$CHK_ID" --arg run "$CHK_RUN" --arg what "$CHK_WHAT" --arg s "$1" --arg st "$2" --arg n "${3:-}"
}

# run a step: stage NAME CMD... ; its output goes to the check log
stage() {
  _n=$1; shift; step "$_n" run
  if "$@"; then step "$_n" ok; else step "$_n" fail "$(tail -1 "$CHK_LOG" | cut -c1-80)"; return 1; fi
}

# acceptance gate: the check the main agent chose decides done, not the agent's claim
check() {
  _u="usage: $PROG check ID [--expect REGEX] -- CMD...  (a Lean 4 gate: -- model/accept.sh DIR [ACCEPT.lean])"
  [ $# -ge 1 ] || die "$_u"
  id=$1; shift; _exp=
  if [ "${1:-}" = --expect ]; then [ $# -ge 2 ] || die "$_u"; _exp=$2; shift 2; fi
  [ $# -ge 2 ] && [ "$1" = -- ] || die "$_u"
  shift; need_agent "$id"
  what=$*; set -- stage cmd "$@"
  init_dir
  lock "gate-$id"     # one check or pr per agent at a time (model/tla/AwbCheck.tla)
  ms=$(open_ms "$id")
  CHK_ID=$id CHK_RUN=$(date +%s)$$ CHK_WHAT=$what CHK_LOG=$AWB_DIR/check-$id.log
  export CHK_ID CHK_RUN CHK_WHAT CHK_LOG
  rc=0; "$@" >"$CHK_LOG" 2>&1 || rc=$?
  # exit 0 alone is weak: a pipe, tail or remote shell can drop the real status (Meshy: zsh on
  # the far side had no PIPESTATUS, and "3 failed, 4 passed" exited 0). With --expect a line
  # of the output must match too; a bad regex rejects
  if [ "$rc" = 0 ] && [ -n "$_exp" ] \
     && ! jq -Rne --arg re "$_exp" 'any(inputs; test($re))' <"$CHK_LOG" >/dev/null 2>&1; then
    rc=98; echo "expect: no output line matches $_exp" >> "$CHK_LOG"
  fi
  # a pass verifies the milestone it started on; if the agent moved on meanwhile, it is stale
  if [ "$rc" = 0 ] && [ "$(open_ms "$id")" != "$ms" ]; then
    rc=97; echo "stale: milestone changed during the check (was: ${ms#* }); re-run the check" >> "$CHK_LOG"
  fi
  if [ "$rc" = 0 ]; then
    append '{t:"done",time:$time,ep:$ep,id:$id,text:null,verified:true}' --arg id "$id"
    echo "accepted: $what"
  else
    why=$(grep -v '^[[:space:]]*$' "$CHK_LOG" | tail -1 | cut -c1-120)
    [ -n "$why" ] || why="exit $rc"
    append '{t:"status",time:$time,ep:$ep,id:$id,status:"failed",reason:$r,gate:true}' \
      --arg id "$id" --arg r "验收未过($what): $why"
    # tell the agent, unless the agent ran the check itself and already sees the output;
    # a run agent back at a plain shell prompt is a command line, not an agent TUI
    if [ "${AWB_NOTIFY:-1}" = 1 ] && [ "$(agent_pane "$id")" != "${TMUX_PANE:-}" ] \
       && ! shell_pane "$(agent_pane "$id")"; then
      ( tell "${id}" "awb 验收未过（${what}）：${why}。完整日志：${CHK_LOG}。修复后重新验收：awb check ${id} ..." ) 2>/dev/null \
        && echo "notified $id" || true
    fi
    tail -40 "$CHK_LOG"; echo "rejected: $what (full log: $CHK_LOG)"; return 1
  fi
}

_enter() {
  [ -n "${AWB_AGENT_ID:-}" ] || die "_enter: AWB_AGENT_ID unset"
  append '{t:"start",time:$time,ep:$ep,id:$id,name:$name,kind:$kind,pane:$pane,group:$group}' \
    --arg id "$AWB_AGENT_ID" --arg name "${AWB_AGENT_NAME:-$AWB_AGENT_ID}" \
    --arg kind "${AWB_AGENT_KIND:-agent}" --arg pane "${TMUX_PANE:-}" \
    --arg group "${AWB_GROUP:-default}"
}

_leave() {
  code=${1:-0}
  if [ "$code" = 0 ]; then
    append '{t:"status",time:$time,ep:$ep,id:env.AWB_AGENT_ID,status:"done",reason:""}'
  else
    append '{t:"status",time:$time,ep:$ep,id:env.AWB_AGENT_ID,status:"failed",reason:$r}' \
      --arg r "exit $code"
  fi
}

usage() {
  cat <<EOF
$PROG $VERSION — tmux agent workbench (events in .awb/events.jsonl)
Agents: read the operating manual with '$PROG skill' before driving the board.

One unit of work, the task. You talk to one Claude (the main agent); it keeps the board:
  $PROG up                          the board: beside this pane inside tmux, else its own session
  $PROG goal TEXT                   the goal; its first line is the title
  $PROG tui [-g GROUP] ID NAME      a Claude worker; prints its session name when ready
                                    (AWB_TUI_CMD, default claude-db if on PATH else claude)
  $PROG send [--under PARENT] ID TASK
                                    a task for worker ID, a node of the task tree; prints the
                                    message: SendMessage(to: <session>, message: it, notify_when_idle: true)
  $PROG send ID TASKID [TEXT]       the planned task TASKID, sent as it is (its id is the key)
  $PROG reply ID KEY [RESULT]       the reply "[awb ID#KEY] ..." closes the task, with its result
  $PROG idle ID                     on an idle notice: prints an ask once, then marks the task blocked
  $PROG fail ID REASON              the worker exited: its open task is lost; tui restarts it, send again
  $PROG task ID STATE [TEXT] [PARENT] [OWNER]
                                    plan the tree: STATE todo|wip|review|blocked|done|drop|ask
                                    (ask = a decision for the owner); re-issue to update
  $PROG block ID REASON / unblock ID  the worker waits on something (#N: a PR or an issue) / not any more
  $PROG check ID -- CMD...          acceptance: CMD exit 0 verifies the worker's work (⊢), else ✗
  $PROG check ID --expect RE -- CMD  also a line of the output must match RE (jq regex)
                                    (Lean 4: -- model/accept.sh DIR [ACCEPT.lean])
  $PROG pr ID [gh args...] -- CMD...  run the acceptance here, then push and open a PR on a pass
  $PROG merge PR [--watch]          merge only when the newest verdict on the current head approves
                                    and required checks ran green (AWB_APPROVE_RE, AWB_REQUIRE_CHECKS,
                                    AWB_MIN_CHECKS); --watch polls until then (AWB_MERGE_POLL/POLLS)
  $PROG metric [--at EPOCH] [--step N] [--by EPOCH] [--ref] NAME VALUE TARGET [NOTE]
                                    a reading of the goal's number; --by: deadline; --ref: a
                                    baseline series drawn by step beside it
  $PROG news [--key KEY] TEXT       one progress line; one KEY = one fact, the latest shows

Workers that are not Claude sessions report themselves (now/done not while a sent task is open):
  $PROG run [-g GROUP] ID NAME -- CMD...  a command in a pane; exit 0 -> done, else failed
  $PROG start ID NAME [KIND] [GROUP]  register an agent without a pane (a subagent, a remote)
  $PROG now ID MILESTONE / done ID [TEXT] / finish ID [NOTE]
                                    start / end a milestone / end it and the agent (finish also
                                    closes an open sent task, with no result)

Coordination and reading:
  $PROG peers                       every agent: ID PANE SESSION STATUS [#KEY] [silent MINm]
  $PROG tell ID MESSAGE             type into the agent's pane (claude, codex, ...) and press Enter
  $PROG nudge [--once]              remind silent agents (an open board does it; AWB_NUDGE=0 off)
  $PROG hold [RES OWNER [NOTE]] / release RES [OWNER]
                                    one holder per shared resource (a GPU, a host); no args: list
  $PROG view [--once | --json]      the board live / drawn once / as JSON
  $PROG replay [STEP]               anomalies over the log's history, then the core metrics
  $PROG down | reset                end this board's session | clear the log (keeps a .bak)
  $PROG skill | version | selftest
  AWB_STALE=SECS nudge after (600); AWB_SILENT=SECS silence is an anomaly after (3600).
  Several boards: one .awb per project directory (made by '$PROG up'), or \$AWB_DIR. Without
  AWB_DIR a command needs ./.awb; a write says which board it went to (stderr).
EOF
}

selftest() {
  t=$(mktemp -d)
  S=awbselftest$$
  cleanup() { tmux -L "$S" kill-server 2>/dev/null || true; rm -rf "$t"; }
  trap cleanup EXIT
  export AWB_DIR=$t AWB_COLS=160 AWB_ROWS=200 AWB_NUDGE=0; EV=$t/events.jsonl
  # never the user's Lark group: a test board's watch loop would mirror itself there. A
  # guard lark-cli first on PATH records any call that escapes the fakes below.
  XDG_CONFIG_HOME=$t/xdg-none; export XDG_CONFIG_HOME
  # run from a worker pane, the selftest inherits its board's tmux; it must reach none of it
  unset AWB_TMUX_SOCKET AWB_TMUX_FOR TMUX TMUX_PANE
  mkdir -p "$t/guard"; printf '#!/bin/sh\necho "$*" >> %s/guard/calls\nexit 1\n' "$t" > "$t/guard/lark-cli"
  chmod +x "$t/guard/lark-cli"; PATH=$t/guard:$PATH; export PATH

  ( cd "$t" && AWB_DIR=help-probe "$BIN" up --help >/dev/null ) || die "selftest: up --help failed"
  [ ! -e "$t/help-probe" ] || die "selftest: up --help created AWB_DIR"
  ( cd "$t" && AWB_DIR=help-probe "$BIN" --help >/dev/null ) || die "selftest: --help failed"
  [ ! -e "$t/help-probe" ] || die "selftest: --help ran a command (created AWB_DIR)"
  # with the Lean model built, the board takes status from it, not from the jq fold
  lm=$t/lean; mkdir -p "$lm"; printf '#!/bin/sh\n[ "$1" = fold ] && echo "l1 failed false 1 0 0"\nexit 0\n' > "$lm/model"
  chmod +x "$lm/model"; AWB_DIR=$lm "$BIN" start l1 lagent
  AWB_DIR=$lm AWB_MODEL=$lm/model "$BIN" view --json | jq -e '.need | any(.kind == "fail" and .id == "l1")' >/dev/null \
    || die "selftest: the board did not take the status of the proven fold"
  # a typo is an error, never an event the fold drops or a title (own log)
  ud=$t/usage; ub() { AWB_DIR=$ud "$BIN" "$@"; }
  [ "$(ub bogus 2>&1 | wc -l | tr -d ' ')" = 1 ] || die "selftest: an unknown command printed more than one line"
  ! ub now ghost "x" 2>/dev/null || die "selftest: now accepted an agent never started"
  ! ub check ghost -- true 2>/dev/null || die "selftest: check accepted an agent never started"
  ! ub task t3 wip "x" nope 2>/dev/null || die "selftest: task accepted a parent that does not exist"
  ! ub goal --nope x 2>/dev/null || die "selftest: goal took an unknown option as its text"
  ub start gone gone; printf 'gone %%9999999\n' >> "$ud/panes"
  ub check gone -- false 2>/dev/null | grep -q '^rejected: false' || die "selftest: a rejected check of a dead pane printed no verdict"
  ub reset | grep -q 'cleared; the old log is' && [ ! -s "$ud/events.jsonl" ] && ls "$ud"/events.jsonl.*.bak >/dev/null \
    || die "selftest: reset kept no copy of the log"
  "$BIN" goal "SHIP THE WORKBENCH"
  "$BIN" start a1 claude agent backend
  "$BIN" now a1 "wire event log"
  sleep 1
  "$BIN" done a1
  "$BIN" now a1 "render board"
  "$BIN" start a2 codex agent frontend
  "$BIN" block a2 "waiting on review"
  "$BIN" task r todo root
  "$BIN" task l1 done leaf r
  "$BIN" task l0 wip open r
  "$BIN" task l0 wip "" r
  "$BIN" task l1 done "" r
  brief=$("$BIN" view --once | sed 's/\x1b\[[0-9;]*m//g')
  "$BIN" render | grep -Fq "SHIP THE WORKBENCH" && "$BIN" snapshot | jq -e .now >/dev/null || die "selftest: the old names render/snapshot stopped working"
  for s in "SHIP THE WORKBENCH" "■ root" "✓ leaf" "◔ open" "1/2"; do
    printf '%s' "$brief" | grep -Fq -- "$s" || die "selftest: brief missing '$s'"
  done
  "$BIN" view --json | jq -e '[.agents[] | [.id, .status, .text, .dn]]
    == [["a2","blocked","等 waiting on review",0], ["a1","running","render board",1]]' >/dev/null \
    || die "selftest: agents in the snapshot: $("$BIN" view --json | jq -c '[.agents[] | [.id, .status, .text, .dn]]')"

  # the brief view answers: how far and moving (metric trend, ETA, last hour), what needs
  # you (above the agents), what each agent does now, what is folded away. Own log, so
  # the assertions below keep their state.
  bd=$t/brief; mkdir -p "$bd"; bb() { AWB_DIR=$bd "$BIN" "$@"; }; bn=$(date +%s)
  bb goal "$(printf 'GOAL-TITLE\nwhat-it-is line')"; bb start w1 worker; bb now w1 "tuning kernel"
  bb start w2 waiter; bb now w2 "x"; bb block w2 "等：review #9"
  bb start w3 idler; bb finish w3 "shipped"
  bb start w5 waiter2; bb now w5 "y"; bb block w5 "等 #9 合入"
  bb task main todo "main line"; for i in 1 2 3 4; do bb task "d$i" done "done-$i" main; done
  bb task o1 wip "open one" main; bb task q1 ask "pick a config"
  { printf '{"t":"task","id":"old","state":"done","text":"ancient root","ep":%s}\n' $((bn - 7200))
    printf '{"t":"metric","name":"tps","value":10,"target":40,"ep":%s}\n' $((bn - 400000))
    printf '{"t":"metric","name":"tps","value":20,"target":40,"ep":%s}\n' $((bn - 200000)); } >> "$bd/events.jsonl"
  bb metric tps 25 40 "live"
  # a backfilled older reading (--at) joins the history without replacing the newest
  bb metric --at $((bn - 500000)) --step 100 tps 5 40
  ! bb metric --at yesterday tps 1 40 2>/dev/null || die "selftest: metric --at accepted a non-epoch"
  # what the brief view shows is asserted on the snapshot it is drawn from; the drawing
  # itself is pinned once, by the fixture test after this block
  bs=$(bb view --json)
  bj() { printf '%s' "$bs" | jq -e "$1" >/dev/null || die "selftest: snapshot: $2"; }
  bj '.title == "GOAL-TITLE" and .about == ["what-it-is line"]' "title is the goal line, about is the rest"
  bj '.headline == "需要你 1 件 · tps 24 小时在涨 · 异常 1"' "headline is a judgement: $(printf '%s' "$bs" | jq -c .headline)"
  bj '[.need[] | [.kind, .text]] == [["ask", "pick a config"]]' "an ask task needs you"
  bj '[.anomalies[].text] == ["#9 卡住 waiter、waiter2"]' "two agents blocked on #9 are one bottleneck"
  bj '[.next[].text] == ["open one"]' "the next open step"
  bj '[.tasks[] | select(.text == "main line") | .folded, (.kids | map(.text))] == [2, ["done-3", "done-4"]]' "done steps fold, the next step leaves the tree"
  bj '.tasks_old == 1 and ([.tasks[].text] | index("ancient root") | not)' "an old finished root folds away"
  bj '.metric.v0 == 5 and .metric.eta != null and .hour.done > 0 and .day.done > 0' "metric trend and movement"
  # agents appear only where they need you or are off: no per-agent rows in the drawn view
  b=$(bb view --once | sed 's/\x1b\[[0-9;]*m//g')
  for s in "tuning kernel" "○ 空闲" "agent  ◔"; do
    ! printf '%s' "$b" | grep -Fq -- "$s" || die "selftest: brief shows '$s'"; done
  bb view --json | jq -e '.metric.value == 25 and ([.metric.history[].value] == [5, 10, 20, 25])
    and ([.metric.history[].x] == [100, null, null, null])' >/dev/null || die "selftest: metric --at/--step history"
  # readings all in one second give no time-to-target estimate
  bd2=$t/brief2; mkdir -p "$bd2"
  for v in 1 2 3; do AWB_DIR=$bd2 "$BIN" metric he $v 30; done
  AWB_DIR=$bd2 "$BIN" view --json | jq -e '.metric.eta == null' >/dev/null || die "selftest: an estimate from readings in one second"
  # a reference series (metric --ref), even written after the metric, is never the metric nor
  # in its trend; it is drawn by step beside it, one point per step (a re-sent step replaces)
  rf=$t/ref; mkdir -p "$rf"; rb() { AWB_DIR=$rf "$BIN" metric "$@"; }
  rb --step 2000 "he 0926" 6 30
  i=1; while [ $i -le 3 ]; do rb --at $((bn - 100 + i)) --step $((i * 2000)) "base 0923" $((i * 3)) 30; i=$((i + 1)); done
  rb --ref --step 4000 "base 0923" 7 30
  AWB_DIR=$rf "$BIN" view --json | jq -e '.metric.name == "he 0926" and .day.metric == null and .metric.since == null
    and .refs == [{name:"base 0923", target:30, history:[{x:2000, value:3}, {x:4000, value:7}, {x:6000, value:9}]}]' >/dev/null \
    || die "selftest: a reference series leaked into the metric: $(AWB_DIR=$rf "$BIN" view --json | jq -c '{m:.metric.name, d:.day.metric, refs}')"
  # replay: the board as of each step, from the log alone. An agent silent for two hours is
  # one silent episode; a board AWB_NOW renders never reads the live registry or panes.
  rd=$t/replay; mkdir -p "$rd"; r0=$((bn - 20000))
  { printf '{"t":"start","time":"x","ep":%s,"id":"q1","name":"quiet"}\n' "$r0"
    printf '{"t":"now","time":"x","ep":%s,"id":"q1","text":"x"}\n' "$r0"
    printf '{"t":"start","time":"x","ep":%s,"id":"q2","name":"busy"}\n' "$r0"
    i=1; while [ $i -le 12 ]; do printf '{"t":"now","time":"x","ep":%s,"id":"q2","text":"t%s"}\n' $((r0 + i * 600)) $i; i=$((i + 1)); done
    printf '{"t":"finish","time":"x","ep":%s,"id":"q1"}\n' $((r0 + 7200)); } > "$rd/events.jsonl"
  rp=$(AWB_DIR=$rd "$BIN" replay 600)
  [ "$(printf '%s\n' "$rp" | grep -c "	silent	quiet ")" = 1 ] || die "selftest: replay did not find one silent episode: $rp"
  ! printf '%s\n' "$rp" | grep -q "	silent	busy " || die "selftest: replay flagged an agent that kept reporting"
  # core metrics: a reply, a finish, a restart (lost), one still open; a task at ask is one 需要你
  kd=$t/core; mkdir -p "$kd"
  { e() { printf '{"t":"%s","time":"x","ep":%s,"id":"%s"%s}\n' "$1" $((r0 + $2)) "$3" "${4-}"; }
    e start 0 k1; e start 0 k2; e start 0 k3; e start 0 k4
    e now 60 k1 ',"key":"a","text":"x"'; e done 660 k1 ',"key":"a"'
    e now 60 k2 ',"key":"b","text":"x"'; e status 900 k2 ',"status":"done"'
    e now 60 k3 ',"key":"c","text":"x"'; e start 1200 k3
    e now 60 k4 ',"key":"d","text":"x"'
    e task 60 q ',"state":"ask","text":"pick"'; e task 2000 q ',"state":"done","text":"pick"'
    e now 3000 k1 ',"text":"y"'; } > "$kd/events.jsonl"
  kp=$(AWB_DIR=$kd "$BIN" replay 600)
  printf '%s\n' "$kp" | grep -Fq "派单 4：回报 1（中位 10分钟，最长 10分钟），finish 收尾未回报 1，丢失 1" \
    || die "selftest: replay core metrics on sent tasks: $kp"
  printf '%s\n' "$kp" | grep -Fq "需要你 1 次：已解决 1" || die "selftest: replay core metrics on 需要你: $kp"
  printf '%s\n' "$kp" | grep -Fq "下属重启 1 次" || die "selftest: replay core metrics on restarts: $kp"
  printf '%s\n' "$kp" | grep -Fq "主控消息（从会话记录观察）：没有记录" || die "selftest: replay says nothing when nothing was observed: $kp"
  AWB_DIR=$rd AWB_NOW=$((r0 + 600)) "$BIN" view --json | jq -e '.clock != "" and (.agents | length) == 2' >/dev/null \
    || die "selftest: AWB_NOW did not render the board as of that time"
  # a task dispatched with awb send shows under 下一步 until its reply closes it
  sd=$t/sent; mkdir -p "$sd"; sn() { AWB_DIR=$sd "$BIN" "$@"; }
  sn start d1 reviewer >/dev/null; sm=$(sn send d1 "review the manual" 2>/dev/null); sk=$(printf '%s' "$sm" | sed -n '1s/^\[awb d1#\([0-9]*\)\].*/\1/p')
  # the worker's own stage report does not touch its sent task: it is refused
  ! sn now d1 "reading" 2>/dev/null || die "selftest: a worker's own now was taken while its sent task is open"
  sn peers | grep -Eq "^d1 - - - #$sk\$" || die "selftest: peers does not show the open task: $(sn peers)"
  [ "$(AWB_DIR=$sd AWB_STALE=0 "$BIN" peers)" = "d1 - - - #$sk silent 0m" ] \
    || die "selftest: peers does not show a silent agent: $(AWB_DIR=$sd AWB_STALE=0 "$BIN" peers)"
  sn view --json | jq -e '[.next[].text] == ["reviewer：review the manual"]' >/dev/null || die "selftest: a dispatched task is not under 下一步"
  sn reply d1 "$sk" "3 findings" >/dev/null
  sn view --json | jq -e '.next == [] and ([.tasks[] | select(.text == "review the manual" and .d == 1)] | length == 1)' >/dev/null \
    || die "selftest: a replied task is not a done node of the task tree: $(sn view --json | jq -c '.tasks')"
  # a worker that exited (fail) and was started again takes a new task: the old one is closed
  sn send d1 "second" >/dev/null; sn fail d1 "exited"; sn start d1 reviewer >/dev/null
  sn send d1 "third" >/dev/null || die "selftest: a restarted worker kept its lost task open"
  sn view --json | jq -e '[.next[].text] == ["reviewer：third"] and ([.tasks[].text] | index("second") | not)' >/dev/null \
    || die "selftest: a lost task still on the board"
  # a task sent under a parent is a step of that line
  sn reply d1 "$(sn peers | sed -n 's/.*#\([0-9]*\).*/\1/p')" "ok" >/dev/null
  sn task line todo "main line" >/dev/null; sn send --under line d1 "step A" >/dev/null
  sn view --json | jq -e '[.tasks[] | select(.text == "main line") | .d, .t] == [0, 1] and [.next[].text] == ["reviewer：step A"]' >/dev/null \
    || die "selftest: a task sent under a parent is not a step of its line: $(sn view --json | jq -c '{tasks, next}')"
  # a planned task sent by its id is that task: its id is the key, its text and parent stay
  sn reply d1 "$(sn peers | sed -n 's/.*#\([0-9]*\).*/\1/p')" "ok" >/dev/null
  sn task s2 todo "step B" line >/dev/null
  [ "$(sn send d1 s2 2>/dev/null | head -1)" = "[awb d1#s2] step B" ] || die "selftest: a planned task was not sent by its id"
  sn view --json | jq -e '[.next[].text] == ["reviewer：step B"] and (.tasks[] | select(.id == "line") | .t) == 2
      and ([.. | objects | select(.text? == "s2")] | length) == 0' >/dev/null \
    || die "selftest: a planned task sent by its id is not that task: $(sn view --json | jq -c '{tasks, next}')"
  sn reply d1 s2 "done B" >/dev/null || die "selftest: the reply to a planned task was refused"
  # a sent task whose key repeats a dropped one is a new task, not the dropped one revived
  printf '{"t":"task","ep":1,"id":"k9","state":"drop","text":"old lost","parent":"","owner":"d1"}\n{"t":"now","ep":2,"id":"d1","text":"fresh","key":"k9"}\n' >> "$sd/events.jsonl"
  sn view --json | jq -e '[.. | objects | select(.text? == "old lost")] == [] and [.next[].text] == ["reviewer：fresh"]' >/dev/null \
    || die "selftest: a repeated key revived a dropped task: $(sn view --json | jq -c '{tasks, next}')"
  # news: lines with one key are one fact, the latest shows; lines without a key all show
  bd4=$t/brief4; mkdir -p "$bd4"; nb() { AWB_DIR=$bd4 "$BIN" news "$@"; }
  nb "no key"; nb --key val@15000 "feed: val 1.888"; nb "other"; nb --key val@15000 "val 1.888, grad ok"; nb --key ck "saved"
  [ "$(AWB_DIR=$bd4 "$BIN" view --json | jq -c '[.news[].text]')" = '["no key","other","val 1.888, grad ok","saved"]' ] \
    || die "selftest: news with one key not shown once: $(AWB_DIR=$bd4 "$BIN" view --json | jq -c '[.news[].text]')"
  # an estimate past the deadline (--by, given once) is replaced by "misses it"; a far deadline keeps it
  bd3=$t/brief3; mkdir -p "$bd3"
  AWB_DIR=$bd3 "$BIN" metric --at $((bn - 86400)) --by $((bn + 3600)) he 1 30
  AWB_DIR=$bd3 "$BIN" metric he 2 30
  AWB_DIR=$bd3 "$BIN" view --json | jq -e '.metric.eta == null and .metric.late' >/dev/null \
    || die "selftest: an estimate past the deadline shown"
  AWB_DIR=$bd3 "$BIN" view --json | jq -e '.headline | contains("截止前达不到")' >/dev/null || die "selftest: a missed deadline not in the headline"
  AWB_DIR=$bd3 "$BIN" metric --by $((bn + 86400 * 400)) he 2 30
  AWB_DIR=$bd3 "$BIN" view --json | jq -e '.metric.eta != null and (.metric.late | not)' >/dev/null \
    || die "selftest: an estimate inside the deadline hidden"
  ! AWB_DIR=$bd3 "$BIN" metric --by soon he 2 30 2>/dev/null || die "selftest: metric --by accepted a non-epoch"
  # an estimate counts from the latest reading, and a reading older than AWB_METRIC_STALE gives
  # none: a day-old "30 minutes to target" once sat on the card as if it were current
  bd5=$t/brief5; mkdir -p "$bd5"; n5=$(date +%s)
  AWB_DIR=$bd5 "$BIN" metric --at $((n5 - 1200)) m 10 40; AWB_DIR=$bd5 "$BIN" metric --at $((n5 - 600)) m 20 40
  AWB_DIR=$bd5 "$BIN" view --json | jq -e '.metric.eta > 540 and .metric.eta < 660 and (.metric.stale | not)' >/dev/null \
    || die "selftest: the estimate does not count from the latest reading: $(AWB_DIR=$bd5 "$BIN" view --json | jq -c .metric.eta)"
  bd6=$t/brief6; mkdir -p "$bd6"
  AWB_DIR=$bd6 "$BIN" metric --at $((n5 - 108000)) m 10 40; AWB_DIR=$bd6 "$BIN" metric --at $((n5 - 25200)) m 20 40
  AWB_DIR=$bd6 "$BIN" view --json | jq -e '.metric.eta == null and .metric.stale' >/dev/null || die "selftest: an estimate from a day-old reading"
  # an open task root nobody touched for AWB_TASK_STALE says so; a fresh one does not
  printf '{"t":"task","time":"00:00:00","ep":%s,"id":"old","state":"wip","text":"old root","parent":"","owner":""}\n' $((n5 - 30000)) >> "$bd6/events.jsonl"
  AWB_DIR=$bd6 "$BIN" task new wip "new root"
  AWB_DIR=$bd6 "$BIN" view --json | jq -e '([.tasks[] | select(.text == "old root") | .quiet] == [30000] or ([.tasks[] | select(.text == "old root") | .quiet][0] >= 30000))
    and ([.tasks[] | select(.text == "new root") | .quiet] == [null])' >/dev/null || die "selftest: task root quiet time wrong"
  # a shared resource has one holder: another owner is refused, the holder renews, release
  # frees it; the fold never sees it, and a holder quiet for AWB_STALE is an anomaly
  hd=$t/hold; mkdir -p "$hd"; hb() { AWB_DIR=$hd "$BIN" "$@"; }
  hb start h1 perf1 >/dev/null; hb hold gpu h1 "bench"
  ! hb hold gpu h2 2>/dev/null || die "selftest: a held resource was taken by another owner"
  hb hold gpu h1 "renew" || die "selftest: the holder could not renew"
  [ "$(hb hold | awk '$1 == "gpu" {print $2}')" = h1 ] || die "selftest: holder lost"
  ! hb release gpu h2 2>/dev/null || die "selftest: a non-holder released the resource"
  [ "$(hb _state)" = "h1 running false - 0 0" ] || die "selftest: hold events reached the fold: $(hb _state)"
  AWB_STALE=0 hb view --json | jq -e '.holds[0].owner == "h1" and any(.anomalies[]; .kind == "hold")' >/dev/null \
    || die "selftest: a quiet holder is not an anomaly"
  ! hb view --once | grep -Fq "gpu" || die "selftest: a resource held by a working agent is on the brief view"
  hb release gpu; [ -z "$(hb hold)" ] || die "selftest: release did not free the resource"
  # the merged-away holder still answers scripts: free = exit 1; an unknown command exits 2
  hb hold gpu h1; [ "$(hb holder gpu | cut -d' ' -f1)" = h1 ] || die "selftest: holder alias lost"
  hb release gpu; rc=0; hb holder gpu >/dev/null || rc=$?; [ "$rc" = 1 ] || die "selftest: holder of a free resource exited $rc"
  rc=0; hb nosuchcmd 2>/dev/null || rc=$?; [ "$rc" = 2 ] || die "selftest: unknown command exited $rc, not 2"
  hb view --json | jq -e 'any(.anomalies[]; .kind == "badcmd" and (.text | contains("awb nosuchcmd") and contains("1 次")))' >/dev/null \
    || die "selftest: an unknown command is not on the board: $(hb view --json | jq -c .anomalies)"
  # a near miss names the command meant, on stderr and on the board
  hb holds 2>&1 | grep -Fq "did you mean: awb hold?" || die "selftest: no suggestion for a near-miss command: $(hb holds 2>&1)"
  hb view --json | jq -e 'any(.anomalies[]; .text | contains("awb holds（应为 awb hold）"))' >/dev/null \
    || die "selftest: the suggestion is not on the board: $(hb view --json | jq -c .anomalies)"
  ! hb nosuchcmd 2>&1 | grep -Fq "did you mean" || die "selftest: a far miss got a suggestion"
  # a running board takes a new install of its script (a moved pin) by re-executing itself
  hr=$t/hot; mkdir -p "$hr/b"; cp "$BIN" "$hr/awb"
  HOT_MARK=$t/hotmark AWB_DIR=$hr/b AWB_NUDGE=0 AWB_NUDGE_POLL=1 AWB_INTERVAL=0.2 "$hr/awb" view >/dev/null 2>&1 </dev/null &
  hp=$!; sleep 0.5
  awk 'NR == 2 {print "[ \"${1:-}\" = view ] && echo reloaded >> \"$HOT_MARK\""} 1' "$hr/awb" > "$hr/awb.new" \
    && chmod +x "$hr/awb.new" && mv "$hr/awb.new" "$hr/awb"
  i=0; until [ -s "$t/hotmark" ]; do
    i=$((i + 1)); [ $i -lt 40 ] || { kill $hp; die "selftest: a running board did not take a new install of awb"; }; sleep 0.25; done
  kill $hp; wait $hp 2>/dev/null || true
  AWB_STALE=0 hb view --json | jq -e '(.holds | length) == 0 and (any(.anomalies[]; .kind == "hold") | not)' >/dev/null \
    || die "selftest: a released resource still shown"
  # merge: only the newest verdict naming the current head counts, a conditional or retracted
  # approve does not, and checks that never ran are not green (fake gh replays each PR state)
  mkdir -p "$t/fgh"; printf '#!/bin/sh\ncase "$1 $2" in "pr view") cat %s/fgh/pr.json ;; "pr merge") echo "$*" >> %s/fgh/log ;; esac\n' "$t" "$t" > "$t/fgh/gh"
  chmod +x "$t/fgh/gh"; : > "$t/fgh/log"
  mh=891472afdeadbeef00000000000000000000beef
  mpr() { printf '{"state":"OPEN","headRefOid":"%s","reviews":[],"comments":[%s],"statusCheckRollup":[%s]}' "$mh" "$1" "$2" > "$t/fgh/pr.json"; }
  mc() { printf '{"createdAt":"2026-01-01T0%s:00:00Z","body":"%s"}' "$1" "$2"; }
  mg() { printf '{"name":"gate (%s)","conclusion":"%s"},{"name":"gate (%s2)","conclusion":"%s"}' "$1" "$1" "$1" "$2"; }
  mm() { PATH=$t/fgh:$PATH AWB_DIR=$hd AWB_REQUIRE_CHECKS='^gate' AWB_MIN_CHECKS=2 "$BIN" merge 7 >/dev/null 2>&1; }
  ok='**APPROVE (rev, head 891472af)**'
  mpr "$(mc 1 '**APPROVE (rev, head 891472af) with one doc fix**'),$(mc 2 'REQUEST CHANGES (rev) head 891472af')" "$(mg SUCCESS SUCCESS)"
  ! mm || die "selftest: merge took a retracted approve"
  mpr "$(mc 1 '**APPROVE (rev, head 891472af) with one doc fix**')" "$(mg SUCCESS SUCCESS)"
  ! mm || die "selftest: merge took a conditional approve"
  mpr "$(mc 1 "$ok")" '{"name":"GitGuardian","conclusion":"SUCCESS"}'
  ! mm || die "selftest: merge took checks that never ran as green"
  mpr "$(mc 1 "$ok")" "$(mg SUCCESS "")"
  ! mm || die "selftest: merge did not wait for a pending check"
  mpr "$(mc 1 '**APPROVE (rev, head 1c56633a)**')" "$(mg SUCCESS SUCCESS)"
  ! mm || die "selftest: merge took an approve of an older head"
  [ ! -s "$t/fgh/log" ] || die "selftest: merge called gh pr merge before it was ready"
  mpr "$(mc 1 'REQUEST CHANGES (rev, head 891472af)'),$(mc 2 "$ok")" "$(mg SUCCESS SUCCESS)"
  mm || die "selftest: merge refused an exact approve with green checks"
  grep -qx "pr merge 7 --merge --match-head-commit $mh" "$t/fgh/log" || die "selftest: merge not pinned to the head: $(cat "$t/fgh/log")"
  # the drawing, pinned: a fixed snapshot gives exactly this brief view. A change of wording
  # or layout is made here once; everything else is asserted on the snapshot above.
  fx='{"goal":"G","title":"G","about":["what it is"],"headline":"需要你 1 件 · m 按当前趋势截止前达不到 · 异常 1",
    "quiet":120,"now":0,"clock":"12:00:00","progress":{"d":1,"t":2},"hour":{"done":1},
    "day":{"done":5,"verified":1,"metric":1.5},"verified":{"v":1,"n":3},"running":1,
    "metric":{"name":"m","value":3,"target":10,"note":"n1","frac":0.3,"history":[{"value":1},{"value":3}],
      "v0":1,"since":90000,"eta":null,"late":true,"stale":true,"age":30000},
    "need":[{"kind":"ask","id":"q","name":"","text":"pick one","age":600}],
    "anomalies":[{"kind":"bottleneck","text":"#9 卡住 a、b"}],"next":[{"text":"step two","state":"wip","prog":null}],
    "holds":[],"agents":[],"idle":[],"tasks":[{"text":"root","d":1,"t":2,"folded":0,"quiet":null,
      "kids":[{"text":"step one","state":"done","prog":null}]}],"tasks_old":0,
    "news":[{"text":"n-old","time":"10:00:00"},{"text":"n-new","time":"11:00:00"}],
    "checks":[{"id":"a","name":"alpha","what":"selftest","startEp":1,"ok":false,"fail":true,
      "steps":[{"s":"cmd","state":"fail","el":5,"note":"exit 1"}]}],"violations":[]}'
  got=$(printf '%s' "$fx" | brief_view 80 60 | sed 's/\x1b\[[0-9;]*m//g')
  want=$(cat <<'GOLD'
╭─ G ─────────────────────────────────────────────────────────────────────────
│ what it is
│ ▶ 需要你 1 件 · m 按当前趋势截止前达不到 · 异常 1
│ m 3 / 10 ▕███░░░░░░░▏30%  最新读数 8小时前 · 按当前趋势截止前达不到 ▁▃
│   n1
╰─ 进度 ████████░░░░░░░░ 1/2   12:00:00 · 更新于 2分钟前
   近 1 小时 完成 +1 · 24 小时 完成 +5 m +1.5 · 已核 1/3

需要你（1）
  ? pick one · 已 10分钟

下一步
  ◔ step two

异常（1）
  ! #9 卡住 a、b

进展
  ✓ 11:00 n-new
  ✓ 10:00 n-old

■ root                                                   ██████░░░░░░ 1/2
  └─ ✓ step one                                             

验收
  ✗ alpha      selftest           cmd ✗  5s
    └ exit 1
GOLD
)
  [ "$got" = "$want" ] || { printf '%s\n' "$got" > "$t/brief.got"; diff "$t/brief.got" - <<EOF >&2
$want
EOF
    die "selftest: the brief view of the fixture snapshot changed (got: $t/brief.got)"; }

  # UX-review fixes: no rendered line is wider than the pane in either view
  WDEF=$(sed -n "/^JQ_DEFS='\$/,/^'\$/p" "$BIN" | sed '1d;$d')
  wmax() { jq -Rn "$WDEF"'[inputs | ([explode[] | cw(.)] | add // 0)] | max // 0'; }
  stripansi() { sed 's/\x1b\[[0-9;]*m//g'; }
  wd=$t/width; mkdir -p "$wd"; ww() { AWB_DIR=$wd "$BIN" "$@"; }
  ww start f1 "f1-agent" agent "a-group-name-long-enough-to-overflow-sixty-columns" >/dev/null
  ww now f1 m >/dev/null
  _ep=$(date +%s)
  for j in 1 2; do printf '{"t":"chk","ep":%s,"id":"f1","run":"r1","what":"pytest --with-a-very-long-suite-name --flag","step":"%s","state":"run","note":""}\n' $_ep "a-very-long-step-name-that-overflows-the-pane-width-$j" >> "$wd/events.jsonl"; done
  printf '{"t":"chk","ep":%s,"id":"f1","run":"r1","what":"pytest --with-a-very-long-suite-name --flag","step":"a-very-long-step-name-that-overflows-the-pane-width-2","state":"fail","note":"E assertion failure with a long reason text that also used to overflow the row"}\n' $_ep >> "$wd/events.jsonl"
  AWB_COLS=60 AWB_ROWS=50 ww view --once | stripansi > "$t/w60"
  mx=$(wmax < "$t/w60"); [ "$mx" -le 60 ] || die "selftest: a line wider than 60 ($mx)"
  # in a narrow pane the metric verdict (ETA) survives while start point and sparkline drop
  wn=$t/narrow; mkdir -p "$wn"; nnow=$(date +%s)
  AWB_DIR=$wn "$BIN" goal G >/dev/null
  AWB_DIR=$wn "$BIN" metric --at $((nnow - 1800)) acc 0.5 1 >/dev/null
  AWB_DIR=$wn "$BIN" metric --by $((nnow + 86400)) acc 0.55 1 >/dev/null
  AWB_DIR=$wn AWB_COLS=60 "$BIN" view --once | stripansi > "$t/n60"
  grep -Fq "按均速约" "$t/n60" || die "selftest: the metric ETA is lost at 60 columns"
  ! grep -Fq "起 0.5" "$t/n60" || die "selftest: 60 columns kept the start point instead of the ETA"
  mx=$(wmax < "$t/n60"); [ "$mx" -le 60 ] || die "selftest: metric line overflows at 60 columns ($mx)"
  AWB_DIR=$wn AWB_COLS=120 "$BIN" view --once | stripansi | grep -Fq "起 0.5" || die "selftest: the start point is missing at 120 columns"
  # a short pane shows how many needs/anomalies are hidden
  wh=$t/short; mkdir -p "$wh"; i=1
  while [ $i -le 8 ]; do AWB_DIR=$wh "$BIN" start "f$i" "f$i" >/dev/null; AWB_DIR=$wh "$BIN" now "f$i" "m$i" >/dev/null
    AWB_DIR=$wh "$BIN" fail "f$i" "reason $i" >/dev/null; i=$((i + 1)); done
  AWB_DIR=$wh AWB_COLS=60 AWB_ROWS=12 "$BIN" view --once | stripansi > "$t/sh12"
  grep -Fq "需要你（8）" "$t/sh12" && grep -Eq "还有 [0-9]+ 件" "$t/sh12" && grep -Fq "✗ f1 " "$t/sh12" \
    || die "selftest: a 12-row pane hides needs without a count: $(cat "$t/sh12")"
  [ "$(wc -l < "$t/sh12" | tr -d ' ')" -le 12 ] || die "selftest: 12-row render exceeds the pane height"
  # an empty board shows no stale epoch time and no GOAL placeholder
  we=$t/empty; mkdir -p "$we"
  AWB_DIR=$we "$BIN" view --once | stripansi > "$t/empty.out"
  ! grep -Fq "更新于" "$t/empty.out" || die "selftest: empty board shows an epoch-0 stale time"
  ! grep -Fq "GOAL" "$t/empty.out" || die "selftest: empty board shows the GOAL placeholder"
  AWB_DIR=$we "$BIN" view --json | jq -e '.quiet == 0 and .title == ""' >/dev/null || die "selftest: empty snapshot quiet/title"
  # awb view takes COLS ROWS positionally (the brief view never goes below 12 rows); an
  # empty non-tty stdin with an unreachable pane falls back to 80 columns instead of that width
  AWB_DIR=$wh "$BIN" view --json 2>/dev/null | env -u TMUX -u TMUX_PANE "$BIN" _view 50 13 | stripansi > "$t/v50"
  [ "$(wc -l < "$t/v50" | tr -d ' ')" -eq 13 ] || die "selftest: awb view ignored ROWS"
  mx=$(wmax < "$t/v50"); [ "$mx" -le 50 ] || die "selftest: awb view ignored COLS ($mx > 50)"
  AWB_DIR=$wh "$BIN" view --json 2>/dev/null | env -u AWB_COLS -u AWB_ROWS TMUX=/nonexistent,0,0 TMUX_PANE=%1 "$BIN" _view 2>/dev/null | stripansi > "$t/vfb"
  [ "$(wmax < "$t/vfb")" -gt 10 ] && [ "$(wmax < "$t/vfb")" -le 80 ] \
    || die "selftest: awb view with an unreachable pane did not fall back to 80 columns"

  # follow-up fixes (rest-w3)
  # 1. ages in anomalies use the ago form, never an hms clock
  ag=$t/ages; mkdir -p "$ag"; nnow=$(date +%s)
  printf '{"t":"start","id":"a1","name":"a1","ep":%s}\n{"t":"now","id":"a1","text":"x","ep":%s}\n' $((nnow-12000)) $((nnow-12000)) >> "$ag/events.jsonl"
  AWB_DIR=$ag "$BIN" view --json | jq -e '.anomalies | length > 0
    and all(.text | test("[0-9]+小时") and (test("[0-9]+:[0-9][0-9]:[0-9][0-9]") | not))' >/dev/null \
    || die "selftest: anomaly age is not in ago form: $(AWB_DIR=$ag "$BIN" view --json | jq -c '.anomalies[].text')"
  ! grep -Eq '\) / 10\) 天|floor\) 小时|floor\) 分钟' "$(dirname "$BIN")/awb-lark" \
    || die "selftest: awb-lark ago keeps a space before the unit"
  # 6. a single running step shows its time once (the row total already shows it)
  c1=$t/onecheck; mkdir -p "$c1"; cp0=$(date +%s)
  printf '{"t":"start","id":"c1","name":"c1","ep":%s}\n{"t":"now","id":"c1","text":"m","ep":%s}\n' "$cp0" "$cp0" >> "$c1/events.jsonl"
  printf '{"t":"chk","ep":%s,"id":"c1","run":"r1","what":"w","step":"only-step","state":"run","note":""}\n' "$cp0" >> "$c1/events.jsonl"
  line=$(AWB_DIR=$c1 AWB_COLS=120 "$BIN" view --once | stripansi | grep 'only-step')
  n=$(printf '%s\n' "$line" | grep -oE '([0-9]+:[0-9][0-9](:[0-9][0-9])?)|[0-9]+s' | wc -l | tr -d ' ')
  [ "$n" = "1" ] || die "selftest: the single running step shows its timer $n times"
  # 2. total progress excludes old fully-done roots
  p2=$t/prog; mkdir -p "$p2"; pn=$(date +%s)
  AWB_DIR=$p2 "$BIN" start g1 g1 >/dev/null; AWB_DIR=$p2 "$BIN" now g1 work >/dev/null
  i=1; while [ $i -le 10 ]; do printf '{"t":"task","ep":%s,"id":"p%s","state":"done","text":"t%s","parent":"","owner":""}\n' $((pn-7200)) "$i" "$i" >> "$p2/events.jsonl"; i=$((i+1)); done
  printf '{"t":"task","ep":%s,"id":"po","state":"wip","text":"open","parent":"","owner":""}\n' "$pn" >> "$p2/events.jsonl"
  AWB_DIR=$p2 "$BIN" view --json | jq -e '.progress == {d:0, t:1} and .tasks_old == 10' >/dev/null \
    || die "selftest: total progress counts old fully-done roots"
  # 3. wrap breaks Latin text at a space, not inside a word
  printf '%s' "ab cd" | jq -Rn -c "$WDEF"'[input | wrap(5)[]]' | grep -Fxq '["ab cd"]' \
    || die "selftest: wrap broke a word that fit"
  printf '%s' "abcdef ghijkl" | jq -Rn -c "$WDEF"'[input | wrap(7)[]]' | jq -e '. == ["abcdef","ghijkl"]' >/dev/null \
    || die "selftest: wrap split a Latin word mid-token: $(printf '%s' 'abcdef ghijkl' | jq -Rn -c "$WDEF"'[input | wrap(7)[]]')"
  # 5. a metric delta whose first reading is under 24h old names the real span
  m5=$t/span; mkdir -p "$m5"; mn=$(date +%s)
  AWB_DIR=$m5 "$BIN" goal G >/dev/null
  AWB_DIR=$m5 "$BIN" metric --at $((mn - 39600)) m 1 10 >/dev/null
  AWB_DIR=$m5 "$BIN" metric m 2 10 >/dev/null
  AWB_DIR=$m5 "$BIN" view --json | jq -e '.day.mspan >= 36000 and .day.mspan <= 40000' >/dev/null \
    || die "selftest: the sub-24h metric span is not recorded"
  AWB_DIR=$m5 AWB_COLS=120 "$BIN" view --once | stripansi | grep -Fq "+1/11小时" \
    || die "selftest: the footer does not name the metric delta span"
  AWB_DIR=$m5 AWB="$BIN" "$(dirname "$BIN")/awb-lark" sync --dry-run \
    | jq -e '[.. | .content? // empty | strings] | any(test("\\+1/11小时"))' >/dev/null \
    || die "selftest: the card does not name the metric delta span"

  # single metric indicator under GOAL, render-only (the "#" id keeps it out
  # of the proven fold; `awb _state` below proves no agent is created).
  ! "$BIN" view --once | grep -Fq '▕' || die "selftest: metric bar shown with no metric event"
  "$BIN" metric "tps" 32 40 "V100 target"
  m=$("$BIN" view --once)
  printf '%s' "$m" | grep -Fq 'tps' || die "selftest: metric name not rendered"
  printf '%s' "$m" | grep -Fq '32 / 40' || die "selftest: metric value/target not rendered"
  printf '%s' "$m" | grep -Fq 'V100 target' || die "selftest: metric note not rendered"
  printf '%s' "$m" | grep -Fq '80%' || die "selftest: metric percent wrong"
  # latest metric wins
  "$BIN" metric "qps" 5 10 second-note
  "$BIN" view --once | grep -Fq 'qps' || die "selftest: newer metric not shown"
  ! "$BIN" view --once | grep -Fq 'V100 target' || die "selftest: stale metric still rendered"
  # clamp to 100% and never below 0
  "$BIN" metric over 41 40 x; "$BIN" view --once | grep -Fq '100%' || die "selftest: metric not clamped at 100"
  "$BIN" metric under 3 0 x; "$BIN" view --once | grep -Fq ' 3 / 0' || die "selftest: zero-target metric mishandled"
  # value/target must be finite numbers, not tokens jq can't tonumber
  ! "$BIN" metric bad abc 10 2>/dev/null || die "selftest: non-numeric metric value accepted"
  ! "$BIN" metric bad 1.2.3 10 2>/dev/null || die "selftest: '1.2.3' metric value accepted"
  ! "$BIN" metric bad 10 - 2>/dev/null || die "selftest: '-' metric target accepted"
  ! "$BIN" metric bad NaN 10 2>/dev/null || die "selftest: NaN metric value accepted"
  ! "$BIN" metric bad 10 Infinity 2>/dev/null || die "selftest: Infinity metric target accepted"
  # the fold must ignore an unknown event with NO id (used to index .agents[null]
  # and blank the board; now matches Lean parseLine's `_ => none`). A metric has
  # no id and must neither create an agent nor stop a later event applying.
  printf '%s\n' '{"t":"zzz","ep":900000}' >> "$EV"
  "$BIN" view --once | grep -Fq "SHIP THE WORKBENCH" || die "selftest: unknown no-id event blanked the board"
  _ids=$("$BIN" _state | awk '{print $1}' | sort -u | tr '\n' ' ')
  [ "$_ids" = "a1 a2 " ] || die "selftest: unknown event leaked an agent into the fold (got: $_ids)"
  "$BIN" now a1 "post-unknown-still-works"
  "$BIN" view --json | jq -e 'any(.agents[]; .id == "a1" and .text == "post-unknown-still-works")' >/dev/null \
    || die "selftest: events after an unknown no-id event dropped"
  # verified vs self-reported milestones: a1 has one done, none verified yet
  "$BIN" view --json | jq -e '.verified == {v:0, n:1}' >/dev/null || die "selftest: milestone verified/self-reported count wrong"

  "$BIN" now a1 "gated"
  ! "$BIN" check a1 -- false >/dev/null || die "selftest: failing check accepted"
  "$BIN" _state | grep -q '^a1 failed true ' || die "selftest: rejected check not failed"
  # --expect: exit 0 whose output does not match is rejected, with the reason in the log
  ! "$BIN" check a1 --expect '^[0-9]+ passed' -- sh -c 'echo "== 3 failed, 4 passed =="' >/dev/null \
    || die "selftest: a check whose output missed --expect accepted"
  tail -1 "$AWB_DIR/check-a1.log" | grep -Fq 'expect: no output line matches' || die "selftest: --expect miss not in the log"
  ! "$BIN" check a1 --expect '(' -- true >/dev/null || die "selftest: a bad --expect regex accepted"
  "$BIN" check a1 --expect '^[0-9]+ passed' -- sh -c 'echo "7 passed"' >/dev/null || die "selftest: passing check rejected"
  "$BIN" view --json | jq -e '.verified == {v:1, n:2}' >/dev/null || die "selftest: verified milestone not counted"
  ! "$BIN" pr a2 2>/dev/null || die "selftest: pr opened without an acceptance command"
  # a pass forged in the log does not open a PR: pr runs the acceptance itself
  printf '{"t":"chk","ep":%s,"id":"a2","run":"forged","what":"true","step":"cmd","state":"ok","note":""}\n' "$(date +%s)" >> "$EV"
  ! "$BIN" pr a2 -- false >/dev/null 2>&1 || die "selftest: pr trusted a check pass from the log"
  "$BIN" start v1 late; "$BIN" now v1 "shipped"; "$BIN" done v1; "$BIN" check v1 -- true >/dev/null
  "$BIN" view --json | jq -e '.agents[] | select(.id == "v1") | [.dn, .dv] == [1, 1]' >/dev/null \
    || die "selftest: a late check did not verify the last milestone, or added one"
  # bash 3.2 swallows a following non-ASCII byte into an unbraced variable name: brace them
  ! LC_ALL=C grep -nE '[$][A-Za-z_][A-Za-z0-9_]*[^ -~]' "$BIN" >&2 || die "selftest: unbraced \$var before non-ASCII text"
  # silence: a change to a task the agent owns is its work too
  sq=$t/silent2; mkdir -p "$sq"; o_=$(($(date +%s) - 7200))
