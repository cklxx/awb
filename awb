    SID=s-zz reg idle; ht _observe
    [ "$(jq -sc '[.[] | select(.t == "msg") | .id + " " + .dir + " " + .via]' "$EV")" = '["z1 out main-x"]' ] \
      || die "selftest: a new transcript is not read from its last 24 hours: $(jq -sc '[.[] | select(.t == "msg")]' "$EV")"
    ok_=$("$BIN" send z1 "observed task" 2>/dev/null | sed -n '1s/^\[awb z1#\([0-9]*\)\].*/\1/p')
    { in_ $((no - 1500)) main-x "hello"; out_ $((no - 1400)) "uds:/tmp/cc-socks/$$.sock" "reply"
      in_ $((no - 1100)) main-x "[awb z1#$ok_] observed task"; out_ $((no - 1000)) "main-x [abc123]" "[awb z1#$ok_] done"
      in_ $((no - 900)) main-x "last" | tr -d '\n'; } >> "$tr_"
    ht _observe
    [ "$(jq -sc '[.[] | select(.t == "msg") | .id + " " + .dir]' "$EV")" = '["z1 out","z1 out","z1 in","z1 out","z1 in"]' ] \
      || die "selftest: observed messages: $(jq -sc '[.[] | select(.t == "msg") | .id + " " + .dir]' "$EV")"
    # a keyed reply may be a progress report: it is recorded and the task stays open
    [ "$(open_key z1)" = "$ok_" ] || die "selftest: an observed keyed reply closed the task"
    echo >> "$tr_"; ht _observe; ht _observe
    [ "$(grep -F '"t":"msg"' "$EV" | grep -cF '"dir":"out"')" = 4 ] || die "selftest: a line finished later was read not once"
    rm "$t/obs"; ht _observe
    [ "$(grep -cF '"t":"msg"' "$EV")" = 6 ] || die "selftest: a re-read recorded a message twice"
    # a message sent while the agent was busy: queued, then delivered mid-turn; one message
    q_=$(printf '<cross-session-message from="uds:/tmp/cc-socks/%s.sock" from-name="main-x" from-mode="bypass">\nqueued one\n</cross-session-message>' $$)
    { jq -cn --arg ts "$(ts_ $((no - 800)))" --arg c "$q_" '{type:"queue-operation", operation:"enqueue", timestamp:$ts, content:$c}'
      jq -cn --arg ts "$(ts_ $((no - 790)))" --arg c "$q_" '{type:"attachment", timestamp:$ts, attachment:{type:"queued_command", prompt:$c}}'; } >> "$tr_"
    ht _observe
    [ "$(grep -F '"t":"msg"' "$EV" | grep -cF '"dir":"out"')" = 5 ] || die "selftest: a queued message not counted once: $(grep -F '"t":"msg"' "$EV" | grep -cF '"dir":"out"')"
    # the last message has no reply and the session sits idle past AWB_REPLY_IDLE: an anomaly
    SID=s-zz reg idle "" 700
    ht view --json | jq -e 'any(.anomalies[]; .kind == "noreply") and (.talk[] | select(.id == "z1") | .to_agent == 5 and .from_agent == 2)' >/dev/null \
      || die "selftest: no-reply not on the board: $(ht view --json | jq -c '{a:.anomalies, t:.talk}')"
    SID=s-zz reg busy; ! ht view --json | jq -e 'any(.anomalies[]; .kind == "noreply" or .kind == "replied")' >/dev/null || die "selftest: a busy session flagged as not replying"
    # an open board observes with its nudges off too (AWB_NUDGE=0 is the selftest's setting)
    SID=s-zz reg idle; out_ "$(date +%s)" main-x "[awb z1#$ok_] late reply" >> "$tr_"
    HOME=$t/home AWB_NUDGE_POLL=1 AWB_INTERVAL=0.2 "$BIN" view >/dev/null 2>&1 &
    wp=$!; i=0
    until [ "$(grep -F '"t":"msg"' "$EV" | grep -cF '"dir":"in"')" = 3 ]; do
      i=$((i + 1)); [ $i -lt 40 ] || { kill $wp; die "selftest: a board with AWB_NUDGE=0 did not observe"; }; sleep 0.25; done
    kill $wp; wait $wp 2>/dev/null || true
    ht view --json | jq -e '.observe.files >= 1 and .observe.last > 0' >/dev/null || die "selftest: the last observation round not in the snapshot"
    # a keyed reply after the send, then an idle session: shown until the main agent records it;
    # a message from the main agent after that reply is not a second anomaly
    in_ "$(date +%s)" main-x "got it" >> "$tr_"; ht _observe
    ! AWB_REPLY_IDLE=0 ht view --json | jq -e 'any(.anomalies[]; .kind == "noreply")' >/dev/null \
      || die "selftest: noreply beside replied for the same keyed reply"
    AWB_REPLY_IDLE=0 ht view --json | jq -e --arg k "$ok_" 'any(.anomalies[]; .kind == "replied" and (.text | contains("awb reply z1 " + $k)))' >/dev/null \
      || die "selftest: a keyed reply left open with the session idle is not on the board: $(AWB_REPLY_IDLE=0 ht view --json | jq -c '.anomalies')"
    "$BIN" reply z1 "$ok_" done >/dev/null
    ! AWB_REPLY_IDLE=0 ht view --json | jq -e 'any(.anomalies[]; .kind == "replied")' >/dev/null || die "selftest: a recorded reply still shown"
    # a notice to a sent worker with no open task needs no reply
    in_ "$(date +%s)" main-x "thanks, stand by" >> "$tr_"; ht _observe
    ! AWB_REPLY_IDLE=0 ht view --json | jq -e 'any(.anomalies[]; .kind == "noreply")' >/dev/null \
      || die "selftest: a notice to a worker with no open task flagged as not replied"
    reg idle
    rm -f "$t/home/.claude/sessions/2.json"
    # a pane given as session:window.pane in .awb/panes resolves to the same session
    printf 'zt %s\n' "$(tmux -L "$S" display-message -p -t "$zp" '#{session_name}:#{window_index}.#{pane_index}')" >> "$t/panes"
    [ "$(ht peers | grep '^zt ')" = "zt $zp zz-1 idle" ] || die "selftest: a session:window.pane target was not resolved"
    unset AWB_TMUX_SOCKET

    # no-code-change detection drives the REAL freeze_once, not just render:
    # (a) a milestone done without finish keeps the agent running+fingerprinted;
    # (b) one dead pane must not abort the poll and drop the live agent's row.
    fz=$t/fz; gf=$t/gitrepo; mkdir -p "$fz" "$gf"
    ( cd "$gf" && git init -q && echo hi > f && git add -A \
        && git -c user.email=a@b -c user.name=a commit -qm init )
    fsock=$(tmux -L "$S" display-message -p '#{socket_path}')
    pl=$(tmux -L "$S" new-window -d -P -F '#{pane_id}' "$SHELL")
    pd=$(tmux -L "$S" new-window -d -P -F '#{pane_id}' "$SHELL")
    tmux -L "$S" kill-pane -t "$pd"; sleep 0.5
    AWB_DIR=$fz "$BIN" start zl liveagent >/dev/null
    AWB_DIR=$fz "$BIN" now zl "t1" >/dev/null
    AWB_DIR=$fz "$BIN" done zl >/dev/null          # milestone done, NO finish
    AWB_DIR=$fz "$BIN" start zd deadagent >/dev/null
    AWB_DIR=$fz "$BIN" now zd "t1" >/dev/null
    printf 'zl %s %s\nzd %s %s\n' "$pl" "$gf" "$pd" "$gf" > "$fz/panes"
    AWB_DIR=$fz AWB_TMUX_SOCKET=$fsock AWB_FROZEN=0 "$BIN" nudge --once
    grep -q '^zl ' "$fz/diffs" || die "selftest: milestone done agent lost from freeze scan"
    grep -q '^zd ' "$fz/diffs" || die "selftest: dead-pane agent row not written"
    # a board with no panes file (agents started by tui/run record their pane in the start
    # event) must still fingerprint: the missing file once killed every round
    fn=$t/fzn; mkdir -p "$fn"
    printf '{"t":"start","time":"00:00:00","ep":1,"id":"zn","name":"zn","kind":"agent","pane":"%s","group":"default"}\n' "$pl" > "$fn/events.jsonl"
    tmux -L "$S" send-keys -t "$pl" "cd '$gf'" Enter; sleep 0.3
    AWB_DIR=$fn AWB_TMUX_SOCKET=$fsock AWB_FROZEN=99999 "$BIN" nudge --once
    grep -q '^zn ' "$fn/diffs" || die "selftest: freeze scan died on a board without a panes file"
    [ -z "$(ls "$fn" | grep '^diffs\.')" ] || die "selftest: freeze scan left a temp file"
    sleep 0.6
    tmux -L "$S" capture-pane -p -t "$pl" | grep -Fq "没有代码改动" \
      || die "selftest: live frozen agent not reminded past a dead pane"
    # the throttle reads the latest reminder: an older line must not let the next round remind
    { echo "zl $(($(date +%s) - 5000))"; cat "$fz/fnudged"; } > "$fz/fn.x" && mv "$fz/fn.x" "$fz/fnudged"
    AWB_DIR=$fz AWB_TMUX_SOCKET=$fsock AWB_FROZEN=0 "$BIN" nudge --once
    [ "$(grep -c '^zl ' "$fz/fnudged")" = 2 ] || die "selftest: a frozen agent reminded again within AWB_NUDGE_EVERY: $(cat "$fz/fnudged")"
    # a worker driven by awb send whose task was replied waits for the main agent: fingerprinted,
    # never reminded (Meshy: spec marked itself blocked to stop the reminders)
    pw=$(tmux -L "$S" new-window -d -P -F '#{pane_id}' "$SHELL")
    AWB_DIR=$fz "$BIN" start zw waiter >/dev/null
    zk=$(AWB_DIR=$fz "$BIN" send zw "one task" 2>/dev/null | sed -n '1s/^\[awb zw#\([0-9]*\)\].*/\1/p')
    AWB_DIR=$fz "$BIN" reply zw "$zk" "done" >/dev/null
    printf 'zw %s %s\n' "$pw" "$gf" >> "$fz/panes"
    AWB_DIR=$fz AWB_TMUX_SOCKET=$fsock AWB_FROZEN=0 "$BIN" nudge --once
    grep -q '^zw ' "$fz/diffs" || die "selftest: an idle sent worker lost its fingerprint"
    ! grep -q '^zw ' "$fz/fnudged" || die "selftest: a sent worker with no open task was reminded"
  fi
  "$BIN" start zf frozen; "$BIN" now zf "idle"
  "$BIN" start zfb blk; "$BIN" now zfb "wait"; "$BIN" block zfb "remote job"
  "$BIN" start zi idlew; zik=$("$BIN" send zi "one" 2>/dev/null | sed -n '1s/^\[awb zi#\([0-9]*\)\].*/\1/p')
  "$BIN" reply zi "$zik" ok >/dev/null
  printf 'zf 1 %s\nzfb 1 %s\nzi 1 %s\n' "$(($(date +%s) - 1000))" "$(($(date +%s) - 1000))" "$(($(date +%s) - 1000))" > "$t/diffs"
  fr=$("$BIN" view --once)
  printf '%s' "$fr" | grep -Fq "frozen 无改动 16分钟" || die "selftest: stale fingerprint not shown frozen: $fr"
  ! printf '%s' "$fr" | grep -Fq "idlew 无改动" || die "selftest: a sent worker with no open task marked frozen"
  ! printf '%s' "$fr" | grep -Fq "blk 无改动" || die "selftest: blocked agent marked frozen"
  printf 'zf 1 %s\nzfb 1 %s\n' "$(date +%s)" "$(date +%s)" > "$t/diffs"
  ! "$BIN" view --once | grep -Fq "无改动 " || die "selftest: fresh fingerprint shown frozen"
  "$BIN" skill | grep -q "awb check" || die "selftest: skill manual not found"
  if m=$(model_bin); then
    "$BIN" view --json | jq -e 'any(.violations[]; .id == "g1" and .kind == "done-while-check-rejected")' >/dev/null \
      || die "selftest: the board missed a done after a rejection (Lean audit)"
    # fixed differential case: unknown events with NO id (and unknown t with an
    # id that never started) interleaved with real ones must be ignored by both
    # folds -- this pins jq's `($e.id|type)!="string" or .agents[id]==null` arm
    # to Lean parseLine's `_ => none`.
    mkdir -p "$t/diff0"
    printf '%s\n' \
      '{"t":"start","id":"u","name":"u","ep":1}' \
      '{"t":"weird-no-id","ep":2}' \
      '{"t":"now","id":"u","ep":3,"text":"m"}' \
      '{"t":"zzz","ep":4}' \
      '{"t":"status","id":"ghost","status":"running","ep":5}' \
      '{"t":"done","id":"u","ep":6}' > "$t/diff0/events.jsonl"
    a0=$(AWB_DIR=$t/diff0 "$BIN" _state); b0=$("$m" fold < "$t/diff0/events.jsonl")
    [ "$a0" = "$b0" ] || { printf 'jq:\n%s\nlean:\n%s\n' "$a0" "$b0" >&2; die "selftest: jq/Lean differ on unknown events"; }
    # differential test: jq fold (awb _state) vs the proven Lean fold on random logs
    mkdir -p "$t/diff"; n=0
    while [ $n -lt "${AWB_DIFF_N:-200}" ]; do
      n=$((n + 1))
      "$m" gen $n 80 > "$t/diff/events.jsonl"
      a=$(AWB_DIR=$t/diff "$BIN" _state); b=$("$m" fold < "$t/diff/events.jsonl")
      [ "$a" = "$b" ] || { printf 'jq:\n%s\nlean:\n%s\n' "$a" "$b" >&2; die "selftest: jq fold != Lean model (awbmodel gen $n 80)"; }
      # every 4th log: the brief view's sections (awb snapshot) match Brief.sec, which is
      # proven to show every agent; each agent must appear in exactly one section
      if [ $((n % 4)) = 0 ]; then
        a=$(AWB_DIR=$t/diff "$BIN" view --json 2>"$t/diff/err" | jq -r '[(.agents[] | "\(.id) work"), (.idle[] | "\(.id) idle"),
              (.need[] | select(.kind == "fail") | "\(.id) need")] | sort[]')
        b=$("$m" brief < "$t/diff/events.jsonl")
        [ "$a" = "$b" ] || { printf 'jq:\n%s\nlean:\n%s\n' "$a" "$b" >&2; die "selftest: brief sections != Lean Brief.sec (awbmodel gen $n 80)"; }
        [ ! -s "$t/diff/err" ] || die "selftest: snapshot errored on a log with a torn line: $(head -1 "$t/diff/err")"
      fi
    done
  else
    echo "selftest: Lean model not built, skipped audit and differential test (cd model && lake build)" >&2
  fi
  # hot-edit safety: the dispatch is a main() function invoked at EOF, so sh
  # parses the whole executable tail before it runs and an in-place rewrite of
  # awb cannot corrupt a running board/nudge loop ("syntax error near
  # unexpected token" hit twice while awb was being edited).
  tail -1 "$BIN" | grep -Fxq 'main "$@"; exit' || die "selftest: dispatch must end in 'main "$@"; exit' (hot-edit unsafe)"

  # Hot-edit injection proof, in a SEPARATE script/process so its background
  # jobs never touch this selftest's tmux sequence. A sh that resumes reading
  # by byte offset after a blocked command (bash 3.2) can, on a LONGER
  # in-place rewrite, read bytes past the original EOF: with a bare
  # `main "$@"` tail it then executes code appended by the rewrite; the fix is
  # `main "$@"; exit` on one line. Two legal main-wrapped programs differ only
  # in that tail; each is rewritten mid-sleep to a longer file carrying an
  # INJECTED_MARKER after the tail. The bare tail MUST run the marker (proves
  # the leak), the `; exit` tail MUST NOT (proves the fix). A whole-file reader
  # (dash) never runs the marker in the probe, so the leg is skipped there.
  ha=$t/hotedit; mkdir -p "$ha"
  cat > "$ha/check.sh" <<'CHK'
#!/bin/sh
set -u
ha=$(dirname "$0")
mk() {
  { printf '#!/bin/sh\nmain() {\nsleep 1\necho MAIN_RAN\n}\n'
    i=1; while [ $i -le 2000 ]; do printf 'echo f-%s-aaaaaaaaaaaaaaaaaaaaaaaa\n' "$i"; i=$((i+1)); done
    printf '%s\n' "$2"; } > "$1"; chmod +x "$1"; }
elongate() {
  { printf '#!/bin/sh\nmain() {\nsleep 1\necho MAIN_RAN\n}\n'
    i=1; while [ $i -le 3000 ]; do printf 'echo g-%s-bbbbbbbbbbbbbbbbbbbbbbbb\n' "$i"; i=$((i+1)); done
    printf '%s\n' "$2"
    printf 'echo INJECTED_MARKER\n'; } > "$1"; }
run1() {
  mk "$ha/$1.sh" "$2"
  /bin/sh "$ha/$1.sh" </dev/null >"$ha/$1.out" 2>"$ha/$1.err" &
  p=$!; sleep 0.4; elongate "$ha/$1.sh" "$2"
  wait "$p" 2>/dev/null; echo $? >"$ha/$1.rc"; }
run1 probe 'main "$@"'
grep -q INJECTED_MARKER "$ha/probe.out" || exit 0   # whole-file reader: leak cannot occur
run1 fixed 'main "$@"; exit'
[ "$(cat "$ha/fixed.rc")" = 0 ] && grep -q MAIN_RAN "$ha/fixed.out" || exit 3
if grep -q INJECTED_MARKER "$ha/fixed.out"; then exit 4; fi  # code appended past old EOF must not run
exit 0
CHK
  /bin/sh "$ha/check.sh" </dev/null || die "selftest: hot-edit exit guard (rc $?): 'main \"$@\"; exit' must stop code appended by a longer rewrite"

  if command -v tmux >/dev/null; then
    # a board inside some tmux server must size itself from THAT server, even when AWB_DIR holds a live awb socket
    tmux -S "$t/sock" new-session -d -s decoy -x 80 -y 24 "sleep 60"
    ep=$(tmux -L "${S}e" new-session -d -x 150 -y 60 -P -F '#{pane_id}' "sleep 60")
    es=$(tmux -L "${S}e" display-message -p '#{socket_path}')
    rows=$(TMUX="$es,0,0" TMUX_PANE=$ep AWB_COLS= AWB_ROWS= dims | cut -d' ' -f2)
    tmux -S "$t/sock" kill-server 2>/dev/null; tmux -L "${S}e" kill-server 2>/dev/null
    [ "$rows" -gt 24 ] || die "selftest: board sized from the awb socket's pane, not its own ($rows rows)"
    # a board taller than its pane scrolls: G shows the last task and the hint, g j j moves 2 lines
    sb=$t/scroll; mkdir -p "$sb"
    i=1; while [ $i -le 30 ]; do AWB_DIR=$sb "$BIN" task "s$i" wip "scroll row $i" >/dev/null; i=$((i + 1)); done
    tmux -L "${S}s" new-session -d -x 100 -y 12 "AWB_DIR=$sb AWB_COLS= AWB_ROWS= TMUX= '$BIN' view"
    cap() { sleep 1.5; tmux -L "${S}s" capture-pane -p; }
    top=$(cap); tmux -L "${S}s" send-keys G; end=$(cap); tmux -L "${S}s" send-keys g j j; two=$(cap)
    tmux -L "${S}s" send-keys q; sleep 1; alive=$(tmux -L "${S}s" ls 2>/dev/null || true)
    tmux -L "${S}s" kill-server 2>/dev/null || true
    printf '%s\n' "$top" | grep -q '还有 .* 行' || die "selftest: a board taller than the pane shows no scroll hint"
    printf '%s\n' "$end" | grep -q 'scroll row 30' || die "selftest: G does not scroll to the last line"
    [ "$(printf '%s\n' "$two" | sed -n 2p)" = "$(printf '%s\n' "$top" | sed -n 4p)" ] \
      || die "selftest: g j j does not scroll 2 lines from the top"
    [ -z "$alive" ] || die "selftest: q does not quit the board"
    # a worker of a board (its socket exported with AWB_TMUX_FOR) that works on another AWB_DIR
    # cannot touch that board: awb down there leaves the parent session and its panes alive
    pd=$t/parent; mkdir -p "$pd"; AWB_DIR=$pd/.awb "$BIN" up </dev/null >/dev/null
    psock=$pd/.awb/sock; [ -S "$psock" ] || die "selftest: awb up without a terminal made no session"
    AWB_TMUX_SOCKET=$psock AWB_TMUX_FOR=$pd/.awb TMUX=$psock,0,0 AWB_DIR=$t/child "$BIN" down
    tmux -S "$psock" has-session -t awb 2>/dev/null || die "selftest: awb down under another AWB_DIR killed the parent board"
    # an agent pane of the board (which inherits its AWB_DIR) cannot end the board
    ap=$(tmux -S "$psock" list-panes -t awb -F '#{pane_id}' | tail -1)
    AWB_DIR=$pd/.awb "$BIN" start pa agent >/dev/null; printf 'pa %s\n' "$ap" >> "$pd/.awb/panes"
    ! TMUX_PANE=$ap AWB_TMUX_SOCKET=$psock AWB_TMUX_FOR=$pd/.awb AWB_DIR=$pd/.awb "$BIN" down 2>/dev/null \
      || die "selftest: an agent pane ended its own board with awb down"
    tmux -S "$psock" has-session -t awb 2>/dev/null || die "selftest: awb down from an agent pane killed the board"
    AWB_TMUX_SOCKET=$psock AWB_TMUX_FOR=$pd/.awb AWB_DIR=$pd/.awb "$BIN" down
    ! tmux -S "$psock" has-session -t awb 2>/dev/null || die "selftest: awb down did not end its own board"
    # awb up inside tmux, twice for one .awb, opens one board beside the pane; the second names it
    bk=$(tmux -L "${S}b" new-session -d -x 160 -y 30 -P -F '#{socket_path},0,0 #{pane_id}' "sleep 60")
    bsock=${bk% *}; bpane=${bk#* }
    TMUX=$bsock TMUX_PANE=$bpane AWB_DIR=$sb "$BIN" up >/dev/null
    TMUX=$bsock TMUX_PANE=$bpane AWB_DIR=$sb "$BIN" up | grep -q "already open" || die "selftest: a second awb up did not reuse the open board"
    nb=$(tmux -L "${S}b" list-panes -a -F '#{pane_start_command}' | grep -c ' view' || true)
    tmux -L "${S}b" kill-server 2>/dev/null || true
    [ "$nb" = 1 ] || die "selftest: awb up opened $nb boards for one .awb"
  fi
  # awb-lark: one board = one topic whose root card carries every update. A fake lark-cli
  # records each call; the flow must create the topic once, then only patch that card.
  lk=$(dirname "$BIN")/awb-lark
  if [ -x "$lk" ]; then
    fb=$t/fakebin; lb=$t/lboard; mkdir -p "$fb" "$lb"
    cat > "$fb/lark-cli" <<'FAKE'
#!/bin/sh
d=$(dirname "$0")/..; printf '%s\n' "$*" >> "$d/lark.log"
c=; p=; for a; do [ "$p" = --content ] && c=$a; [ "$p" = --data ] && c=$a; p=$a; done
[ -z "$c" ] || printf '%s\n' "$c" > "$d/lark-last.json"
case "$*" in
  *is_in_chat*) echo true ;;
  *"+messages-send"*) if [ -e "$d/sent1" ]; then echo om_new; else : > "$d/sent1"; echo om_root; fi ;;
  *"messages patch"*) [ ! -e "$d/patchfail" ] ;;
  *"+messages-reply"*"interactive"*) echo om_card2 ;;
esac
FAKE
    chmod +x "$fb/lark-cli"
    lr() { AWB_DIR=$lb XDG_CONFIG_HOME=$t/xdg PATH=$fb:$PATH AWB=$BIN "$lk" "$@"; }
    lr setup oc_test >/dev/null && [ "$(cat "$t/xdg/awb/lark-chat")" = oc_test ] || die "selftest: awb-lark setup"
    AWB_DIR=$lb "$BIN" goal "L"; AWB_DIR=$lb "$BIN" start k1 kay; AWB_DIR=$lb "$BIN" now k1 "carding"
    AWB_DIR=$lb "$BIN" news "first-news"
    # one reading plus a reference series draws a chart by step with both series
    AWB_DIR=$rf AWB=$BIN "$lk" sync --dry-run | jq -e '[.body.elements[] | select(.tag == "chart") | .chart_spec]
      | length == 1 and (.[0].data.values | map(.s) | unique) == ["base 0923", "he 0926"] and (.[0].axes[1].type == "linear")' >/dev/null \
      || die "selftest: the card chart lacks the reference series"
    # two readings of the metric at the same step collapse to one point on the chart
    dp=$t/dup; mkdir -p "$dp"; dpn=$(date +%s)
    AWB_DIR=$dp "$BIN" goal D >/dev/null
    AWB_DIR=$dp "$BIN" metric --at $((dpn - 3600)) --step 500 du 1 10 >/dev/null
    AWB_DIR=$dp "$BIN" metric --step 500 du 1.2 10 "manual current reading" >/dev/null
    AWB_DIR=$dp AWB=$BIN "$lk" sync --dry-run > "$t/dup.json"
    jq -e '[.body.elements[] | select(.tag == "chart") | .chart_spec.data.values[]
             | select(.s == "du" and .t == 500)] | length == 1' "$t/dup.json" >/dev/null \
      || die "selftest: duplicate metric steps are not deduplicated on the chart"
    # the 24-hour tile names the metric its delta belongs to
    jq -e '[.. | .content? // empty | strings] | any(test("，\\+0\\.2"))' "$t/dup.json" >/dev/null \
      || die "selftest: the 24h metric delta is not on the card"
    # an empty board omits the empty folded panel and the epoch-0 stale time
    eb=$t/ecard; mkdir -p "$eb"
    AWB_DIR=$eb AWB=$BIN "$lk" sync --dry-run > "$t/ecard.json"
    jq -e '([.body.elements[] | select(.tag == "collapsible_panel")] | length == 0)
            and (.header.subtitle.content | test(" · [0-9]{2}:[0-9]{2}$"))' "$t/ecard.json" >/dev/null \
      || die "selftest: an empty card has a folded panel or a stale time"
    lr sync --dry-run | jq -e '.schema == "2.0" and .header.title.content == "L"
      and (.header.subtitle.content | test("^lboard · [0-9]{2}:[0-9]{2}$"))
      and (.body | tojson | test("下一步|异常\\*|最近进展|进展与任务|无需你处理|需要你\\*") | not)
      and ([.body.elements[] | select(.tag == "collapsible_panel")] | tojson | test("first-news"))
      and (tojson | test("carding") | not)' >/dev/null \
      || die "selftest: awb-lark card"
    lr sync; grep -c '+messages-send --chat-id oc_test --msg-type interactive' "$t/lark.log" | grep -qx 1 \
      || die "selftest: awb-lark did not create the topic once"
    cp "$t/lark.log" "$t/lark.log.first"
    jq -e '.root == "om_root"' "$lb/lark.json" >/dev/null || die "selftest: awb-lark mapping"
    # every update lands on the one card: news and needs-you are patched in, never posted
    AWB_DIR=$lb "$BIN" news "second-news"; AWB_DIR=$lb "$BIN" task q9 ask "pick-one"; : > "$t/lark.log"; lr sync
    grep -q 'messages patch --message-id om_root' "$t/lark.log" || die "selftest: awb-lark did not patch the card"
    grep -q 'second-news' "$t/lark-last.json" && grep -q 'pick-one' "$t/lark-last.json" \
      || die "selftest: the patched card lacks the new news or needs-you item"
    ! grep -q -e '+messages-send' -e '+messages-reply' "$t/lark.log" || die "selftest: an update posted a message"
    # a failed patch fails that sync only: nothing is posted, and the next sync patches the same card
    : > "$t/patchfail"; : > "$t/lark.log"; ! lr sync 2>/dev/null || die "selftest: a failed patch was reported as success"
    ! grep -q -e '+messages-send' -e '+messages-reply' "$t/lark.log" || die "selftest: a failed patch posted a message"
    rm -f "$t/patchfail"; : > "$t/lark.log"; lr sync
    grep -q 'messages patch --message-id om_root' "$t/lark.log" || die "selftest: the sync after a failed patch did not retry the card"
    # before Lark's 14-day patch limit the board moves to a new topic; the old card points there
    jq '.card_ep = 1' "$lb/lark.json" > "$lb/lark.json.t" && mv "$lb/lark.json.t" "$lb/lark.json"
    : > "$t/lark.log"; lr sync
    jq -e '.root == "om_new"' "$lb/lark.json" >/dev/null || die "selftest: an old card did not roll to a new topic"
    grep -q 'messages patch --message-id om_root' "$t/lark.log" && grep -q '新话题' "$t/lark-last.json" \
      || die "selftest: the old card does not point to the new topic"
    ! grep -q '+messages-reply' "$t/lark.log" || die "selftest: rolling over posted into the old topic"
    # the lock (model/tla/AwbLark.tla): a dead holder's lock is taken over, a live holder's
    # never is, however old; a lock directory left by awb 0.0.7 is taken over too
    sh -c 'exit 0' & dp=$!; wait $dp
    ln -s "$dp" "$lb/lock-lark"; : > "$t/lark.log"; lr sync
    grep -q 'messages patch' "$t/lark.log" || die "selftest: a dead sync's lock stopped the refresh"
    [ ! -e "$lb/lock-lark" ] || die "selftest: awb-lark left its lock behind"
    sleep 30 & lp=$!; ln -s "$lp" "$lb/lock-lark"; : > "$t/lark.log"; lr sync
    ! grep -q 'messages patch' "$t/lark.log" || die "selftest: awb-lark took a live sync's lock"
    kill $lp; wait $lp 2>/dev/null || true; rm -f "$lb/lock-lark"
    mkdir "$lb/lock-lark"; : > "$t/lark.log"; lr sync
    grep -q 'messages patch' "$t/lark.log" || die "selftest: an old lock directory stopped the refresh"
    # the topic is created with a key derived from the board, so a repeated send is deduplicated
    grep -q 'idempotency-key awb-' "$t/lark.log.first" || die "selftest: the topic was created without an idempotency key"
    # a board never linked (no lark.json) does not post itself, even with the group set
    nl=$t/unlinked; mkdir -p "$nl"; AWB_DIR=$nl "$BIN" goal "scratch" >/dev/null; : > "$t/lark.log"
    AWB_DIR=$nl XDG_CONFIG_HOME=$t/xdg PATH=$fb:$PATH AWB_LARK_EVERY=1 AWB_INTERVAL=0.2 "$BIN" view >/dev/null 2>&1 &
    wp=$!; sleep 2.5; kill $wp; wait $wp 2>/dev/null || true
    [ ! -s "$t/lark.log" ] && [ ! -e "$nl/lark.json" ] || die "selftest: an unlinked board posted itself to the Lark group"
    # the refresh itself: a running board (watch) patches the card on its own, again and
    # again, and each patch carries the board's latest state
    : > "$t/lark.log"
    AWB_DIR=$lb XDG_CONFIG_HOME=$t/xdg PATH=$fb:$PATH AWB_LARK_EVERY=1 AWB_INTERVAL=0.2 "$BIN" view >/dev/null 2>&1 &
    wp=$!
    i=0; until [ "$(grep -c 'messages patch' "$t/lark.log")" -ge 2 ]; do
      i=$((i + 1)); [ $i -lt 40 ] || { kill $wp; die "selftest: the board did not refresh its Lark card"; }; sleep 0.25; done
    AWB_DIR=$lb "$BIN" task rp wip "refresh-probe"; AWB_DIR=$lb "$BIN" news "news-while-watching"
    i=0; until grep -q 'refresh-probe' "$t/lark-last.json" 2>/dev/null && grep -q 'news-while-watching' "$t/lark-last.json"; do
      i=$((i + 1)); [ $i -lt 40 ] || { kill $wp; die "selftest: a refresh did not carry the new state"; }; sleep 0.25; done
    kill $wp; wait $wp 2>/dev/null || true
    ! grep -q -e '+messages-send' -e '+messages-reply' "$t/lark.log" || die "selftest: a refresh posted a message"
  fi
  [ ! -s "$t/guard/calls" ] || die "selftest: a test reached lark-cli: $(head -1 "$t/guard/calls")"
  echo "selftest ok"
}

# Dispatch lives in main(), invoked at EOF and followed by `; exit` on the
# SAME line. Wrapping makes the executable tail a function sh fully parses
# before the call, and the exit stops sh from re-reading bytes a LONGER
# in-place rewrite appends past the original EOF (bash 3.2 resumes by byte
# offset after a blocked command). Without both, a hot edit either desyncs a
# running board/nudge loop ("syntax error near unexpected token") or runs
# newly appended code after main returns.
main() {
cmd=${1:-}; shift 2>/dev/null || true
# `awb up --help` used to start a session and create AWB_DIR in the cwd; help never has side effects
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
case "$cmd" in ""|-h|--help|help|version|--version|-V) ;;
  *) command -v jq >/dev/null 2>&1 || die "jq is required: brew install jq (macOS), apt install jq (Debian/Ubuntu)" ;; esac
case "$cmd" in
  up)       up "$@" ;;
  down)     init_dir   # only the session awb up made for this board, never the server it runs in
            # an agent of this board inherits its AWB_DIR: its awb down (a worker trying awb in
            # another directory) once ended the board and every worker on it
            if [ -n "${TMUX_PANE:-}" ] && agent_panes | awk -v p="$TMUX_PANE" '$2 == p {f = 1} END {exit !f}'; then
              die "this pane is an agent of the board $AWB_DIR; awb down would end it and every agent on it. The user or the main agent runs it (set AWB_DIR for another board)"
            fi
            [ -S "$(sock_path)" ] && tmux -S "$(sock_path)" kill-session -t awb 2>/dev/null || true ;;
  run)      run "$@" ;;
  tui)      tui "$@" ;;
  start)
    [ $# -ge 1 ] || die "usage: $PROG start ID NAME [KIND] [GROUP]"
    init_dir; not_running "$1"
    append '{t:"start",time:$time,ep:$ep,id:$id,name:$name,kind:$kind,pane:$pane,group:$group}' \
      --arg id "$1" --arg name "${2:-$1}" --arg kind "${3:-agent}" --arg pane "" \
      --arg group "${4:-default}"
    ;;
  task)     [ $# -ge 2 ] || die "usage: $PROG task ID STATE [TEXT] [PARENT] [OWNER]"
            case $2 in todo|wip|review|blocked|done|drop|ask) ;; *) die "state: todo|wip|review|blocked|done|drop|ask" ;; esac
            [ -z "${4:-}" ] || { init_dir; [ -s "$EV" ] && grep -F "\"id\":\"$4\"" "$EV" | grep -qF '"t":"task"'; } \
              || die "no task $4 to be the parent of $1 (create it first: $PROG task $4 STATE TEXT)"
            append '{t:"task",time:$time,ep:$ep,id:$id,state:$st,text:$text,parent:$par,owner:$own}' \
              --arg id "$1" --arg st "$2" --arg text "${3:-}" --arg par "${4:-}" --arg own "${5:-}" ;;
  nudge)    init_dir; if [ "${1:-}" = "--once" ]; then nudge_round
            else while :; do nudge_round; sleep "${AWB_NUDGE_POLL:-60}"; done; fi ;;
  news)     _nk=; if [ "${1:-}" = --key ]; then _nk=${2:-}; shift 2 || die "--key needs a key"; fi
            [ $# -ge 1 ] || die "usage: $PROG news [--key KEY] TEXT"
            case $1 in --*) die "unknown option: $1" ;; esac
            append '{t:"news",time:$time,ep:$ep,text:$text} + (if $k == "" then {} else {key:$k} end)' \
              --arg text "$*" --arg k "$_nk" ;;
  goal)     [ $# -ge 1 ] || die "usage: $PROG goal TEXT"
            case $1 in --*) die "unknown option: $1" ;; esac
            append '{t:"goal",time:$time,ep:$ep,text:$text}' --arg text "$*" ;;
  metric)   # --at EPOCH records a past reading at its own time; --step N is its x (a training step)
            _at=; _x=; _by=; _ref=
            while :; do case "${1:-}" in
              --at) _at=${2:-}; shift 2 || die "--at needs an epoch" ;;
              --step) _x=${2:-}; shift 2 || die "--step needs a number" ;;
              --by) _by=${2:-}; shift 2 || die "--by needs an epoch" ;;
              --ref) _ref=1; shift ;;
              --*) die "unknown option: $1" ;;
              *) break ;; esac; done
            [ $# -ge 3 ] || die "usage: $PROG metric [--at EPOCH] [--step N] [--by EPOCH] [--ref] NAME VALUE TARGET [NOTE]"
            # jq tonumber rejects '1.2.3'/'-'/''; the finite/self-equal guard
            # additionally rejects NaN/Infinity (jq 1.8 has no finite/0).
            _numok='tonumber as $n | $n == $n and $n < 1e309 and $n > -1e309'
            printf '%s' "$2" | jq -eR "$_numok" >/dev/null 2>&1 || die "metric VALUE must be numeric (got: $2)"
            printf '%s' "$3" | jq -eR "$_numok" >/dev/null 2>&1 || die "metric TARGET must be numeric (got: $3)"
            # render-only: no id / agent. The fold's `($e.id|type)!="string" or
            # .agents[id]==null` arm (matching Lean parseLine's `_ => none`)
            # drops the unknown event, so it never reaches agent state; render
            # reads it from the same piped event array, not a second log read.
            [ -z "$_at" ] || printf '%s' "$_at" | grep -Eqx '[0-9]{9,11}' || die "--at wants epoch seconds (got: $_at)"
            [ -z "$_by" ] || printf '%s' "$_by" | grep -Eqx '[0-9]{9,11}' || die "--by wants epoch seconds (got: $_by)"
            [ -z "$_x" ] || printf '%s' "$_x" | jq -eR "$_numok" >/dev/null 2>&1 || die "--step must be numeric (got: $_x)"
            append '{t:"metric", name:$name, value:($value|tonumber), target:($target|tonumber), note:$note}
                    + (if $at == "" then {time:$time, ep:$ep}
                       else ($at | tonumber) as $a | {time:($a | strflocaltime("%H:%M:%S")), ep:$a} end)
                    + (if $x == "" then {} else {x:($x | tonumber)} end)
                    + (if $by == "" then {} else {by:($by | tonumber)} end)
                    + (if $ref == "" then {} else {ref:true} end)' \
              --arg name "$1" --arg value "$2" --arg target "$3" --arg note "${4-}" --arg at "$_at" --arg x "$_x" --arg by "$_by" --arg ref "$_ref" ;;
  now)      [ $# -ge 2 ] || die "usage: $PROG now ID MILESTONE"
            self_report "$1"
            append '{t:"now",time:$time,ep:$ep,id:$id,text:$text}' --arg id "$1" --arg text "${2-}" ;;
  done)     [ $# -ge 1 ] || die "usage: $PROG done ID [TEXT]"
            self_report "$1"
            append '{t:"done",time:$time,ep:$ep,id:$id,text:(if $text == "" then null else $text end)}' \
              --arg id "$1" --arg text "${2:-}" ;;
  block)    [ $# -ge 2 ] || die "usage: $PROG block ID REASON"
            need_agent "$1"
            append '{t:"status",time:$time,ep:$ep,id:$id,status:"blocked",reason:$r}' \
              --arg id "$1" --arg r "${2-}" ;;
  unblock)  [ $# -ge 1 ] || die "usage: $PROG unblock ID"
            need_agent "$1"
            append '{t:"status",time:$time,ep:$ep,id:$id,status:"running",reason:""}' --arg id "$1" ;;
  fail)     [ $# -ge 2 ] || die "usage: $PROG fail ID REASON"
            need_agent "$1"
            append '{t:"status",time:$time,ep:$ep,id:$id,status:"failed",reason:$r}' \
              --arg id "$1" --arg r "${2-}" ;;
  finish)   [ $# -ge 1 ] || die "usage: $PROG finish ID [NOTE]"
            # ends the agent; an open sent task ends with it, with no result (was: refused)
            need_agent "$1"; _k=$(open_key "$1")
            [ -z "$_k" ] || echo "$PROG: $1 task #$_k closed without a reply" >&2
            append '{t:"done",time:$time,ep:$ep,id:$id,text:(if $text == "" then null else $text end)}' \
              --arg id "$1" --arg text "${2:-}"
            append '{t:"status",time:$time,ep:$ep,id:$id,status:"done",reason:""}' --arg id "$1" ;;
  reset)    init_dir   # the log is the only record: keep a copy, then clear in place (watch keeps its file)
            _b=$EV.$(date +%s).bak; [ -s "$EV" ] && { cp "$EV" "$_b"; echo "cleared; the old log is $_b"; }
            : > "$EV" ;;
  replay)   replay "$@" ;;
  _view)    # a snapshot on stdin, drawn as the board: awb _view [COLS ROWS]. Probed, a width
            # under 40 is a pane of another server or a worker's sliver, not where this output goes
            printf '%s %s' "${1:-}" "${2:-}" | grep -Eq '^[0-9]+ [0-9]+$' || { set -- $(dims); [ "${1:-0}" -ge 40 ] || set -- 80 "${2:-24}"; }
            brief_view "$1" "$2" ;;
  view|watch|render|snapshot)   # the board live / drawn once / as JSON; old names kept
            case "$cmd ${1:-}" in
              "view --once"|render*) init_dir; render ;;
              "view --json"|snapshot*) snapshot ;;
              "view "|watch*) init_dir; watch ;;
              *) die "usage: $PROG view [--once | --json]" ;;
            esac ;;
  _enter)   _enter ;;
  _leave)   _leave "${1:-0}" ;;
  check)    check "$@" ;;
  pr)       pr "$@" ;;
  hold)     hold "$@" ;;
  merge)    merge "$@" ;;
  # merged into other commands; kept for scripts: holder RES = "OWNER EP NOTE", exit 1 when free
  status)   [ $# -ge 2 ] || die "usage: $PROG status ID running|blocked|failed|done [REASON]"
            case $2 in running) main unblock "$1" ;; blocked) main block "$1" "${3:-}" ;;
              failed) main fail "$1" "${3:-}" ;; done) main finish "$1" "${3:-}" ;;
              *) die "status: running|blocked|failed|done" ;; esac ;;
  board)    up ;;
  holder)   [ $# -ge 1 ] || die "usage: $PROG holder RES"; holder "$1" ;;
  audit)    init_dir; m=$(model_bin) || die "audit needs the Lean model: (cd $(src_dir)/model && lake build)"
            [ ! -s "$EV" ] || "$m" audit < "$EV" ;;
  release)  release "$@" ;;
  send)     send "$@" ;;
  reply)    reply "$@" ;;
  idle)     idle "$@" ;;
  _observe) init_dir; observe_once ;;   # one observation round (the board runs it with nudge)
  _state)   state ;;   # the jq fold per agent, for the differential test against the Lean model
  version|--version|-V) echo "$PROG $VERSION" ;;
  skill)    skill ;;
  tell)     tell "$@" ;;
  peers)    peers ;;
  selftest) selftest ;;
  ""|-h|--help|help) usage ;;
  *) # the nearest command name of this dispatch (edit distance <= 2): a guessed name
     # (Meshy: awb holds) gets the right one, not only the list
     _sug=$(printf '%s' "$cmd" | cut -c1-40 | { read -r w || true
       awk '/^main\(\) \{/,0' "$BIN" | grep -oE '^  [a-z][a-z|_-]*\)' | tr -d ' )' | tr '|' '\n' \
       | awk -v w="$w" 'function lev(a, b,  i, j, la, lb, d, c, x) { la = length(a); lb = length(b)
           for (i = 0; i <= la; i++) d[i, 0] = i; for (j = 0; j <= lb; j++) d[0, j] = j
           for (i = 1; i <= la; i++) for (j = 1; j <= lb; j++) { c = (substr(a, i, 1) != substr(b, j, 1))
             x = d[i-1, j] + 1; if (d[i, j-1] + 1 < x) x = d[i, j-1] + 1; if (d[i-1, j-1] + c < x) x = d[i-1, j-1] + c
             d[i, j] = x }
           return d[la, lb] }
         { v = lev(w, $0); if (b == "" || v < b) { b = v; s = $0 } }
         END { if (b != "" && b <= 2 && b < length(w)) print s }'; } || true)
     printf '%s: unknown command: %s%s (commands: %s help)\n' "$PROG" "$cmd" \
       "${_sug:+; did you mean: $PROG $_sug?}" "$PROG" >&2
     # the board shows it too: a script that throws stderr away would otherwise fail unseen
     [ ! -s "$EV" ] || append '{t:"badcmd",time:$time,ep:$ep,cmd:$c} + (if $s == "" then {} else {sug:$s} end)' \
       --arg c "$cmd" --arg s "$_sug"
     exit 2 ;;
esac
}

main "$@"; exit
