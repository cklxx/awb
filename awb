#!/bin/sh
# awb — tmux agent workbench.
# Source of truth: .awb/events.jsonl (append-only). Any agent that can exec a
# process can drive the board; the renderer shows goals and milestones, never
# agent process output.
set -eu

VERSION=0.0.7
PROG=$(basename "$0")
AWB_DIR=${AWB_DIR:-$PWD/.awb}
EV=$AWB_DIR/events.jsonl
TS_FMT=%H:%M:%S
ESC=$(printf '\033')

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }

init_dir() {
  mkdir -p "$AWB_DIR" || die "cannot create $AWB_DIR"
  AWB_DIR=$(cd "$AWB_DIR" && pwd)
  EV=$AWB_DIR/events.jsonl
}

# append '<jq filter>' [jq args...] — $time (clock) and $ep (epoch) available
append() {
  init_dir
  _f=$1; shift
  jq -cn --arg time "$(date +$TS_FMT)" --argjson ep "$(date +%s)" "$_f" "$@" >> "$EV"
}

q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# tmux socket; unix socket paths are capped near 104 bytes, deep dirs fall back to /tmp
sock_path() {
  _s=$AWB_DIR/sock
  [ ${#_s} -lt 100 ] || _s=/tmp/awb-$(id -u)-$(printf %s "$AWB_DIR" | cksum | cut -d' ' -f1).sock
  printf %s "$_s"
}

# talk to the awb server even when called outside its tmux (main agent, nested sessions)
tm() {
  if [ -n "${AWB_TMUX_SOCKET:-}" ] && [ -S "$AWB_TMUX_SOCKET" ]; then tmux -S "$AWB_TMUX_SOCKET" "$@"
  elif [ -S "$(sock_path)" ]; then tmux -S "$(sock_path)" "$@"
  else tmux "$@"; fi
}

BIN=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")

# event fold: the state machine modelled and proven in model/AwbModel.lean;
# `awb state` prints it for the differential test against the compiled model
JQ_FOLD='
def fold:
reduce (. // [])[] as $e (
  {goal:"", agents:{}, gorder:{}, gseen:[], tasks:{}, torder:[], news:[], checks:{}};
  if   $e.t == "goal" then .goal = $e.text
  elif $e.t == "news" then .news += [{text:$e.text, time:($e.time // "")}]
  elif $e.t == "task" then
    (if .tasks[$e.id] == null then .torder += [$e.id] else . end)
    | .tasks[$e.id] = ((.tasks[$e.id] // {id:$e.id, state:"todo", text:$e.id, parent:"", owner:""})
        + ({state:$e.state, text:$e.text, parent:$e.parent, owner:$e.owner}
           | with_entries(select(.value != null and .value != ""))))
  elif $e.t == "start" then
    if .agents[$e.id] != null then
      .agents[$e.id] += {status:"running", reason:"", endEp:null,
                         pane:($e.pane // .agents[$e.id].pane), lastEp:($e.ep // .agents[$e.id].lastEp)}
    else ($e.group // "default") as $g
      | .agents[$e.id] = {id:$e.id, name:($e.name // $e.id), kind:($e.kind // "agent"),
                          pane:($e.pane // ""), group:$g, status:"running",
                          current:null, done:[], reason:"", gate:false,
                          startEp:($e.ep // 0), lastEp:($e.ep // 0), endEp:null}
      | .gorder[$g] = ((.gorder[$g] // []) + [$e.id])
      | (if (.gseen | index($g)) then . else .gseen += [$g] end)
    end
  elif $e.t == "chk" then
    (if (.checks[$e.id].run // "") != $e.run
     then .checks[$e.id] = {id:$e.id, what:$e.what, run:$e.run, startEp:$e.ep, steps:[]} else . end)
    | (.checks[$e.id].steps | map(.s) | index($e.step)) as $i
    | if $i == null then .checks[$e.id].steps += [{s:$e.step, state:$e.state, ep0:$e.ep, ep1:null, note:""}]
      else .checks[$e.id].steps[$i] += {state:$e.state, ep1:$e.ep, note:$e.note} end
  elif ($e.id | type) != "string" or .agents[$e.id] == null then .
  elif $e.t == "now" then
    (if .agents[$e.id].status == "done" then .agents[$e.id].status = "running" | .agents[$e.id].endEp = null | .agents[$e.id].reason = "" else . end)
    | .agents[$e.id].current = {text:($e.text // ""), time:($e.time // ""), ep:($e.ep // 0)}
    | .agents[$e.id] += {status:"running", reason:"", endEp:null}
    | .agents[$e.id].lastEp = ($e.ep // .agents[$e.id].lastEp)
  elif $e.t == "done" then
    (.agents[$e.id]) as $a | ($e.ep // $a.lastEp) as $ep
    # a passing check with no open milestone verifies the last finished one
    | (if $e.verified and $a.current == null and $e.text == null and ($a.done | length) > 0
       then .agents[$e.id].done[-1].text |= (if startswith("⊢ ") then . else "⊢ " + . end)
       else .agents[$e.id].done += [{text:((if $e.verified then "⊢ " else "" end) + ($e.text // $a.current.text // "milestone")),
                                     time:($e.time // ""), dur:([0, $ep - ($a.current.ep // $ep)] | max)}] end)
    | .agents[$e.id].current = null
    | .agents[$e.id].lastEp = $ep
    | (if $e.verified then .agents[$e.id].gate = false
         | (if .agents[$e.id].status == "failed"
            then .agents[$e.id] += {status:"running", reason:"", endEp:null} else . end)
       else . end)
  elif $e.t == "status" and (($e.status // "running") | IN("running","blocked","failed","done") | not) then .
  elif $e.t == "status" and $e.status == "done" and .agents[$e.id].gate then
    .agents[$e.id] += {status:"failed", endEp:($e.ep // 0)}
  elif $e.t == "status" then
    .agents[$e.id].gate = (.agents[$e.id].gate or ($e.gate == true))
    | .agents[$e.id].status = ($e.status // "running")
    | .agents[$e.id].reason = ($e.reason // "")
    | .agents[$e.id].lastEp = ($e.ep // .agents[$e.id].lastEp)
    | (if ($e.status == "done" or $e.status == "failed") then .agents[$e.id].endEp = ($e.ep // 0)
       elif ($e.status == "running" or $e.status == "blocked") then .agents[$e.id].endEp = null
       else . end)
  else . end);
'

JQ_RENDER=$JQ_FOLD'
def wide($c):
  ($c >= 4352 and $c <= 4447) or ($c >= 11904 and $c <= 42191)
  or ($c >= 44032 and $c <= 55203) or ($c >= 63744 and $c <= 64255)
  or ($c >= 65072 and $c <= 65103) or ($c >= 65280 and $c <= 65376)
  or ($c >= 65504 and $c <= 65510) or ($c >= 131072 and $c <= 262141);
def cw($c): if wide($c) then 2 else 1 end;
def dwidth: [explode[] | cw(.)] | add // 0;
def clip($n):
  (gsub("[[:cntrl:]]"; " ")) as $s
  | if $n <= 0 then ""
    elif ($s | dwidth) <= $n then $s
    else ([($s | explode[]) as $c | {c:$c, w:cw($c)}]
          | reduce .[] as $x ({a:[], w:0};
              if .w + $x.w > ($n - 1) then .
              else .a += [$x.c] | .w += $x.w end)
          | (.a | implode) + "…")
    end;
def pad($n):
  . as $s | ($n - ($s | dwidth)) as $slack
  | if $slack <= 0 then $s else $s + (" " * $slack) end;
def pad2: if . < 10 then "0" + tostring else tostring end;
def hms:
  (.) as $s | ($s / 3600 | floor) as $h
  | (($s % 3600) / 60 | floor) as $m | ($s % 60 | floor) as $sc
  | if $h > 0 then "\($h):\($m|pad2):\($sc|pad2)" else "\($m):\($sc|pad2)" end;
def dur: (if . == null then "--:--" else hms end) as $t
  | (" " * (8 - (($t|length) | if . > 8 then 8 else . end))) + $t;
def sdur:
  if . == null then "·"
  elif . < 60 then "\(.)s"
  elif . < 3600 then "\((. / 60 | floor)):\((. % 60) | pad2)"
  else "\((. / 3600 | floor)):\(((. % 3600) / 60 | floor) | pad2):\((. % 60) | pad2)" end;
def ago: if . >= 86400 then "\((. / 8640 | floor) / 10)天" elif . >= 3600 then "\(. / 3600 | floor)小时"
  else "\(. / 60 | floor)分钟" end;
def spark($mx): map(if $mx > 0 then (. / $mx * 7 | floor | if . < 0 then 0 elif . > 7 then 7 else . end) else 0 end
  | ["▁","▂","▃","▄","▅","▆","▇","█"][.]) | add;
def bar($d; $t; $n):
  (if $t == 0 then 0 else ($d * $n / $t | floor) end) as $f
  | ("█" * $f) + ("░" * ($n - $f));
def kids($T; $O; $id): [$O[] | select(($T[.].parent // "") == $id and (($T[.].state) | IN("ask","drop") | not))];
def leaves($T; $O; $id): kids($T; $O; $id) as $k
  | if ($k | length) == 0 then [$id] else [$k[] | leaves($T; $O; .)[]] end;
def tree($T; $O; $id; $pre): kids($T; $O; $id) as $k | ($k | length) as $n
  | [range(0; $n) as $i | ($i == $n - 1) as $l
     | [{pre:($pre + (if $l then "└─ " else "├─ " end)), t:$T[$k[$i]], depth:($pre | length)}]
       + tree($T; $O; $k[$i]; $pre + (if $l then "   " else "│  " end))] | add // [];
def prog($T; $ids): [$ids[] | $T[.] | select(.state != "drop")] as $x
  | {d:([$x[] | select(.state == "done")] | length), t:($x | length)};
def live: .current != null and (.status == "running" or .status == "blocked");
def lpad($n):
  . as $s | (" " * ($n - (($s|length) | if . < 0 then 0 elif . > $n then $n else . end))) + $s;
def wrap($n):
  if length == 0 then [""]
  else (reduce (explode[]) as $c ({lines:[[]], w:0};
          cw($c) as $cw
          | if .w + $cw > $n then .lines += [[$c]] | .w = $cw
            else .lines[-1] += [$c] | .w += $cw end)
        | [.lines[] | implode])
  end;

($w   | if . < 40 then 40 elif . > 240 then 240 else . end) as $w |
($h   | if . < 12 then 12 elif . > 5000 then 5000 else . end) as $h |
($w - 1) as $inner |

. as $raw
# the newest reading by its time, so a backfilled older one (metric --at) does not replace it
| ([$raw[] | select(type == "object" and .t == "metric")] | sort_by(.ep // 0) | last // {}) as $metric
| ($raw | fold)

# pane closed without a finish/fail event -> dead (empty pane = remote agent)
| .agents |= map_values(
    (.pane) as $p
    | if $p != "" and $live != null and (($live | index($p)) == null) and (.status | IN("running","blocked"))
      then .status = "dead" | .reason = "pane closed" | .endEp = .lastEp
      else . end)

# live Claude session state ($sess, from ~/.claude/sessions, not the proven fold): a
# permission dialog overrides the self-report; a self-report the session contradicts is flagged
| .agents |= with_entries(($sess[.key] // null) as $x
    | if $x == null then .
      elif $x.status == "waiting" then .value.wait = true
        | .value.sess = "待批准：" + (if $x.waiting != "" then $x.waiting else "对话框" end) + " " + (($nowep - $x.since) | sdur)
      elif $x.status == "busy" and (.value.status | IN("done","failed")) then
        .value.sess = "自报" + {"done":"完成","failed":"失败"}[.value.status] + "，会话在忙"
      elif $x.status == "idle" and .value.status == "running" and ($nowep - $x.since) >= ($stale | tonumber) then
        .value.sess = "自报进行，会话空闲 " + (($nowep - $x.since) | sdur)
      else . end)

| . as $s
| ($s.gseen | map({g:., ids:$s.gorder[.]})) as $groups
| ([$s.agents[]] | length) as $n
| ([$s.agents[] | .status] | group_by(.) | map({key:.[0], value:length}) | from_entries) as $c
| (if $s.goal == "" then "(no goal yet:  " + $prog + " goal \"ship it\")" else $s.goal end) as $goal
| (($goal | gsub("\r";"") | split("\n") | map(wrap($inner - 4)) | add)) as $goal_lines
| ("╭─ GOAL " + ("─" * ($inner - 8))) as $top
| ("╰─ " +
    (if $n == 0 then "no agents yet:  " + $prog + " run id name -- claude"
     else ([$s.agents[] | .done | length] | add // 0) as $md
       | ([$s.agents[] | select(live)] | length) as $mo
       | prog($s.tasks; leaves($s.tasks; $s.torder; "")) as $tp
       | (if $tp.t > 0 then "总进度 " + bar($tp.d; $tp.t; 20) + " \($tp.d)/\($tp.t) 任务 · " else "" end)
         + "里程碑 \($md)/\($md + $mo) · "
         + "\($n) agents ◔\($c.running // 0) ▲\($c.blocked // 0) ✓\($c.done // 0) ✗\($c.failed // 0) ■\($c.dead // 0)"
     end)
    + "   " + $now) as $foot
| ([$s.checks[]] | sort_by(-.startEp) | .[:3]) as $cks
| (if ($cks | length) == 0 then [] else ["", $g + "验收" + $rs]
   + [ $cks[] | .steps as $ss
       | (if any($ss[]; .state == "fail") then ["✗",$r] elif any($ss[]; .state == "run") then ["◔",$cy]
          else ["⊢",$g] end) as $ov
       | ([$ss[] | (.ep1 // $nowep) - .ep0] | add // 0) as $el
       | ([ $ss[] | ({"ok":["✓",$g],"fail":["✗",$r],"run":["◔",$cy]}[.state] // ["·",$dm]) as $i
            | $i[1] + .s + " " + $i[0] + $rs
              + (if .state == "run" then $dm + " " + (($nowep - .ep0) | sdur) + $rs else "" end) ]
          | join($dm + " → " + $rs)) as $chain
       | ([$ss[] | select(.state == "fail") | .note] | first // "") as $why
       | "  " + $ov[1] + $ov[0] + $rs + " " + ((($s.agents[.id].name) // .id) | clip(10) | pad(10)) + " "
         + $dm + (.what | clip(18) | pad(18)) + $rs + " " + $chain + $dm + "  " + ($el | sdur) + $rs
       , (if $why != "" then "    " + $r + "└ " + ($why | clip($inner - 8)) + $rs else empty end) ]
   end) as $chk
| ($viol | split("\n") | map(select(. != "") | split(" "))) as $vs
| ($chk + (if ($vs | length) == 0 then [] else ["", $r + "审计违规（Lean 监控）" + $rs]
    + [ $vs[] | "  " + $r + "✗ " + $rs + ((($s.agents[.[0]].name) // .[0]) | clip(10) | pad(10)) + " "
        + ({"verified-without-passing-check":"验收标记前没有通过的验收（疑似伪造）",
            "pr-without-passing-check":"没有通过的验收就开了 PR",
            "done-while-check-rejected":"验收被拒后仍报完成"}[.[1]] // .[1]) ] end)) as $chk
| ({"todo":["○",$dm],"wip":["◔",$cy],"review":["◑",$cy],"blocked":["▲",$y],
    "done":["✓",$g],"drop":["–",$dm],"ask":["?",$y]}) as $TI
| ([ kids($s.tasks; $s.torder; "")[] as $root | $s.tasks[$root] as $rt
     | prog($s.tasks; leaves($s.tasks; $s.torder; $root)) as $rp
     | [$cy + "■ " + ($rt.text | clip($inner - 36)) + $rs + "  " + bar($rp.d; $rp.t; 12) + $dm + " \($rp.d)/\($rp.t)" + $rs]
     + [ tree($s.tasks; $s.torder; $root; "  ")[]
         | . as $n | ($TI[.t.state] // ["•",$dm]) as $ic
         | (if .t.owner != "" then " @" + .t.owner else "" end) as $ow
         | $ic[1] + .pre + $ic[0] + " " + ($n.t.text | clip($inner - $n.depth - 6 - ($ow | dwidth)))
           + $dm + $ow + $rs ]
   ] | add // []) as $ttree
| ([$top] + [$goal_lines[] | "│ " + .] + [($foot | clip($inner))] + [""]
   + (if ($ttree | length) > 0 then $ttree + [""] else [] end) + (if ($chk | length) > 0 then $chk[1:] + [""] else [] end)) as $head

| ([ $groups[] as $gr
    | [$gr.ids[] | $s.agents[.] | select(. != null)] as $as
    | ([$as[] | .done | length] | add // 0) as $gd
    | ([$as[] | select(live)] | length) as $go
    | ([$as[] | select(.status == "blocked")] | length) as $gb
    | ($as | length) as $na
    | [[$cy + "◆ " + $gr.g + $rs + "  " + bar($gd; $gd + $go; 10)
        + $dm + "  \($gd)/\($gd + $go)  " + "\($na) agents" + (if $gb > 0 then "  ▲\($gb)" else "" end) + $rs]]
    + [ range(0; $na) as $i | $as[$i] as $a | ($i == $na - 1) as $last
      | (if $last then "└─ " else "├─ " end) as $br
      | (if $last then "   " else "│  " end) as $ind
      | (if $a.wait then ["▲",$y,"待批准"] else
          {"running":["◔",$cy,"进行中"],"done":["✓",$g,"完成"],"blocked":["▲",$y,"阻塞"],
           "failed":["✗",$r,"失败"],"dead":["■",$r,"已退出"]}[$a.status] // ["•",$dm,$a.status] end) as $st
      | (($a.endEp // $nowep) - $a.startEp) as $tot
      | ($nowep - $a.lastEp) as $idle
      | ((($a.done|length) | tostring) + " ✓") as $cnt
      | ((if $idle >= 600 and ($a.status == "running" or $a.status == "blocked")
            then "  " + ($idle | sdur) + " 无更新" else "" end)) as $stale
      | (($br + $st[0] + " " + ($a.name | clip(12) | pad(12)) + " " + $st[2] + "  " + $cnt + $stale)
         | clip($inner - 9) | pad($inner - 9)) as $hd
      | ([ (if ($a.done | length) > 3 then {k:"more", n:(($a.done|length) - 3)} else empty end) ]
         + [ $a.done[-3:][] | {k:"done", text, dur, time} ]
         + (if ($a | live) then [{k:"cur", text:$a.current.text, ep:$a.current.ep}] else [] end)
         + (if $a.reason != "" then [{k:"why", text:$a.reason}] else [] end)
         + (if ($a.sess // "") != "" then [{k:"sess", text:$a.sess}] else [] end)) as $ch
      | ($ch | length) as $nc
      | [ $st[1] + $hd + $dm + ($tot | dur) + $rs ]
      + [ range(0; $nc) as $j | $ch[$j] as $c
          | ($ind + (if $j == $nc - 1 then "└─ " else "├─ " end)) as $pre
          | if $c.k == "done" then
              (($c.text | startswith("⊢ ")) | not) as $unv
              | $g + $pre + "✓ "
              + ($c.text | clip($inner - (if $unv then 32 else 26 end))
                         | pad($inner - (if $unv then 32 else 26 end)))
              + (if $unv then $dm + " 自报 " + $rs else "" end)
              + $dm + ((($c.dur // null) | sdur) | lpad(6)) + " " + $c.time + $rs
            elif $c.k == "cur" then
              $cy + $pre + "▸ " + ($c.text | clip($inner - 26) | pad($inner - 26))
              + ((($nowep - $c.ep) | sdur) | lpad(6)) + " 进行" + $rs
            elif $c.k == "sess" then $y + $pre + "≠ " + ($c.text | clip($inner - 10)) + $rs
            elif $c.k == "why" then
              ({"blocked":$y,"failed":$r,"dead":$r}[$a.status] // $dm) + $pre + "▲ " + ($c.text | clip($inner - 10)) + $rs
            else $dm + $pre + "… 更早 \($c.n) 条" + $rs end ]
      ]
  ] | add // []) as $blocks

| ($h - ($head | length)) as $avail
| (reduce $blocks[] as $b ({lines:[], rows:0, hidden:0};
    if .rows + ($b|length) <= $avail
    then .lines += $b | .rows += ($b|length)
    else .hidden += 1 end)) as $fit
| if $view == "full" then $head + $fit.lines
+ (if $fit.hidden > 0 then ["    … +\($fit.hidden) more rows (resize pane)"] else [] end)
else
  # brief: answers, in order, how far from the goal and is it moving; what needs you;
  # what each agent is doing; how much of it is verified. Least important last, since
  # the view is cut at the pane height. The same data, as JSON, is the snapshot view
  # (awb snapshot) that awb-lark turns into a card.
  ([$inner, 100] | min) as $bw
  | ([$raw[] | select(type == "object" and .t == "task" and .id != null)]
     | group_by(.id) | map({key:.[0].id, value:(map(.ep // 0) | max)}) | from_entries) as $tep
  | ([ kids($s.tasks; $s.torder; "")[] as $root
       | leaves($s.tasks; $s.torder; $root) as $lv | prog($s.tasks; $lv) as $rp
       | ([$root, $lv[]] | map($tep[.] // 0) | max) as $last
       | {id:$root, old:($rp.t > 0 and $rp.d == $rp.t and ($nowep - $last) >= 3600)} ]) as $roots
  | ([$roots[] | select(.old | not) | .id]) as $lroots
  | ([$roots[] | select(.old)] | length) as $nold
  | prog($s.tasks; [$lroots[] | leaves($s.tasks; $s.torder; .)[]]) as $tp
  | ($nowep - 3600) as $h1
  | ([$raw[] | select(type == "object" and .t == "done" and (.ep // 0) >= $h1)] | length) as $m1
  | ([$raw[] | select(type == "object" and .t == "task" and .state == "done" and (.ep // 0) >= $h1) | .id]
     | unique | length) as $t1
  | ([$s.agents[].done[]? | .text // ""]) as $mdone
  | ([$mdone[] | select(startswith("⊢ "))] | length) as $mver
  | ([$s.agents[] | select(.status == "running")] | length) as $nrun
  # the metric and its history (same name); a linear ETA from the first reading, an estimate
  | (if ($metric.name // "") == "" then null
     else ([$raw[] | select(type == "object" and .t == "metric" and .name == $metric.name)] | sort_by(.ep // 0)) as $mh
       | ($metric.value | tonumber?) as $v | ($metric.target | tonumber?) as $tt
       | ($mh[0].value | tonumber?) as $v0 | (($metric.ep // $nowep) - ($mh[0].ep // $nowep)) as $el
       | {name:$metric.name, value:$v, target:$tt, note:($metric.note // ""),
          frac:(if $v != null and $tt != null and $tt > 0 then ([0, $v / $tt, 1] | sort | .[1]) else null end),
          history:[$mh[] | {ep:(.ep // 0), value:(.value | tonumber?), x:(.x // null)} | select(.value != null)],
          v0:(if ($mh | length) >= 2 then $v0 else null end),
          since:(if ($mh | length) >= 2 then $nowep - ($mh[0].ep // $nowep) else null end),
          # an estimate needs readings spread over time: 10 minutes at least, and none under
          # a minute (backfilled readings in one second once gave "0 minutes")
          eta:(if ($mh | length) >= 2 and $tt != null and $v != null and $v0 != null and $v > $v0 and $v < $tt and $el >= 600
               then (($tt - $v) / (($v - $v0) / $el)) | if . >= 60 then . else null end else null end)}
     end) as $M
  # needs you: a permission dialog, a failed or dead agent, a decision
  | ([ $s.agents[] | select(.wait) | {kind:"wait", id, name, text:.sess, age:null} ]
     + [ $s.agents[] | select((.wait | not) and (.status | IN("failed","dead")))
         | {kind:"fail", id, name, text:(.reason // ""), age:($nowep - (.endEp // .lastEp))} ]
     + [ $s.torder[] | $s.tasks[.] | select(.state == "ask")
         | {kind:"ask", id, name:"", text, age:($nowep - ($tep[.id] // $nowep))} ]) as $need
  # one record per working agent: what it does now, for how long, verified/claimed
  # milestones, flags (no code change, session disagrees); idle agents by name
  | (([ $diffs[] | {key:.id, value:.} ] | from_entries) as $df
     | [ $s.agents[] | select((.wait | not)
            and ((.status | IN("running","blocked")) or ((.sess // "") != "")))
         | . as $a | ($nowep - $a.lastEp) as $idle
         | ($df[$a.id] // null) as $d
         | ($idle >= ($stale | tonumber) and ($a.status | IN("running","blocked"))) as $silent
         | {id:$a.id, name:$a.name, status:$a.status, idle:$idle, silent:$silent,
            dn:($a.done | length), dv:([$a.done[] | select(.text | startswith("⊢ "))] | length),
            age:(if $a.status == "running" and $a.current then $nowep - $a.current.ep else $idle end),
            text:(if $a.status == "blocked" then (($a.reason // "") | ltrimstr("等：") | ltrimstr("等:")
                                                 | if startswith("等") then . else "等 " + . end)
                  elif $a.status == "running" and $a.current then ($a.current.text // "")
                  elif ($a.done | length) > 0 then "✓ " + ($a.done[-1].text // "") else ($a.reason // "") end),
            flag:([ (if $a.status == "running" and $d != null and ($nowep - $d.ep) >= $frz
                      then "无改动 " + (($nowep - $d.ep) | sdur) else empty end),
                    (if ($a.sess // "") != "" then "≠ " + $a.sess else empty end) ] | join(" · "))} ]
     | sort_by([(if .status == "blocked" then 0 elif .status == "running" then 1 else 2 end), -.idle])) as $act
  | ([ $s.agents[] | select((.wait | not) and .status == "done" and ((.sess // "") == "")) | {id, name} ]) as $idl
  | ([ $lroots[] as $root | $s.tasks[$root] as $rt
       | prog($s.tasks; leaves($s.tasks; $s.torder; $root)) as $rp
       | kids($s.tasks; $s.torder; $root) as $k0
       | [$k0[] | select($s.tasks[.].state == "done")] as $dk
       | ($dk[:-2]) as $fold
       | {text:$rt.text, d:$rp.d, t:$rp.t, folded:($fold | length),
          kids:[ $k0[] | select(. as $x | $fold | index($x) | not) | $s.tasks[.] as $t
                 | leaves($s.tasks; $s.torder; .) as $lv
                 | {text:$t.text, state:$t.state,
                    prog:(if ($lv | length) > 1 then prog($s.tasks; $lv) else null end)} ]} ]) as $trees
  # the goal: its first line is the title, the rest says what it is
  | (($s.goal | gsub("\r"; "") | split("\n")) as $gl
     | {title:($gl[0] // ""), about:($gl[1:] | map(select(. != "")))}) as $G
  | ([$raw[] | select(type == "object") | .ep // 0] | max // 0) as $lastEp
  | ($nowep - $lastEp) as $quiet
  # the last 24 hours in numbers
  | ($nowep - 86400) as $d1
  | ([$raw[] | select(type == "object" and (.ep // 0) >= $d1)]) as $day
  | {milestones:([$day[] | select(.t == "done")] | length),
     verified:([$day[] | select(.t == "done" and .verified == true)] | length),
     tasks:([$day[] | select(.t == "task" and .state == "done") | .id] | unique | length),
     metric:(if $M == null or ($M.history | length) < 2 or $M.value == null then null
             else (([$M.history[] | select(.ep < $d1)] | last | .value) // $M.history[0].value) as $vd
               | ($M.value - $vd) end)} as $D
  # what is off: a bottleneck (an issue or PR, #N, that two or more blocked agents wait
  # for), a silent running agent, no code change or a contradicting session, a board
  # nobody has written to while agents run
  | ([ $act[] | select(.status == "blocked")
       | .name as $n | [(.text | match("#[0-9]+"; "g") | .string)] | unique[] | {ref:., name:$n} ]
     | group_by(.ref) | map(select(length >= 2) | {ref:.[0].ref, names:map(.name)})) as $bott
  | ([ ($bott[] | {kind:"bottleneck", text:"\(.ref) 卡住 \(.names | join("、"))"}),
       ($act[] | select(.status == "running" and .silent) | {kind:"silent", text:"\(.name) \(.idle | sdur) 没有更新"}),
       ($act[] | select(.flag != "") | {kind:"flag", text:"\(.name) \(.flag)"}),
       (if $quiet >= ($stale | tonumber) and $nrun > 0
        then {kind:"board", text:"看板 \($quiet | ago)没有新事件，主控可能停了"} else empty end) ]) as $anom
  # the next open steps of the main line
  | ([ $trees[] | .kids[] | select(.state | IN("done","drop") | not) ][:3]) as $next
  | ([ (if ($need | length) > 0 then "需要你 \($need | length) 件" else "无需你处理" end),
       (if $M != null then "\($M.name) \($M.value)/\($M.target)"
            + (if $D.metric != null and $D.metric != 0
               then "，24 小时 " + (if $D.metric > 0 then "+" else "" end) + ($D.metric * 100 | round / 100 | tostring) else "" end)
            + (if $M.eta != null then "，约 \($M.eta | ago)达标（估）" else "" end)
        else "进度 \($tp.d)/\($tp.t)" end),
       (if ($anom | length) > 0 then "异常 \($anom | length)" else empty end) ] | join(" · ")) as $headline
  | if $view == "snapshot" then
      [ {goal:$s.goal, title:$G.title, about:$G.about, headline:$headline, quiet:$quiet,
         now:$nowep, clock:$now, progress:$tp, hour:{milestones:$m1, tasks:$t1}, day:$D,
         verified:{v:$mver, n:($mdone | length)}, running:$nrun, metric:$M, need:$need,
         anomalies:$anom, next:$next,
         agents:$act, idle:$idl, tasks:$trees, tasks_old:$nold,
         news:$s.news, checks:[$s.checks[] | {id, what, ok:(all(.steps[]; .state == "ok")),
           fail:any(.steps[]; .state == "fail"), startEp}]} | tojson ]
    else
  (if $m1 + $t1 > 0 then $g + "近 1 小时 里程碑 +\($m1) 任务 +\($t1)" + $rs
   elif $nrun > 0 then $y + "近 1 小时无新里程碑" + $rs
   else $dm + "近 1 小时无变化" + $rs end) as $move
  | (if $M == null then []
     else (if $M.frac != null then " ▕" + bar($M.frac; 1; 10) + "▏" + (($M.frac * 100) | floor | tostring) + "%" else "" end) as $bar
       | ([$M.history[].value] | .[-12:]) as $vals
       | (if ($vals | length) >= 2 then " " + ($vals | spark([$M.target // 0, max] | max)) else "" end) as $sp
       | (if $M.v0 != null then "  起 \($M.v0) · \($M.since | ago)前"
            + (if $M.eta != null then " · 按均速约 \($M.eta | ago)达标（估）" else "" end) else "" end) as $tr
       | ["│ " + $cy + ($M.name | clip(14)) + $rs + " \($metric.value) / \($metric.target)" + $bar + $sp
          + $dm + ($tr | clip([$bw - 50, 0] | max)) + $rs]
         + (if $M.note != "" then ["│   " + $dm + ($M.note | clip($bw - 6)) + $rs] else [] end)
     end) as $mlines
  | ("╰─ 进度 " + bar($tp.d; $tp.t; 16) + " \($tp.d)/\($tp.t)" + "   " + $now
     + (if $quiet >= 60 then " · 更新于 \($quiet | ago)前" else "" end)) as $bfoot
  | (if $G.title == "" then $top
     else ($G.title | clip($bw - 6)) as $tt | "╭─ " + $tt + " " + ("─" * ([$bw - 5 - ($tt | dwidth), 2] | max)) end) as $btop
  | ([$G.about[] | wrap($bw - 4)[] | "│ " + $dm + . + $rs]) as $babout
  | ("│ " + (if ($need | length) > 0 then $y elif ($anom | length) > 0 then $cy else $g end) + "▶ " + $headline + $rs) as $bhead
  | ("   " + $move + $dm + " · 里程碑 已核 \($mver) / 自报 \(($mdone | length) - $mver)" + $rs) as $bstat
  | (if ($need | length) > 0 then ["", $y + "需要你（\($need | length)）" + $rs]
       + [ $need[] | (if .age != null then $dm + " · 已 \(.age | ago)" + $rs else "" end) as $ag
                     | if .kind == "wait" then $y + "  ▲ " + $rs + (.name | clip(10) | pad(10)) + " " + (.text | clip($bw - 16))
                       elif .kind == "fail" then $r + "  ✗ " + $rs + (.name | clip(10) | pad(10)) + " " + (.text | clip($bw - 26)) + $ag
                       else $y + "  ? " + $rs + (.text | clip($bw - 16)) + $ag end ]
     else [] end) as $needb
  | (if ($act | length) + ($idl | length) == 0 then [] else
       ["", $cy + "agent" + $rs + $dm + "  ◔ \([$act[] | select(.status == "running")] | length)"
          + " · ▲ \([$act[] | select(.status == "blocked")] | length) · ○ \($idl | length)" + $rs]
       + [ $act[] | . as $a
           | ({"blocked":["▲",$y],"running":["◔",$cy],"done":["✓",$g]}[$a.status] // ["•",$dm]) as $ic
           | ($bw - 30 - (if $a.flag == "" then 0 else ($a.flag | dwidth) + 1 end)) as $tw
           | "  " + $ic[1] + $ic[0] + $rs + " " + ($a.name | clip(10) | pad(10))
             + (if $a.silent then $r else $dm end) + ($a.age | sdur | lpad(7)) + $rs
             + $dm + " ⊢\($a.dv)/\($a.dn)" + $rs + " "
             + (if $a.flag != "" then $y + $a.flag + $rs + " " else "" end)
             + ($a.text | clip([$tw, 8] | max)) ]
       + (if ($idl | length) > 0 then ["  " + $dm + "○ 空闲：" + ($idl | map(.name) | join(" ") | clip($bw - 12)) + $rs] else [] end)
     end) as $agb
  | (if ($trees | length) + $nold == 0 then [] else [""]
     + [ $trees[] | . as $tr
         | $cy + "■ " + ($tr.text | clip($bw - 25) | pad($bw - 25)) + $rs + " " + bar($tr.d; $tr.t; 12) + $dm + " \($tr.d)/\($tr.t)" + $rs,
           (if $tr.folded > 0 then $dm + "  ├─ ✓ 另 \($tr.folded) 项已完成" + $rs else empty end),
           (range(0; $tr.kids | length) as $i | $tr.kids[$i] as $t | ($TI[$t.state] // ["•",$dm]) as $ic
            | (if $i == ($tr.kids | length) - 1 then "  └─ " else "  ├─ " end) as $pre
            | $ic[1] + $pre + $ic[0] + " " + ($t.text | clip($bw - 26) | pad($bw - 26)) + $rs
              + (if $t.prog then bar($t.prog.d; $t.prog.t; 6) + $dm + " \($t.prog.d)/\($t.prog.t)" + $rs else "" end)) ]
     + (if $nold > 0 then [$dm + "✓ 另有 \($nold) 项已完成（1 小时前）" + $rs] else [] end) end) as $tasksb
  | (if ($next | length) > 0 then ["", $cy + "下一步" + $rs]
       + [ $next[] | ($TI[.state] // ["•",$dm]) as $ic | "  " + $ic[1] + $ic[0] + $rs + " " + (.text | clip($bw - 6)) ]
     else [] end) as $nextb
  | (if ($anom | length) > 0 then ["", $y + "异常（\($anom | length)）" + $rs]
       + [ $anom[] | "  " + $y + "! " + $rs + (.text | clip($bw - 6)) ] else [] end) as $anomb
  | ("   " + $dm + "24 小时：里程碑 +\($D.milestones)（已核 \($D.verified)） · 任务 +\($D.tasks)"
     + (if $D.metric != null then " · \($M.name) " + (if $D.metric >= 0 then "+" else "" end) + ($D.metric * 100 | round / 100 | tostring) else "" end)
     + $rs) as $bday
  | ([$btop] + $babout + [$bhead] + $mlines + [($bfoot | clip($bw)), $bstat]
     + $needb + $nextb + $anomb + $agb + ["", $bday]
     + (if ($s.news | length) > 0 then ["", $g + "进展" + $rs]
          + [ $s.news[-3:] | reverse[] | "  ✓ " + $dm + .time[0:5] + $rs + " " + (.text | clip($bw - 12)) ] else [] end)
     + $tasksb + $chk)
    end
end
| .[:$h] | .[]
'

dims() {
  if [ -n "${AWB_ROWS:-}" ] && [ -n "${AWB_COLS:-}" ]; then
    echo "$AWB_COLS $AWB_ROWS"
  elif [ -n "${TMUX_PANE:-}" ]; then
    # $TMUX_PANE names a pane of the server this process runs in ($TMUX); tm would prefer AWB_DIR's socket
    tmux display-message -p -t "$TMUX_PANE" '#{pane_width} #{pane_height}' 2>/dev/null
  else
    stty size 2>/dev/null | awk '{print $2, $1}'
  fi || echo "80 24"
}

# the log as a JSON array, tolerating a half-appended line from a concurrent writer
events_json() {
  { [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s \
    'rtrimstr("\n") | if . == "" then [] else split("\n")
       | map(fromjson? | select(type == "object" and has("t"))) end'
}

# directory of the real script (through the install symlink): clone root
src_dir() { cd "$(dirname "$BIN")" && cd "$(dirname "$(readlink "$BIN" 2>/dev/null || echo "$BIN")")" && pwd; }

# compiled Lean model (model/Main.lean), built with: cd model && lake build
model_bin() {
  _m=${AWB_MODEL:-$(src_dir)/model/.lake/build/bin/awbmodel}
  [ -x "$_m" ] && printf %s "$_m"
}

# per-agent state from the jq fold, same format as `awbmodel fold`
state() {
  init_dir
  events_json | jq -r "$JQ_FOLD"' fold | .agents | to_entries | sort_by(.key)[] | .value as $a
    | "\(.key) \($a.status) \($a.gate // false) \($a.endEp // "-") \(($a.done | last | .dur) // 0) \($a.done | length)"'
}

# protocol violations found by the verified Lean monitor (model/Audit.lean)
audit() {
  init_dir
  m=$(model_bin) || die "audit needs the Lean model: (cd $(src_dir)/model && lake build)"
  [ -s "$EV" ] || return 0
  "$m" audit < "$EV"
}

render() {
  set -- $(dims)
  cols=${1:-80}; rows=${2:-24}
  # live panes of the server awb uses; no reachable server = liveness unknown (null)
  if live=$(tm list-panes -a -F '#{pane_id}' 2>/dev/null); then
    live=$(printf '%s\n' "$live" | jq -Rn '[inputs | select(. != "")]')
  else
    live=null
  fi
  viol=; m=$(model_bin) && [ -s "$EV" ] && viol=$("$m" audit < "$EV" 2>/dev/null || true)
  # working-tree fingerprints written by freeze_once: "ID HASH EP" (epoch of
  # last change). Fed to render as data, never through the proven fold.
  if [ -s "$AWB_DIR/diffs" ]; then
    diffs=$(jq -Rn '[inputs | select(length > 0) | split(" ")
             | {id:.[0], hash:.[1], ep:(.[2] | tonumber)}]' < "$AWB_DIR/diffs")
  else diffs='[]'; fi
  events_json | jq -r --arg viol "$viol" \
    --argjson w "$cols" --argjson h "$rows" \
    --arg now "$(date +$TS_FMT)" --argjson nowep "$(date +%s)" \
    --arg prog "$PROG" --argjson live "$live" --arg view "${AWB_VIEW:-brief}" --arg stale "${AWB_STALE:-600}" \
    --argjson diffs "$diffs" --argjson frz "${AWB_FROZEN:-900}" --argjson sess "$(sessions_json)" \
    --arg g  "${ESC}[32m"  --arg cy "${ESC}[36m" --arg y "${ESC}[33m" \
    --arg r  "${ESC}[31m"  --arg dm "${ESC}[2m"  --arg rs "${ESC}[0m" \
    "$JQ_RENDER"
}

# no-code-change detection: runs on the nudge loop's cadence AWB_NUDGE_POLL
# (default 60 s). It fingerprints each agent's working tree and remembers the
# epoch of its LAST change in $AWB_DIR/diffs ("ID HASH EP"). A running agent
# unchanged for AWB_FROZEN seconds (default 900) is pasted at most ONE reminder
# per AWB_NUDGE_EVERY (default 900 s, throttled via $AWB_DIR/fnudged, "ID EP")
# — the 60 s poll cadence is not the reminder throttle. Blocked agents and
# non-git dirs are skipped. Working dir: $AWB_DIR/panes column 3 if present,
# else the live tmux pane path.
freeze_once() {
  init_dir
  command -v git >/dev/null || return 0
  lock "freeze"
  now=$(date +%s); frz=${AWB_FROZEN:-900}; every=${AWB_NUDGE_EVERY:-900}
  df=$AWB_DIR/diffs; nf=$AWB_DIR/fnudged
  # status straight from the (read-only) event log. A milestone `done` event is
  # NOT agent state: only `finish` emits status:"done", so the `done` event is
  # ignored here and a runner between milestones stays running (a `now` after a
  # real finish revives, mirroring nudge_once's fold).
  statuses=$( { [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s -r '
    rtrimstr("\n") | if . == "" then [] else split("\n") | map(fromjson? | select(type == "object")) end
    | reduce .[] as $e ({};
        if $e.id == null then .
        elif $e.t == "status" then .[$e.id] = $e.status
        elif $e.t == "now" then (if .[$e.id] == "done" then .[$e.id] = "running" else . end)
        else . end)
    | to_entries[] | "\(.key) \(.value)"')
  live=$(tm list-panes -a -F '#{pane_id}' 2>/dev/null || true)
  tmp=$(mktemp "${df}.XXXXXX")
  agent_panes | while read -r id pane; do
    [ -n "$id" ] && [ -n "$pane" ] || continue
    st=$(printf '%s\n' "$statuses" | awk -v i="$id" '$1 == i {print $2; exit}')
    # only a start event -> running (empty); nudge only live runners, so skip
    # every known non-running state and treat the rest as running.
    case $st in blocked|done|failed) continue ;; esac
    p=$(awk -v i="$id" 'index($0, i" ") == 1 && NF >= 3 {sub(/^[^ ]+ +[^ ]+ +/, ""); print; exit}' \
        "$AWB_DIR/panes" 2>/dev/null)
    if [ -z "$p" ]; then p=$(tm display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true); fi
    [ -n "$p" ] || continue
    if ! git -C "$p" rev-parse --git-dir >/dev/null 2>&1; then continue; fi
    h=$({ git -C "$p" rev-parse HEAD; git -C "$p" status --porcelain; git -C "$p" diff HEAD; } 2>/dev/null \
        | cksum | cut -d' ' -f1)
    old=$(awk -v i="$id" '$1 == i {print $2" "$3; exit}' "$df" 2>/dev/null || true)
    oldh=${old% *}; olde=${old#* }
    if [ -n "$oldh" ] && [ "$oldh" = "$h" ]; then ep=$olde; else ep=$now; fi
    printf '%s %s %s\n' "$id" "$h" "$ep" >> "$tmp"
    age=$((now - ep))
    if [ "$age" -lt "$frz" ]; then continue; fi
    last=$(awk -v i="$id" '$1 == i {print $2; exit}' "$nf" 2>/dev/null || true)
    if [ $((now - ${last:-0})) -lt "$every" ]; then continue; fi
    mins=$((age / 60))
    # tell() dies on a dead pane; a per-agent poll must not abort the whole
    # round (that would drop every agent's fingerprint). Check liveness first.
    if ! printf '%s\n' "$live" | grep -Fxq "$pane"; then continue; fi
    if tell "$id" "[看板自动提醒] 你已 ${mins} 分钟没有代码改动。若在等远端作业，awb block $id \"等：<作业>\"；否则把任务切到一个能 30 分钟内提交的最小 commit 先交。" 2>/dev/null; then
      printf '%s %s\n' "$id" "$now" >> "$nf"
    fi
  done
  # drop stale ids, keep the just-seen set
  if [ -s "$tmp" ]; then mv "$tmp" "$df"; else rm -f "$tmp"; fi
  if [ -s "$nf" ]; then
    awk 'NR==FNR {seen[$1]=1; next} ($1 in seen)' "$df" "$nf" > "$nf.new" && mv "$nf.new" "$nf"
  fi
  unlock "freeze"
}

# nudge: paste a reminder into the pane of every agent silent >= AWB_STALE,
# at most once per AWB_NUDGE_EVERY. Panes map: $AWB_DIR/panes, lines "ID PANE".
nudge_once() {
  freeze_once
  [ -s "$AWB_DIR/panes" ] || return 0
  now=$(date +%s)
  { [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s -r \
    --argjson now "$now" --argjson stale "${AWB_STALE:-600}" --argjson every "${AWB_NUDGE_EVERY:-900}" '
    rtrimstr("\n") | if . == "" then [] else split("\n") | map(fromjson? | select(type == "object")) end
    | reduce .[] as $e ({};
        if $e.id == null then .
        elif $e.t == "nudge" then .[$e.id].nudged = $e.ep
        elif $e.t == "status" then .[$e.id].last = $e.ep | .[$e.id].st = $e.status
        elif $e.t == "now" then .[$e.id].last = $e.ep | .[$e.id].st = (if .[$e.id].st == "done" then "running" else (.[$e.id].st // "running") end)
        elif ($e.t | IN("start","done")) then .[$e.id].last = $e.ep | .[$e.id].st = (.[$e.id].st // "running")
        else . end)
    | to_entries[]
    | select((.value.st // "running") == "running")
    | select($now - (.value.last // $now) >= $stale)
    | select($now - (.value.nudged // 0) >= $every)
    | "\(.key) \((($now - .value.last) / 60) | floor)"' |
  while read -r id mins; do
    msg="[看板自动提醒] 你（${id}）已 ${mins} 分钟没更新看板。请现在报一句结果：AWB_DIR=$AWB_DIR awb now $id \"<结果>\"；卡住用 awb block $id \"<原因>\"；做完用 awb finish $id \"<成果>\"。"
    tell "$id" "$msg" 2>/dev/null || continue
    append '{t:"nudge",time:$time,ep:$ep,id:$id}' --arg id "$id"
  done
}

watch() {
  printf '\033[?1049h\033[H\033[2J'
  # The board is rendered in full and scrolls: j/k, arrows or the mouse wheel by lines,
  # space/b by pages, g/G to the top/end, q quits. Keys are read with a timeout of one
  # refresh (stty time); the wheel arrives as SGR mouse reports, which tmux forwards once
  # the pane asks for them. Without a terminal on stdin the board just refreshes.
  kb=0; [ -t 0 ] && kb=1
  if [ $kb = 1 ]; then
    _stty=$(stty -g)
    stty -icanon -echo min 0 time "$(awk -v i="${AWB_INTERVAL:-1}" 'BEGIN { t = int(i * 10); print (t < 1 ? 1 : t) }')"
    printf '\033[?1000h\033[?1006h'
    trap 'printf "\033[?1000l\033[?1006l\033[?1049l"; stty "$_stty"' EXIT
  else
    # INT/TERM must end the loop (a bare trap on them ignored kill); EXIT restores the screen
    trap 'printf "\033[?1049l"' EXIT
  fi
  trap 'exit 130' INT TERM
  last=; synced=0; off=0; full=; rt=0
  # a board mirrored to Lark (awb-lark setup ran) syncs its topic once a minute, in the background
  lk=$(dirname "$(readlink "$BIN" 2>/dev/null || echo "$BIN")")/awb-lark
  [ -x "$lk" ] || lk=$(command -v awb-lark || true)
  # A tick starts a sync only when the last one has ended (its pid is in lock-lark); one
  # running for AWB_LARK_STALE seconds is killed with its lark-cli (model/tla/AwbLark.tla)
  while :; do
    if [ -n "$lk" ] && [ -s "${XDG_CONFIG_HOME:-$HOME/.config}/awb/lark-chat" ] \
       && [ $(($(date +%s) - synced)) -ge "${AWB_LARK_EVERY:-60}" ]; then
      synced=$(date +%s)
      lp=$(readlink "$AWB_DIR/lock-lark" 2>/dev/null || true)
      if [ -n "$lp" ] && kill -0 "$lp" 2>/dev/null; then
        la=$(stat -f %m "$AWB_DIR/lock-lark" 2>/dev/null || stat -c %Y "$AWB_DIR/lock-lark" 2>/dev/null || echo "$synced")
        if [ $((synced - la)) -ge "${AWB_LARK_STALE:-300}" ]; then
          pkill -TERM -P "$lp" 2>/dev/null || true; kill -TERM "$lp" 2>/dev/null || true
        fi
      else
        ( AWB="$BIN" "$lk" sync >/dev/null 2>&1 & )
      fi
    fi
    set -- $(dims); cols=${1:-80}; rows=${2:-24}
    # a key within the same second scrolls what is on screen instead of rendering again
    now=$(date +%s)
    if [ "$now" != "$rt" ] || [ -z "$full" ]; then
      rt=$now; full=$(AWB_COLS=$cols AWB_ROWS=5000 render)
    fi
    n=$(printf '%s\n' "$full" | wc -l | tr -d ' ')
    if [ "$n" -le "$rows" ]; then off=0; out=$full
    else
      max=$((n - rows + 1)); [ "$off" -le "$max" ] || off=$max; [ "$off" -ge 0 ] || off=0
      out=$(printf '%s\n' "$full" | sed -n "$((off + 1)),$((off + rows - 1))p")
      below=$((n - off - rows + 1))
      if [ "$below" -gt 0 ]; then hint="↓ 还有 $below 行 · j/k ↑↓ 滚轮 · 空格翻页 · g 顶部"
      else hint="↑ 上面 $off 行 · k ↑ 滚轮 · g 顶部"; fi
      out="$out
${ESC}[2m  ${hint}${ESC}[0m"
    fi
    if [ "$out" != "$last" ]; then
      last=$out
      printf '\033[H\033[2J%s' "$out"
    fi
    if [ $kb = 1 ]; then
      # one read can hold several keys (a fast wheel, typed ahead): take them in turn
      k=$(dd bs=256 count=1 2>/dev/null || true); i=0
      while [ -n "$k" ] && [ $i -lt 256 ]; do
        i=$((i + 1))
        case "$k" in
          "${ESC}["\<*)   # SGR mouse report: ESC [ < button ; x ; y M|m
            case "$k" in "${ESC}[<64;"*) off=$((off - 3)) ;; "${ESC}[<65;"*) off=$((off + 3)) ;; esac
            r=${k#*[Mm]}; [ "$r" != "$k" ] || r=; k=$r; continue ;;
          "${ESC}[A"*|"${ESC}OA"*) off=$((off - 1)); k=${k#???}; continue ;;
          "${ESC}[B"*|"${ESC}OB"*) off=$((off + 1)); k=${k#???}; continue ;;
          "${ESC}[5~"*) off=$((off - rows + 2)); k=${k#????}; continue ;;
          "${ESC}[6~"*) off=$((off + rows - 2)); k=${k#????}; continue ;;
        esac
        c=${k%"${k#?}"}; k=${k#?}
        case "$c" in
          q) exit 0 ;;
          k) off=$((off - 1)) ;;
          j) off=$((off + 1)) ;;
          " ") off=$((off + rows - 2)) ;;
          b) off=$((off - rows + 2)) ;;
          g) off=0 ;;
          G) off=$n ;;
        esac
      done
      [ "$off" -ge 0 ] || off=0
    else
      sleep "${AWB_INTERVAL:-1}"
    fi
  done
}

up() {
  command -v tmux >/dev/null || die "tmux not installed"
  init_dir
  SOCK=$(sock_path)
  if [ -S "$SOCK" ] && tmux -S "$SOCK" has-session -t awb 2>/dev/null; then
    exec tmux -S "$SOCK" attach-session -t awb
  fi
  rm -f "$SOCK"
  tmux -S "$SOCK" new-session -d -s awb -n board -P -F '#{pane_id}' \
    -e "AWB_DIR=$AWB_DIR" -e "AWB_TMUX_SOCKET=$SOCK" \
    "AWB_DIR=$(q "$AWB_DIR") AWB_TMUX_SOCKET=$(q "$SOCK") $(q "$BIN") watch" >/dev/null
  board=$(tmux -S "$SOCK" list-panes -t awb:board -F '#{pane_id}' | head -1)
  work=$(tmux -S "$SOCK" split-window -v -t "$board" -d -p 45 -P -F '#{pane_id}' \
           -e "AWB_DIR=$AWB_DIR" -e "AWB_TMUX_SOCKET=$SOCK" "$SHELL")
  printf '%s\n' "$work" > "$AWB_DIR/work-pane"
  tmux -S "$SOCK" select-pane -t "$board" -T board
  tmux -S "$SOCK" select-pane -t "$work"  -T work
  tmux -S "$SOCK" setw -t awb:board pane-border-status top
  tmux -S "$SOCK" setw -t awb:board pane-border-format ' #{?pane_title,#{pane_title},pane} '
  exec tmux -S "$SOCK" attach-session -t awb
}

run() {
  group=${AWB_GROUP:-default}
  case "${1:-}" in
    -g) [ $# -ge 2 ] || die "usage: $PROG run [-g GROUP] ID NAME -- CMD..."
        group=$2; shift 2 ;;
  esac
  [ $# -ge 3 ] || die "usage: $PROG run [-g GROUP] ID NAME -- CMD..."
  id=$1; name=$2; shift 2
  [ "${1:-}" = -- ] && shift
  [ $# -ge 1 ] || die "usage: $PROG run [-g GROUP] ID NAME -- CMD..."
  case $id in *[!A-Za-z0-9_-]* ) die "id must match [A-Za-z0-9_-] (got: $id)";; esac
  init_dir
  work=$(cat "$AWB_DIR/work-pane" 2>/dev/null) && [ -n "$work" ] || die "run '$PROG up' first"
  tm list-panes -t "$work" >/dev/null 2>&1 || die "work pane $work gone; restart with '$PROG up'"
  kind=$(basename -- "$1")
  cmdq=$(for a in "$@"; do printf '%s ' "$(q "$a")"; done)
  sock=${AWB_TMUX_SOCKET:-$(sock_path)}
  inner="AWB_DIR=$(q "$AWB_DIR") AWB_TMUX_SOCKET=$(q "$sock") AWB_GROUP=$(q "$group") \
AWB_AGENT_ID=$(q "$id") AWB_AGENT_NAME=$(q "$name") AWB_AGENT_KIND=$(q "$kind") \
$(q "$BIN") _enter; rc=0; $cmdq || rc=\$?; \
AWB_DIR=$(q "$AWB_DIR") $(q "$BIN") _leave \$rc; exec $(q "$SHELL")"
  pane=$(tm split-window -h -t "$work" -P -F '#{pane_id}' \
           -e "AWB_DIR=$AWB_DIR" -e "AWB_TMUX_SOCKET=$sock" -e "AWB_GROUP=$group" \
           -e "AWB_AGENT_ID=$id" -e "AWB_AGENT_NAME=$name" \
           -e "AWB_AGENT_KIND=$kind" "$inner")
  tm select-pane -t "$pane" -T "$name"
}

tui() {
  group=${AWB_GROUP:-default}
  case "${1:-}" in
    -g) [ $# -ge 2 ] || die "usage: $PROG tui [-g GROUP] ID NAME [TASK...]"
        group=$2; shift 2 ;;
  esac
  [ $# -ge 2 ] || die "usage: $PROG tui [-g GROUP] ID NAME [TASK...]"
  id=$1; name=$2; shift 2
  case $id in *[!A-Za-z0-9_-]* ) die "id must match [A-Za-z0-9_-] (got: $id)";; esac
  init_dir
  work=$(cat "$AWB_DIR/work-pane" 2>/dev/null) && [ -n "$work" ] || die "run '$PROG up' first"
  tm list-panes -t "$work" >/dev/null 2>&1 || die "work pane gone; restart with '$PROG up'"
  tui_cmd=${AWB_TUI_CMD:-$(command -v claude-db >/dev/null && echo claude-db || echo claude)}
  command -v "${tui_cmd%% *}" >/dev/null || die "$tui_cmd not on PATH (set AWB_TUI_CMD)"
  sock=${AWB_TMUX_SOCKET:-$(sock_path)}
  # resident TUI: register, run interactive claude, drop to shell on exit (pane stays)
  inner="AWB_DIR=$(q "$AWB_DIR") AWB_TMUX_SOCKET=$(q "$sock") AWB_GROUP=$(q "$group") \
AWB_AGENT_ID=$(q "$id") AWB_AGENT_NAME=$(q "$name") AWB_AGENT_KIND=claude \
$(q "$BIN") _enter; $tui_cmd; exec $(q "$SHELL")"
  pane=$(tm split-window -h -t "$work" -P -F '#{pane_id}' \
           -e "AWB_DIR=$AWB_DIR" -e "AWB_TMUX_SOCKET=$sock" -e "AWB_GROUP=$group" \
           -e "AWB_AGENT_ID=$id" -e "AWB_AGENT_NAME=$name" -e "AWB_AGENT_KIND=claude" \
           "$inner")
  tm select-pane -t "$pane" -T "$name"
  # first message: Chinese working rules + optional task.
  # paste via buffer — a plain Enter does not submit inside the claude TUI.
  task=$*
  # first line = the task; the main agent keeps the board from the worker's replies
  prompt="${task:-待命，等主控派任务}
（你是 awb 工作台上的 worker ${id}，组 ${group}，请用中文。任务会由主控发来；每个任务做完用一句话汇报结果，主控据此更新看板。完整规则：awb skill）"
  # Claude registers its pane in ~/.claude/sessions once it is ready, i.e. after startup
  # prompts such as folder trust, which awb leaves to the user. Then the first message goes
  # in, and the main agent messages the worker by that session name (SendMessage).
  i=0; sess=; warned=
  while [ $i -lt "${AWB_TUI_WAIT:-120}" ]; do
    sess=$(peers | awk -v i="$id" '$1 == i && $3 != "-" {print $3}')
    [ -n "$sess" ] && break
    if [ -z "$warned" ] && tm capture-pane -p -t "$pane" 2>/dev/null | grep -q "trust this folder"; then
      echo "$id: answer the folder-trust prompt in pane $pane; awb does not answer it"; warned=1
    fi
    sleep 1; i=$((i + 1))
  done
  [ -n "$sess" ] || { echo "$id: Claude not ready; message it later ('$PROG peers', '$PROG tell')"; return 0; }
  tell "$id" "$prompt"
  echo "$id session: $sess"
}

# ID PANE per agent: $AWB_DIR/panes ("ID PANE" lines, for agents started outside awb)
# overrides the pane of the latest start event
# mutual exclusion under $AWB_DIR (mkdir is atomic). Waits up to AWB_LOCK_WAIT seconds;
# a lock whose holder died is taken over. Released on exit. Races found in model/tla/.
# ponytail: takeover reads the pid then removes the dir, so two takers can race after a crash
lock() {
  _l=$AWB_DIR/lock-$1; _n=0
  until mkdir "$_l" 2>/dev/null; do
    _o=$(cat "$_l/pid" 2>/dev/null || true)
    if [ -n "$_o" ] && ! kill -0 "$_o" 2>/dev/null; then rm -rf "$_l"; continue; fi
    _n=$((_n + 1)); [ $_n -le $((${AWB_LOCK_WAIT:-600} * 5)) ] || die "$1 is locked by pid ${_o:-?}"
    sleep 0.2
  done
  echo $$ > "$_l/pid"
  LOCKS="${LOCKS:-} $_l"; trap 'rm -rf $LOCKS' EXIT; trap 'exit 130' INT TERM
}
# drop it from LOCKS too: otherwise this process's EXIT trap would later remove the lock
# another process has taken since, and a third one could enter
unlock() {
  rm -rf "$AWB_DIR/lock-$1"
  _k=; for _x in ${LOCKS:-}; do [ "$_x" = "$AWB_DIR/lock-$1" ] || _k="$_k $_x"; done; LOCKS=$_k
}

# the agent's open milestone ("EP TEXT" of its last `now`, if no `done` came after)
open_ms() {
  [ -s "$EV" ] || return 0
  grep -F "\"id\":\"$1\"" "$EV" | grep -E '"t":"(now|done)"' | tail -1 | jq -R -r 'fromjson? | select(.t == "now") | "\(.ep) \(.text)"'
}

# dispatch/report loop with a worker over the session socket (model/tla/AwbLoop.tla):
# one open task per worker, each with a key its reply must echo; an idle notice never closes a
# task: the first makes the main ask once, the second marks the task blocked for the user.
open_key() {
  [ -s "$EV" ] || return 0
  grep -F "\"id\":\"$1\"" "$EV" | grep -E '"t":"(now|done)"' | tail -1 | jq -R -r 'fromjson? | select(.t == "now") | .key // empty'
}
send() {
  [ $# -ge 2 ] || die "usage: $PROG send ID TASK   (prints the message to SendMessage)"
  id=$1; shift; init_dir
  k=$(open_key "$id"); [ -z "$k" ] || die "$id already has open task #$k; wait for its reply (or: $PROG idle $id)"
  k=$(date +%s | tail -c 5)$(printf %02d $(( $$ % 100 )))
  append '{t:"now",time:$time,ep:$ep,id:$id,text:$x,key:$k}' --arg id "$id" --arg x "$*" --arg k "$k"
  printf '[awb %s#%s] %s\n做完后回复一行：以 [awb %s#%s] 开头，写结果（做不了也照此格式说明原因）。\n' "$id" "$k" "$*" "$id" "$k"
}
reply() {
  [ $# -ge 2 ] || die "usage: $PROG reply ID KEY [RESULT]"
  id=$1; k=$2; shift 2; init_dir
  [ "$(open_key "$id")" = "$k" ] || die "no open task #$k for $id (stale or duplicate reply): ignored"
  append '{t:"done",time:$time,ep:$ep,id:$id,text:(if $x == "" then null else $x end),key:$k}' \
    --arg id "$id" --arg x "$*" --arg k "$k"
  echo "closed $id #$k"
}
idle() {
  [ $# -ge 1 ] || die "usage: $PROG idle ID"
  id=$1; init_dir
  k=$(open_key "$id"); [ -n "$k" ] || { echo "$id: no open task"; return 0; }
  if grep -F "\"id\":\"$id\"" "$EV" | grep -F '"t":"ask"' | grep -qF "\"key\":\"$k\""; then
    append '{t:"status",time:$time,ep:$ep,id:$id,status:"blocked",reason:$r}' --arg id "$id" \
      --arg r "空闲两次仍未汇报 #${k}：消息可能在对方会话里等用户批准，请用户去看"
    echo "blocked $id #$k: tell the user (the worker's session may be holding the message for approval)"
  else
    append '{t:"ask",time:$time,ep:$ep,id:$id,key:$k}' --arg id "$id" --arg k "$k"
    printf '[awb %s#%s] 请汇报这个任务的结果：以 [awb %s#%s] 开头回复一行。\n' "$id" "$k" "$id" "$k"
  fi
}
pending() {
  init_dir
  st=$(peers)
  for id in $(agent_panes | cut -d' ' -f1; [ -s "$EV" ] && jq -R -r 'fromjson? | select(.t == "start") | .id' "$EV"); do echo "$id"; done | awk '!s[$0]++' |
  while read -r id; do
    k=$(open_key "$id"); [ -n "$k" ] || continue
    printf '%s #%s %s\n' "$id" "$k" "$(printf '%s\n' "$st" | awk -v i="$id" '$1 == i {print $3, $4}')"
  done
}

# open a PR for an agent's work from the current git checkout, only when the agent's
# latest `awb check` passed; the body lists its milestones and that check's steps
pr() {
  [ $# -ge 1 ] || die "usage: $PROG pr ID [gh pr create args...]"
  id=$1; shift; init_dir
  lock "gate-$id"     # no check of this agent can interleave between the gate and the PR
  info=$({ [ -s "$EV" ] && cat "$EV" || true; } | jq -R -s --arg id "$id" '
    [split("\n")[] | fromjson? | select(type == "object" and .id == $id)] as $es
    | ([$es[] | select(.t == "chk")] | group_by(.run) | sort_by(.[0].ep) | last // []) as $run
    | ($run | reduce .[] as $e ({o:[], s:{}};
        (if .s[$e.step] == null then .o += [$e.step] else . end) | .s[$e.step] = $e.state)) as $st
    | (reduce $es[] as $e ({cur:null, ms:[]};
        if $e.t == "now" then .cur = $e.text
        elif $e.t == "done" and $e.verified and .cur == null and $e.text == null and (.ms | length) > 0
          then .ms[-1] |= (if startswith("⊢ ") then . else "⊢ " + . end)
        elif $e.t == "done" then .ms += [(if $e.verified then "⊢ " else "" end) + ($e.text // .cur // "milestone")] | .cur = null
        else . end) | .ms) as $ms
    | {pass: (($st.o | length) > 0 and all($st.s[]; . == "ok")),
       name: ([$es[] | select(.t == "start") | .name] | first // $id),
       title: ($ms | last // "" | ltrimstr("⊢ ")),
       body: ("## Milestones\n" + ([$ms[] | "- " + .] | join("\n"))
              + "\n\n## Acceptance\n`" + ($run[0].what // "") + "`: "
              + ([$st.o[] | . + " " + (if $st.s[.] == "ok" then "✓" else "✗" end)] | join(" → ")))}')
  [ "$(printf '%s' "$info" | jq -r .pass)" = true ] || die "$id has no passing awb check; run '$PROG check $id ...' first"
  if m=$(model_bin); then
    v=$("$m" audit < "$EV" | awk -v i="$id" '$1 == i {print $2}' | sort -u | tr '\n' ' ')
    [ -z "$v" ] || die "audit: $id has protocol violations: $v"
  fi
  br=$(git rev-parse --abbrev-ref HEAD) || die "not a git checkout"
  def=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name) || die "gh cannot see this repo"
  [ "$br" != "$def" ] || die "on $def; commit the agent's work on a branch first"
  git push -q -u origin HEAD
  url=$(gh pr create --title "$(printf '%s' "$info" | jq -r '.name + ": " + .title')" \
    --body "$(printf '%s' "$info" | jq -r .body)" "$@") || return 1
  echo "$url"
  append '{t:"pr",time:$time,ep:$ep,id:$id,url:$u}' --arg id "$id" --arg u "$url"
}

# board beside the current tmux pane (the conversation), for chat-driven use
board() {
  init_dir; [ -f "$EV" ] || : > "$EV"
  if [ -z "${TMUX_PANE:-}" ]; then
    echo "not in tmux; watch it from another terminal: AWB_DIR=$AWB_DIR $PROG watch"; return 0
  fi
  printf '%s\n' "$TMUX_PANE" > "$AWB_DIR/work-pane"      # awb tui/run split from here
  tmux split-window -h -d -l 45% -t "$TMUX_PANE" "AWB_DIR=$(q "$AWB_DIR") $(q "$BIN") watch"
  echo "board: $AWB_DIR (right of this pane)"
}

# the agent manual: the skill next to the real script (clone), else the installed skill
skill() {
  for f in "$(src_dir)/skills/awb-workbench/SKILL.md" \
           "${AWB_SKILL_DIR:-$HOME/.claude/skills}/awb-workbench/SKILL.md"; do
    [ -f "$f" ] && { cat "$f"; return 0; }
  done
  echo "manual: https://github.com/cklxx/awb/blob/main/skills/awb-workbench/SKILL.md"
  echo "install it: curl -fsSL https://raw.githubusercontent.com/cklxx/awb/main/install.sh | sh"
}

agent_panes() {
  # a torn (half-appended) line is skipped, as in events_json
  { [ -s "$EV" ] && jq -R -r 'fromjson? | select(.t=="start" and (.pane // "") != "") | "\(.id) \(.pane)"' "$EV"
    [ -s "$AWB_DIR/panes" ] && awk 'NF >= 2 {print $1, $2}' "$AWB_DIR/panes"; } \
  | awk '{ p[$1] = $2; if (!($1 in o)) o[$1] = NR } END { for (i in p) print o[i], i, p[i] }' \
  | sort -n | cut -d' ' -f2- \
  | M=$(tm list-panes -a -F '#{session_name}:#{window_index}.#{pane_index} #{pane_id}' 2>/dev/null || true) \
    awk 'BEGIN { n = split(ENVIRON["M"], L, "\n"); for (i = 1; i <= n; i++) { split(L[i], f, " "); id[f[1]] = f[2] } }
         { print $1, (($2 in id) ? id[$2] : $2) }'
  # ponytail: session:window.pane targets resolve to pane ids (%N), which tell, peers and the
  # session registry use; other target forms (window names) pass through unresolved
}
agent_pane() { agent_panes | awk -v i="$1" '$1 == i {print $2}'; }

# type a message into an agent's TUI (claude, codex, any): a named buffer, then Enter.
# Claude queues it if a turn is running. Plain send-keys Enter does not submit in claude.
tell() {
  [ $# -ge 2 ] || die "usage: $PROG tell ID MESSAGE"
  _id=$1; shift; init_dir
  _msg=$*
  _p=$(agent_pane "$_id")
  [ -n "$_p" ] && tm list-panes -a -F '#{pane_id}' 2>/dev/null | grep -qx "$_p" || die "$_id has no live pane"
  # Typed text + Enter answers a permission dialog (Enter picks the highlighted "Yes"), so
  # the registry is read again before every keystroke: a dialog reported before a key is
  # never typed into (model/tla/AwbWait.tla). One that opens between the read and the key
  # still takes it; no check can close that window.
  _dialog() { [ "$(sessions_json | jq -r --arg i "$_id" '.[$i].status // ""')" = waiting ]; }
  if _dialog; then   # return, not die: check and nudge call tell as a function
    echo "$PROG: $_id is waiting on a permission dialog; answer it in pane $_p, awb will not type into it" >&2
    return 1
  fi
  # one tell per pane at a time, each with its own buffer: concurrent tells merged or lost
  # messages otherwise (model/tla/AwbTell.tla)
  lock "tell-$_p"
  printf '%s' "$_msg" | tm load-buffer -b "awb-tell-$$" -
  tm paste-buffer -p -d -b "awb-tell-$$" -t "$_p"
  # Confirm the paste actually submitted. A TUI can keep it in the input box
  # after one Enter: Claude leaves the text (or a collapsed "[Pasted text #N
  # +K lines]" placeholder) on the PROMPT line, with a divider and a ⏵⏵ footer
  # below it -- so the input is NOT the last screen line. We therefore inspect
  # the last line that begins with a prompt (❯ Claude / > codex/shell); if
  # absent, fall back to the last non-empty line. capture -J joins wrapped
  # lines so a long paste is read as one prompt line. That prompt line still
  # showing the pasted tail or a collapsed-paste placeholder = unsubmitted ->
  # re-send Enter, up to AWB_TELL_MAX_ENTER. A submitted command moves off it
  # (echoed command runs -> output / empty prompt), so shells are not retried.
  _probe=$(printf '%s' "$_msg" | jq -Rr '.[-60:]')  # char-safe tail; UTF-8 safe
  _try=1; _max=${AWB_TELL_MAX_ENTER:-2}
  # capture the prompt/input line: last line starting with ❯ or >, else last non-empty
  _inputline() {
    tm capture-pane -J -p -t "$_p" 2>/dev/null       | awk 'NF {l=$0; if ($0 ~ /^[[:space:]]*(❯|>)/) p=$0} END{ if (p != "") print p; else print l }'
  }
  _unsubmitted() { # $1 = input line -> 0 if it still holds the unsubmitted paste
    case "$1" in
      *"[Pasted text #"*) return 0 ;;
      *"$_probe"*) return 0 ;;
      *) return 1 ;;
    esac
  }
  # every Enter re-reads the registry first (model/tla/AwbWait.tla, MaxEnter = 2)
  _enter() {
    if _dialog; then
      echo "$PROG: $_id opened a permission dialog mid-tell; text left unsent in pane $_p" >&2
      return 1
    fi
    tm send-keys -t "$_p" Enter
  }
  sleep ${AWB_TELL_SETTLE:-0.5}
  _enter || { unlock "tell-$_p"; return 1; }
  while [ "$_try" -lt "$_max" ]; do
    sleep ${AWB_TELL_SETTLE:-0.5}
    _il=$(_inputline)
    if _unsubmitted "$_il"; then _try=$((_try + 1)); _enter || { unlock "tell-$_p"; return 1; }
    else _try=$_max; fi
  done
  _il=$(_inputline)
  if _unsubmitted "$_il"; then
    # return, not die: check/nudge call tell as a function and must keep going
    # (a die here would abort check's logging or skip the rest of a nudge round)
    printf '%s: %s tell not submitted after %s Enter; text still in input box: %s
'       "$PROG" "$_id" "$_max" "$_il" >&2
    unlock "tell-$_p"
    return 1
  fi
  unlock "tell-$_p"
}

# Claude Code sessions of awb agents, read from ~/.claude/sessions (never written):
# {ID: {name, status, waiting, since}}, status busy|idle|waiting|shell. One pass over the
# registry; an entry being rewritten or of a dead pid is skipped. Pane ids are unique per
# tmux server; the registry keeps the session a pane started in (panes move), so the session
# name is matched only on awb's own server, where ids collide. Always prints JSON.
sessions_json() {
  _panes=$(tm list-panes -a -F '#{pane_id} #{session_name}' 2>/dev/null) || { echo '{}'; return 0; }
  _strict=0; { [ -n "${AWB_TMUX_SOCKET:-}" ] || [ -S "$(sock_path)" ]; } && _strict=1
  { awk 1 "$HOME"/.claude/sessions/*.json 2>/dev/null || true; } | jq -Rnc \
    --arg ag "$(agent_panes)" --arg panes "$_panes" --argjson strict "$_strict" \
    --arg pids " $(ps -Ao pid= | tr -s ' \n' '  ') " '
    [inputs | fromjson? | select(type == "object" and (.tmux | type) == "string"
                                 and (" \(.pid) " as $k | $pids | contains($k)))] as $reg
    | ($panes | split("\n") | map(select(. != "") | split(" ") | {key:.[0], value:.[1]}) | from_entries) as $sn
    | [ $ag | split("\n")[] | select(. != "") | split(" ") | .[0] as $id | .[1] as $p
        | ($sn[$p] // null) as $s | select($s != null)
        | ([$reg[] | select((.tmux | endswith("." + $p)) and ($strict == 0 or (.tmux | startswith($s + ":"))))]
           | max_by(.startedAt // 0)) as $r
        | select($r != null)
        | {key:$id, value:{name:$r.name, status:$r.status, waiting:($r.waitingFor // ""),
                           since:((($r.statusUpdatedAt // 0) / 1000) | floor)}} ]
    | from_entries' 2>/dev/null || echo '{}'
}

# awb agents that are Claude Code sessions: ID PANE SESSION-NAME STATUS. A main Claude
# agent messages them over Claude's own session socket with SendMessage(to: SESSION-NAME).
peers() {
  init_dir
  _s=$(sessions_json); _l=$(tm list-panes -a -F '#{pane_id}' 2>/dev/null || true)
  agent_panes | while read -r id pane; do
      printf '%s\n' "$_l" | grep -Fxq "$pane" || { echo "$id $pane - gone"; continue; }
      printf '%s' "$_s" | jq -r --arg i "$id" --arg p "$pane" \
        '.[$i] | if . then "\($i) \($p) \(.name) \(.status)" else "\($i) \($p) - not-claude" end'
    done
}

# one acceptance step for the board: step NAME run|ok|fail [NOTE]
step() {
  append '{t:"chk",time:$time,ep:$ep,id:$id,run:$run,what:$what,step:$s,state:$st,note:$n}' \
    --arg id "$CHK_ID" --arg run "$CHK_RUN" --arg what "$CHK_WHAT" --arg s "$1" --arg st "$2" --arg n "${3:-}"
}

# run a step: stage NAME CMD... ; its output goes to the check log
stage() {
  _n=$1; shift; step "$_n" run
  if "$@"; then step "$_n" ok; else step "$_n" fail "$(tail -1 "$CHK_LOG" | cut -c1-80)"; return 1; fi
}

# Lean 4 acceptance, run in DIR. The build is kernel-checked; ACCEPT.lean holds the
# main agent's statements, which must typecheck against the build and use only the
# standard axioms (#print axioms follows every dependency, so sorryAx, custom axioms
# and native_decide in the agent's code are caught).
# ponytail: theorems are found by regex, not by enumerating the environment
# (`import Lean` costs ~4s per check); anything unrecognised fails closed.
lean_sorry() {
  ! grep -rnwE 'sorry|admit' --include='*.lean' --exclude-dir=.lake . || { echo "sorry/admit in sources"; return 1; }
}
lean_types() {
  _t='^[[:space:]]*(@\[[^]]*\][[:space:]]*)*((private|protected|nonrec)[[:space:]]+)*theorem[[:space:]]+'
  grep -qwE 'example|namespace|section|lemma' "$1" && { echo "ACCEPT: use top-level named theorems only"; return 1; }
  _names=$(grep -E "$_t" "$1" | sed -E "s/$_t([^[:space:](:{]+).*/\4/")
  [ -n "$_names" ] || { echo "ACCEPT.lean has no theorem"; return 1; }
  [ "$(grep -cwE 'theorem' "$1")" = "$(printf '%s\n' "$_names" | wc -l | tr -d ' ')" ] \
    || { echo "ACCEPT: unrecognised theorem syntax"; return 1; }
  { cat "$1"; echo; printf '#print axioms %s\n' $_names; } > .awb-accept.lean
  _rc=0; lake env lean .awb-accept.lean > .awb-accept.out 2>&1 || _rc=$?
  rm -f .awb-accept.lean; cat .awb-accept.out
  [ "$_rc" = 0 ] || { echo "acceptance statements do not typecheck"; return 1; }
  ! grep -q "declaration uses 'sorry'" .awb-accept.out || { echo "sorry in ACCEPT"; return 1; }
}
lean_axioms() {
  _bad=$(sed -n 's/.*depends on axioms: \[\(.*\)\].*/\1/p' .awb-accept.out | tr ',' '\n' \
         | tr -d ' ' | grep -vxE 'propext|Classical\.choice|Quot\.sound' | sort -u | tr '\n' ' ')
  rm -f .awb-accept.out
  [ -z "$_bad" ] || { echo "non-standard axioms: $_bad"; return 1; }
  echo "axioms ok"
}
lean_accept() (
  dir=$1; acc=${2:-}
  [ -z "$acc" ] || acc=$(cd "$(dirname "$acc")" && pwd)/$(basename "$acc")
  PATH=$HOME/.elan/bin:$PATH
  cd "$dir" || exit 1
  stage build lake build || exit 1
  stage sorry lean_sorry || exit 1
  [ -n "$acc" ] || exit 0
  stage types lean_types "$acc" || exit 1
  stage axioms lean_axioms || exit 1
)

# acceptance gate: the check the main agent chose decides done, not the agent's claim
check() {
  [ $# -ge 3 ] || die "usage: $PROG check ID -- CMD... | $PROG check ID --lean DIR [ACCEPT.lean]"
  id=$1; shift
  case $1 in
    --lean) what="lean ${3:+$(basename "$3")}"; set -- lean_accept "$2" "${3:-}" ;;
    --) shift; what=$*; set -- stage cmd "$@" ;;
    *) die "usage: $PROG check ID -- CMD... | $PROG check ID --lean DIR [ACCEPT.lean]" ;;
  esac
  init_dir
  lock "gate-$id"     # one check or pr per agent at a time (model/tla/AwbCheck.tla)
  ms=$(open_ms "$id")
  CHK_ID=$id CHK_RUN=$(date +%s)$$ CHK_WHAT=$what CHK_LOG=$AWB_DIR/check-$id.log
  export CHK_ID CHK_RUN CHK_WHAT CHK_LOG
  rc=0; "$@" >"$CHK_LOG" 2>&1 || rc=$?
  # a pass verifies the milestone it started on; if the agent moved on meanwhile, it is stale
  if [ "$rc" = 0 ] && [ "$(open_ms "$id")" != "$ms" ]; then
    rc=97; echo "stale: milestone changed during the check (was: ${ms#* }); re-run the check" >> "$CHK_LOG"
  fi
  if [ "$rc" = 0 ]; then
    append '{t:"done",time:$time,ep:$ep,id:$id,text:null,verified:true}' --arg id "$id"
    echo "accepted: $what"
  else
    why=$(grep -v '^[[:space:]]*$' "$CHK_LOG" | tail -1 | cut -c1-120)
    [ -n "$why" ] || why="exit $rc"
    append '{t:"status",time:$time,ep:$ep,id:$id,status:"failed",reason:$r,gate:true}' \
      --arg id "$id" --arg r "验收未过($what): $why"
    # tell the agent, unless the agent ran the check itself and already sees the output
    if [ "${AWB_NOTIFY:-1}" = 1 ] && [ "$(agent_pane "$id")" != "${TMUX_PANE:-}" ]; then
      tell "${id}" "awb 验收未过（${what}）：${why}。完整日志：${CHK_LOG}。修复后重新验收：awb check ${id} ..." 2>/dev/null \
        && echo "notified $id" || true
    fi
    tail -40 "$CHK_LOG"; echo "rejected: $what (full log: $CHK_LOG)"; return 1
  fi
}

_enter() {
  [ -n "${AWB_AGENT_ID:-}" ] || die "_enter: AWB_AGENT_ID unset"
  append '{t:"start",time:$time,ep:$ep,id:$id,name:$name,kind:$kind,pane:$pane,group:$group}' \
    --arg id "$AWB_AGENT_ID" --arg name "${AWB_AGENT_NAME:-$AWB_AGENT_ID}" \
    --arg kind "${AWB_AGENT_KIND:-agent}" --arg pane "${TMUX_PANE:-}" \
    --arg group "${AWB_GROUP:-default}"
}

_leave() {
  code=${1:-0}
  if [ "$code" = 0 ]; then
    append '{t:"status",time:$time,ep:$ep,id:env.AWB_AGENT_ID,status:"done",reason:""}'
  else
    append '{t:"status",time:$time,ep:$ep,id:env.AWB_AGENT_ID,status:"failed",reason:$r}' \
      --arg r "exit $code"
  fi
}

usage() {
  cat <<EOF
$PROG $VERSION — tmux agent workbench (events in .awb/events.jsonl)
Agents: read the operating manual with '$PROG skill' before driving the board.

Chat-driven: you talk to one Claude (the main agent); it keeps the board and runs workers:
  $PROG board                       board beside the main agent's tmux pane
  $PROG tui ID NAME                 start a Claude worker; prints its session name
  msg=\$($PROG send ID "task"); SendMessage(to: <session>, message: \$msg, notify_when_idle: true);
  on a reply "[awb ID#KEY] ...": $PROG reply ID KEY "result"; on an idle notice: $PROG idle ID.
  Several boards: one .awb per project dir, or \$AWB_DIR.

  $PROG up                          tmux session: milestone board + work area
  $PROG down                        kill the session
  $PROG run [-g GROUP] ID NAME -- CMD...
                                    split a pane for any agent (claude, codex, ...)
  $PROG tui [-g GROUP] ID NAME [TASK...]
                                    resident interactive claude TUI, Chinese, tracked
                                    (AWB_TUI_CMD, default claude-db if on PATH else claude)
  $PROG start ID NAME [KIND] [GROUP]  register a non-pane / remote agent
  $PROG goal TEXT                   set the overall goal
  $PROG stale                       print "ID MINUTES" for running agents silent >= AWB_STALE,
                                    and "ID MINUTES waiting" for agents on a permission dialog
  $PROG nudge [--once]              remind silent agents in their pane ($AWB_DIR/panes: "ID PANE")
  $PROG news TEXT                   one progress line (board shows last 5)
  $PROG metric [--at EPOCH] [--step N] NAME VALUE TARGET [NOTE]
                                    single value/target bar under GOAL (brief view)
                                    board view: AWB_VIEW=brief (default) | full
                                    AWB_STALE=SECS: list agents silent that long (default 600)
  $PROG task ID STATE [TEXT] [PARENT] [OWNER]
                                    task tree node; STATE todo|wip|review|blocked|done|drop;
                                    re-issue to update (empty args keep old values)
  $PROG now ID MILESTONE            set agent's current objective
  $PROG done ID [TEXT]              milestone achieved
  $PROG block ID REASON             mark blocked
  $PROG unblock ID                  back to running
  $PROG fail ID REASON
  $PROG finish ID [NOTE]            close milestone + mark done
  $PROG tell ID MESSAGE             type a message into the agent's TUI pane (claude, codex, ...)
  $PROG peers                       agents that are Claude sessions: ID PANE SESSION STATUS
                                    (message them with SendMessage from a Claude main agent)
  $PROG send ID TASK                open a keyed task; prints the message for SendMessage
  $PROG reply ID KEY [RESULT]       close the task whose key the worker's reply echoes
  $PROG idle ID                     on an idle notice: prints an ask once, then marks blocked
  $PROG pending                     open tasks with keys and worker session/status
  $PROG pr ID [gh args...]          push this branch and open a PR, only after a passing check
  $PROG board                       split a board pane beside the current tmux pane
  $PROG state | audit               jq fold per agent | protocol violations (Lean monitor)
  $PROG version | skill             version | the agent operating manual (SKILL.md)
  $PROG check ID -- CMD...          acceptance gate: CMD exit 0 -> milestone done (⊢), else failed
  $PROG check ID --lean DIR [ACCEPT.lean]
                                    Lean 4 gate: lake build, no sorry, ACCEPT.lean theorems
                                    typecheck with standard axioms only
  $PROG render | watch              one-shot render | render loop (board pane)
  $PROG snapshot                    the brief view as JSON (awb-lark builds its card from it)
  $PROG reset                       clear all events (fresh board)
  $PROG selftest
EOF
}

selftest() {
  t=$(mktemp -d)
  S=awbselftest$$
  cleanup() { tmux -L "$S" kill-server 2>/dev/null || true; rm -rf "$t"; }
  trap cleanup EXIT
  export AWB_DIR=$t AWB_COLS=160 AWB_ROWS=200; EV=$t/events.jsonl
  # never the user's Lark group: a test board's watch loop would mirror itself there. A
  # guard lark-cli first on PATH records any call that escapes the fakes below.
  XDG_CONFIG_HOME=$t/xdg-none; export XDG_CONFIG_HOME
  mkdir -p "$t/guard"; printf '#!/bin/sh\necho "$*" >> %s/guard/calls\nexit 1\n' "$t" > "$t/guard/lark-cli"
  chmod +x "$t/guard/lark-cli"; PATH=$t/guard:$PATH; export PATH

  ( cd "$t" && AWB_DIR=help-probe "$BIN" up --help >/dev/null ) || die "selftest: up --help failed"
  [ ! -e "$t/help-probe" ] || die "selftest: up --help created AWB_DIR"
  ( cd "$t" && AWB_DIR=help-probe "$BIN" --help >/dev/null ) || die "selftest: --help failed"
  [ ! -e "$t/help-probe" ] || die "selftest: --help ran a command (created AWB_DIR)"
  "$BIN" goal "SHIP THE WORKBENCH"
  "$BIN" start a1 claude agent backend
  "$BIN" now a1 "wire event log"
  sleep 1
  "$BIN" done a1
  "$BIN" now a1 "render board"
  "$BIN" start a2 codex agent frontend
  "$BIN" block a2 "waiting on review"
  "$BIN" task r todo root
  "$BIN" task l1 done leaf r
  "$BIN" task l0 wip open r
  "$BIN" task l0 wip "" r
  "$BIN" task l1 done "" r
  out=$(AWB_VIEW=full "$BIN" render)
  brief=$("$BIN" render)
  for s in "■ root" "进度" "◔ 1 · ▲ 1 · ○ 0" ; do printf "%s" "$brief" | grep -Fq -- "$s" || die "selftest: brief missing $s"; done
  for s in "SHIP THE WORKBENCH" "✓ wire event log" "▸ render board" \
           "▲ waiting on review" "2 agents" "✓0" "◔1" "▲1" "◆ backend" "◆ frontend" "■ root" "├─ ✓ leaf" "└─ ◔ open" "1/2 任务"; do
    printf '%s' "$out" | grep -Fq -- "$s" || die "selftest: missing '$s'"
  done
  printf '%s' "$out" | grep -Eq '1s| [0-9]:[0-9][0-9]' || die "selftest: no durations"

  # the brief view answers: how far and moving (metric trend, ETA, last hour), what needs
  # you (above the agents), what each agent does now, what is folded away. Own log, so
  # the assertions below keep their state.
  bd=$t/brief; mkdir -p "$bd"; bb() { AWB_DIR=$bd "$BIN" "$@"; }; bn=$(date +%s)
  bb goal "$(printf 'GOAL-TITLE\nwhat-it-is line')"; bb start w1 worker; bb now w1 "tuning kernel"
  bb start w2 waiter; bb now w2 "x"; bb block w2 "等：review #9"
  bb start w3 idler; bb finish w3 "shipped"
  bb start w5 waiter2; bb now w5 "y"; bb block w5 "等 #9 合入"
  bb task main todo "main line"; for i in 1 2 3 4; do bb task "d$i" done "done-$i" main; done
  bb task o1 wip "open one" main; bb task q1 ask "pick a config"
  { printf '{"t":"task","id":"old","state":"done","text":"ancient root","ep":%s}\n' $((bn - 7200))
    printf '{"t":"metric","name":"tps","value":10,"target":40,"ep":%s}\n' $((bn - 400000))
    printf '{"t":"metric","name":"tps","value":20,"target":40,"ep":%s}\n' $((bn - 200000)); } >> "$bd/events.jsonl"
  bb metric tps 25 40 "live"
  # a backfilled older reading (--at) joins the history without replacing the newest
  bb metric --at $((bn - 500000)) --step 100 tps 5 40
  ! bb metric --at yesterday tps 1 40 2>/dev/null || die "selftest: metric --at accepted a non-epoch"
  b=$(bb render | sed 's/\x1b\[[0-9;]*m//g')
  for s in "tuning kernel" "等 review #9" "○ 空闲：idler" "另 2 项已完成" "另有 1 项已完成" \
           "近 1 小时 里程碑 +" "达标（估）" "? pick a config" "✓ done-4" \
           "╭─ GOAL-TITLE" "│ what-it-is line" "▶ 需要你 1 件 · tps 25/40" "异常 1" "#9 卡住 waiter、waiter2" \
           "下一步" "◔ open one" "24 小时：里程碑 +" "等 #9 合入" "起 5"; do
    printf '%s' "$b" | grep -Fq -- "$s" || die "selftest: brief missing '$s'"; done
  for s in "等：" "等 等" "ancient root" "done-1"; do
    ! printf '%s' "$b" | grep -Fq -- "$s" || die "selftest: brief shows '$s'"; done
  printf '%s' "$b" | grep -Eq '[▁▂▃▄▅▆▇█]{3}' || die "selftest: metric sparkline missing"
  bb snapshot | jq -e '.metric.value == 25 and ([.metric.history[].value] == [5, 10, 20, 25])
    and ([.metric.history[].x] == [100, null, null, null])' >/dev/null || die "selftest: metric --at/--step history"
  # readings all in one second give no time-to-target estimate
  bd2=$t/brief2; mkdir -p "$bd2"
  for v in 1 2 3; do AWB_DIR=$bd2 "$BIN" metric he $v 30; done
  AWB_DIR=$bd2 "$BIN" snapshot | jq -e '.metric.eta == null' >/dev/null || die "selftest: an estimate from readings in one second"
  [ "$(printf '%s\n' "$b" | grep -n '^需要你' | cut -d: -f1)" -lt "$(printf '%s\n' "$b" | grep -n '^agent' | cut -d: -f1)" ] \
    || die "selftest: 需要你 not above the agents"

  # single metric indicator under GOAL, render-only (the "#" id keeps it out
  # of the proven fold; `awb state` below proves no agent is created).
  ! "$BIN" render | grep -Fq '▕' || die "selftest: metric bar shown with no metric event"
  "$BIN" metric "tps" 32 40 "V100 target"
  m=$("$BIN" render)
  printf '%s' "$m" | grep -Fq 'tps' || die "selftest: metric name not rendered"
  printf '%s' "$m" | grep -Fq '32 / 40' || die "selftest: metric value/target not rendered"
  printf '%s' "$m" | grep -Fq 'V100 target' || die "selftest: metric note not rendered"
  printf '%s' "$m" | grep -Fq '80%' || die "selftest: metric percent wrong"
  # latest metric wins
  "$BIN" metric "qps" 5 10 second-note
  "$BIN" render | grep -Fq 'qps' || die "selftest: newer metric not shown"
  ! "$BIN" render | grep -Fq 'V100 target' || die "selftest: stale metric still rendered"
  # clamp to 100% and never below 0
  "$BIN" metric over 41 40 x; "$BIN" render | grep -Fq '100%' || die "selftest: metric not clamped at 100"
  "$BIN" metric under 3 0 x; "$BIN" render | grep -Fq ' 3 / 0' || die "selftest: zero-target metric mishandled"
  # value/target must be finite numbers, not tokens jq can't tonumber
  ! "$BIN" metric bad abc 10 2>/dev/null || die "selftest: non-numeric metric value accepted"
  ! "$BIN" metric bad 1.2.3 10 2>/dev/null || die "selftest: '1.2.3' metric value accepted"
  ! "$BIN" metric bad 10 - 2>/dev/null || die "selftest: '-' metric target accepted"
  ! "$BIN" metric bad NaN 10 2>/dev/null || die "selftest: NaN metric value accepted"
  ! "$BIN" metric bad 10 Infinity 2>/dev/null || die "selftest: Infinity metric target accepted"
  # the fold must ignore an unknown event with NO id (used to index .agents[null]
  # and blank the board; now matches Lean parseLine's `_ => none`). A metric has
  # no id and must neither create an agent nor stop a later event applying.
  printf '%s\n' '{"t":"zzz","ep":900000}' >> "$EV"
  "$BIN" render | grep -Fq "SHIP THE WORKBENCH" || die "selftest: unknown no-id event blanked the board"
  _ids=$("$BIN" state | awk '{print $1}' | sort -u | tr '\n' ' ')
  [ "$_ids" = "a1 a2 " ] || die "selftest: unknown event leaked an agent into the fold (got: $_ids)"
  "$BIN" now a1 "post-unknown-still-works"
  AWB_VIEW=full "$BIN" render | grep -Fq "post-unknown-still-works" || die "selftest: events after an unknown no-id event dropped"
  # verified vs self-reported milestones: a1 has one done, none verified yet
  printf '%s' "$brief" | grep -Fq "里程碑 已核 0 / 自报 1" || die "selftest: brief milestone verify/self count wrong"
  printf '%s' "$out" | grep -F "✓ wire event log" | grep -Fq "自报" || die "selftest: unverified done not marked 自报"

  "$BIN" now a1 "gated"
  ! "$BIN" check a1 -- false >/dev/null || die "selftest: failing check accepted"
  AWB_VIEW=full "$BIN" render | grep -Fq "✗1" || die "selftest: rejected check not failed"
  "$BIN" check a1 -- true >/dev/null || die "selftest: passing check rejected"
  AWB_VIEW=full "$BIN" render | grep -Fq "⊢ gated" || die "selftest: verified milestone not marked"
  ! AWB_VIEW=full "$BIN" render | grep -F "⊢ gated" | grep -Fq "自报" || die "selftest: verified milestone wrongly marked 自报"
  ! "$BIN" pr a2 2>/dev/null || die "selftest: pr opened without a passing check"
  "$BIN" start v1 late; "$BIN" now v1 "shipped"; "$BIN" done v1; "$BIN" check v1 -- true >/dev/null
  out=$(AWB_VIEW=full "$BIN" render)
  printf '%s' "$out" | grep -Fq "⊢ shipped" || die "selftest: late check did not verify last milestone"
  ! printf '%s' "$out" | grep -Fq "⊢ milestone" || die "selftest: late check added a phantom milestone"
  # bash 3.2 swallows a following non-ASCII byte into an unbraced variable name: brace them
  ! LC_ALL=C grep -nE '[$][A-Za-z_][A-Za-z0-9_]*[^ -~]' "$BIN" >&2 || die "selftest: unbraced \$var before non-ASCII text"
  # dispatch/report loop (model/tla/AwbLoop.tla)
  "$BIN" start w9 worker
  m=$("$BIN" send w9 "count files"); k=$(printf '%s' "$m" | sed -n '1s/^\[awb w9#\([0-9]*\)\].*/\1/p')
  [ -n "$k" ] || die "selftest: send printed no key"
  ! "$BIN" send w9 "second task" 2>/dev/null || die "selftest: second open task accepted"
  ! "$BIN" reply w9 000 "wrong" 2>/dev/null || die "selftest: reply with a wrong key closed a task"
  "$BIN" idle w9 | grep -q "请汇报" || die "selftest: first idle did not ask"
  "$BIN" reply w9 "$k" "12 files" >/dev/null
  AWB_VIEW=full "$BIN" render | grep -q "✓ 12 files" || die "selftest: keyed reply did not close the task"
  m=$("$BIN" send w9 "held one"); "$BIN" idle w9 >/dev/null; "$BIN" idle w9 | grep -q "^blocked" \
    || die "selftest: second silent idle did not block"
  # races found by model/tla (real concurrent processes)
  "$BIN" start s1 stale; "$BIN" now s1 "m1"
  "$BIN" check s1 -- sleep 1 >/dev/null 2>&1 & sleep 0.4; "$BIN" now s1 "m2"; wait
  AWB_VIEW=full "$BIN" render | grep -q "✗ stale" || die "selftest: check verified a milestone started during it"
  "$BIN" start p1 pair; "$BIN" now p1 "x"
  "$BIN" check p1 -- sleep 1 >/dev/null & "$BIN" check p1 -- sleep 1 >/dev/null & wait
  runs=$(jq -r 'select(.t == "chk" and .id == "p1") | .run' "$EV" | uniq | wc -l | tr -d ' ')
  [ "$runs" = 2 ] || die "selftest: concurrent checks interleaved ($runs run segments)"
  # regressions found by model/AwbModel.lean
  "$BIN" start g1 gatecase; "$BIN" check g1 -- false >/dev/null || true; "$BIN" status g1 done
  AWB_VIEW=full "$BIN" render | grep -q "✗ gatecase" || die "selftest: done overrode a rejected check"
