#!/bin/sh
# awb-lark: mirror every awb board into its own topic of one Lark (Feishu) topic group.
# One board (AWB_DIR) = one topic. The topic's root message is a card showing the board's
# current state, patched in place on every sync: every update lands on that card, nothing
# else is posted. Needs lark-cli with a bot identity in the group.
# The group is set once with `awb-lark setup oc_xxx`; the board -> topic mapping lives in
# $AWB_DIR/lark.json, so it follows the board.
set -eu

PROG=awb-lark
CONF=${XDG_CONFIG_HOME:-$HOME/.config}/awb/lark-chat
AWB_DIR=${AWB_DIR:-$PWD/.awb}
AWB=${AWB:-$(d=$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")"); [ -x "$d/awb" ] && echo "$d/awb" || echo awb)}

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
lark() { lark-cli "$@" --as bot; }

chat() { [ -s "$CONF" ] || die "no group configured: $PROG setup oc_xxx"; cat "$CONF"; }

setup() {
  [ $# -eq 1 ] || die "usage: $PROG setup CHAT_ID"
  command -v lark-cli >/dev/null || die "lark-cli not found"
  case $1 in oc_*) ;; *) die "chat id must start with oc_" ;; esac
  in=$(lark api GET "/open-apis/im/v1/chats/$1/members/is_in_chat" -q '.data.is_in_chat' 2>/dev/null || true)
  if [ "$in" != true ]; then
    # a bot can join a public group by itself; a private one needs a member to add it
    lark api PATCH "/open-apis/im/v1/chats/$1/members/me_join" >/dev/null 2>&1 \
      || die "the bot is not in $1 and cannot join it; add the app's bot to the group, then rerun"
  fi
  mkdir -p "$(dirname "$CONF")"; printf '%s\n' "$1" > "$CONF"
  echo "awb boards will post to $1"
}

# the card, from `awb snapshot` (the same data as the board's brief view)
card() {
  jq -c --arg board "$1" --arg path "$2" '
  def clip($n): if length > $n then .[:$n - 1] + "…" else . end;
  def ago: if . >= 86400 then "\((. / 8640 | floor) / 10) 天" elif . >= 3600 then "\(. / 3600 | floor) 小时"
    else "\(. / 60 | floor) 分钟" end;
  def hms: if . < 3600 then "\(. / 60 | floor) 分" else "\(. / 3600 | floor) 时 \((. % 3600) / 60 | floor) 分" end;
  def grey: "<font color=\"grey\">" + . + "</font>";
  def tile($label; $value; $sub):
    {tag:"column", width:"weighted", weight:1, vertical_spacing:"4px",
     elements:([{tag:"markdown", content:($label | grey), text_size:"notation"},
                {tag:"markdown", content:$value, text_size:"heading-2"}]
               + (if $sub == "" then [] else [{tag:"markdown", content:($sub | grey), text_size:"notation"}] end))};
  def box($bg; $md): {tag:"column_set", background_style:$bg,
    columns:[{tag:"column", width:"weighted", weight:1, padding:"8px 10px", elements:[{tag:"markdown", content:$md}]}]};
  . as $s
  | ($s.need | map(select(.kind == "fail")) | length) as $nfail
  | ([$s.agents[] | select(.status == "running")] | length) as $nrun
  | ([$s.agents[] | select(.status == "blocked")] | length) as $nblk
  | {"done":"✓","wip":"◔","review":"◑","blocked":"▲","todo":"○"} as $TI
  | {schema:"2.0",
     config:{update_multi:true, width_mode:"fill", summary:{content:$s.headline}},
     header:{
       # the title is the goal; which board and how fresh is the subtitle
       title:{tag:"plain_text", content:(if $s.title != "" then ($s.title | clip(60)) else $board end)},
       subtitle:{tag:"plain_text", content:("\($board) · 更新于 " + (if $s.quiet < 60 then "刚刚" else "\($s.quiet | ago)前" end))},
       template:(if $nfail > 0 then "red" elif ($s.need | length) > 0 then "orange" else "blue" end),
       text_tag_list:([{tag:"text_tag", text:{tag:"plain_text", content:"在做 \($nrun)"}, color:"blue"}]
         + (if $nblk > 0 then [{tag:"text_tag", text:{tag:"plain_text", content:"等待 \($nblk)"}, color:"orange"}] else [] end)
         + (if ($s.need | length) > 0 then [{tag:"text_tag", text:{tag:"plain_text", content:"需要你 \($s.need | length)"}, color:"red"}] else [] end))},
     body:{direction:"vertical", padding:"12px 12px 16px 12px", vertical_spacing:"12px", elements:(
       # 1. what it is, then the one-sentence verdict (the focus)
       ([ $s.about[] | {tag:"markdown", content:(. | clip(160) | grey), text_size:"notation"} ])
       + [{tag:"markdown", text_size:"heading-4",
           content:("**" + $s.headline + "**")}]
       # 2. needs you, with how long each has waited
       + (if ($s.need | length) > 0 then
           [box(if $nfail > 0 then "red-50" else "orange-50" end; "**需要你**\n" + ([$s.need[] |
              (if .age then "<font color=\"grey\"> · 已 \(.age | ago)</font>" else "" end) as $ag
              | if .kind == "wait" then "▲ **\(.name)** \(.text)"
                elif .kind == "fail" then "✗ **\(.name)** \(.text | clip(80))\($ag)"
                else "? \(.text | clip(90))\($ag)" end] | join("\n")))]
          else [] end)
       # 3. the goal: the metric, its trend, and the next open steps
       + [{tag:"column_set", flex_mode:"bisect", background_style:"blue-50", horizontal_spacing:"12px",
           columns:(
             (if $s.metric then
                [tile($s.metric.name | clip(20); "**\($s.metric.value)** / \($s.metric.target)";
                      (if $s.metric.eta then "按均速约 \($s.metric.eta | ago)达标（估）" else "" end)),
                 tile("达成"; (if $s.metric.frac then "\($s.metric.frac * 100 | floor)%" else "—" end);
                      (if $s.metric.v0 then "起 \($s.metric.v0) · \($s.metric.since | ago)前" else "" end))]
              else [tile("任务"; "\($s.progress.d) / \($s.progress.t)"; "")] end)
             + [tile("24 小时"; "里程碑 +\($s.day.milestones)";
                     "已核 \($s.day.verified) · 任务 +\($s.day.tasks)"
                     + (if $s.day.metric then " · \(if $s.day.metric >= 0 then "+" else "" end)\($s.day.metric * 100 | round / 100)" else "" end))])}]
       + (if $s.metric and ($s.metric.history | length) >= 2 then
           [{tag:"chart", height:"180px", chart_spec:{
              type:"line",
              data:{values:[$s.metric.history[] | {t:(.ep | strflocaltime("%m-%d %H:%M")), v:.value}]},
              xField:"t", yField:"v", point:{visible:true},
              axes:[{orient:"left", min:0, max:([$s.metric.target, ([$s.metric.history[].value] | max)] | max)}],
              markLine:[{y:$s.metric.target, label:{text:"目标 \($s.metric.target)"}}]}}]
          else [] end)
       + (if ($s.next | length) > 0 then
           [{tag:"markdown", content:("**下一步**\n" + ([$s.next[] | "\($TI[.state] // "•") \(.text | clip(90))"] | join("\n")))}]
          else [] end)
       # 4. what is off
       + (if ($s.anomalies | length) > 0 then
           [box("yellow-50"; "**异常**\n" + ([$s.anomalies[] | "! \(.text | clip(100))"] | join("\n")))]
          else [] end)
       # 5. the rest, folded: every agent, news, the task tree
       + [{tag:"collapsible_panel", expanded:false,
           header:{title:{tag:"markdown", content:("**agent 与进展**　" + ("在做 \($nrun) · 等待 \($nblk) · 空闲 \($s.idle | length) · 已核 \($s.verified.v)/\($s.verified.n)" | grey))}},
           vertical_spacing:"8px",
           elements:(
             (if ($s.agents | length) > 0 then
               [{tag:"markdown", content:([$s.agents[] |
                  ({"running":"◔","blocked":"▲","done":"✓"}[.status] // "•") + " **\(.name)** "
                  + ("\(.age | hms) · ⊢\(.dv)/\(.dn)" | grey) + "　"
                  + (if .flag != "" then "<font color=\"orange\">\(.flag)</font> " else "" end)
                  + (.text | clip(90))] | join("\n"))}]
              else [] end)
             + (if ($s.idle | length) > 0 then [{tag:"markdown", content:("空闲：\($s.idle | map(.name) | join("、"))" | grey), text_size:"notation"}] else [] end)
             + (if ($s.news | length) > 0 then
                 [{tag:"markdown", content:("**最近进展**\n" + ([$s.news[-5:] | reverse[] | ("\(.time[0:5])" | grey) + "　\(.text | clip(100))"] | join("\n")))}]
                else [] end)
             + [ $s.tasks[] | {tag:"markdown", content:(
                 "**\(.text | clip(60))**　\(.d)/\(.t)"
                 + (if .folded > 0 then "\n✓ 另 \(.folded) 项已完成" else "" end)
                 + ([.kids[] | "\n" + ($TI[.state] // "•") + " " + (.text | clip(70)) + (if .prog then "　\(.prog.d)/\(.prog.t)" else "" end)] | join("")))} ]
             + (if $s.tasks_old > 0 then [{tag:"markdown", content:("✓ 另有 \($s.tasks_old) 项已完成" | grey)}] else [] end))}]
       + [{tag:"markdown", content:("\($path)" | grey), text_size:"notation"}])}}'
}


sync() {
  [ -d "$AWB_DIR" ] || die "no board at $AWB_DIR"
  AWB_DIR=$(cd "$AWB_DIR" && pwd); export AWB_DIR
  map=$AWB_DIR/lark.json
  # One sync per board at a time. The lock is a symlink to its holder's pid and is taken
  # over only when that process is gone: breaking it by age let a slow sync and a new one
  # open two topics or patch an older state over a newer one (model/tla/AwbLark.tla).
  # A hung sync is killed by the board's watch loop, which then frees the lock this way.
  lk=$AWB_DIR/lock-lark
  # awb 0.0.7 locked with a directory, and ln -s would link inside it
  if [ -d "$lk" ] && [ ! -L "$lk" ]; then rm -rf "$lk"; fi
  if ! ln -s "$$" "$lk" 2>/dev/null; then
    hp=$(readlink "$lk" 2>/dev/null || true)
    if [ -n "$hp" ] && kill -0 "$hp" 2>/dev/null; then return 0; fi
    rm -rf "$lk"; ln -s "$$" "$lk" 2>/dev/null || return 0
  fi
  trap 'rm -f "$AWB_DIR/lock-lark"' EXIT INT TERM
  snap=$("$AWB" snapshot)
  # topic title: the project directory for ./.awb, else the board directory's own name
  proj=$(basename "$AWB_DIR"); [ "$proj" != .awb ] || proj=$(basename "$(dirname "$AWB_DIR")")
  body=$(printf '%s' "$snap" | card "$proj" "$AWB_DIR")
  [ "${1:-}" = --dry-run ] && { printf '%s\n' "$body"; return 0; }
  command -v lark-cli >/dev/null || die "lark-cli not found"
  c=$(chat)
  st=$( [ -s "$map" ] && cat "$map" || echo '{}')
  # a board moved to another group gets a new topic there
  [ "$(printf '%s' "$st" | jq -r '.chat // ""')" = "$c" ] || st='{}'
  root=$(printf '%s' "$st" | jq -r '.root // ""')
  ep=$(printf '%s' "$st" | jq -r '.card_ep // 0')
  now=$(date +%s)
  # Lark lets a card be patched for 14 days. Before that, the board moves to a new topic and
  # the old card is replaced by a pointer to it; nothing is ever appended to a topic.
  if [ -n "$root" ] && [ $((now - ep)) -ge "${AWB_LARK_ROLL:-1123200}" ]; then
    old=$root; root=
  fi
  if [ -z "$root" ]; then
    # Lark returns the first message for a repeated key, so a send repeated after a sync died
    # before writing lark.json reuses the topic instead of opening a second one
    key=awb-$(printf '%s|%s' "$AWB_DIR" "${old:-first}" | cksum | cut -d' ' -f1)
    root=$(lark im +messages-send --chat-id "$c" --msg-type interactive --content "$body" \
             --idempotency-key "$key" -q '.data.message_id')
    [ -n "$root" ] || die "sending the card failed"
    st=$(jq -n --arg c "$c" --arg r "$root" --argjson ep "$now" '{chat:$c, root:$r, card_ep:$ep}')
    if [ -n "${old:-}" ]; then
      moved=$(jq -nc --arg b "$proj" '{schema:"2.0", header:{title:{tag:"plain_text", content:$b}, template:"grey"},
        body:{elements:[{tag:"markdown", content:"此看板已移到新话题继续更新（飞书卡片 14 天后不能再更新）。"}]}}')
      lark im messages patch --message-id "$old" --data "$(jq -n --arg b "$moved" '{content:$b}')" >/dev/null 2>&1 || true
    fi
  else
    # a failed patch (network, rate limit) fails this sync only; the next one retries the
    # same card, so a glitch never posts anything
    lark im messages patch --message-id "$root" --data "$(jq -n --arg b "$body" '{content:$b}')" >/dev/null \
      || die "patching the card failed; the next sync retries"
  fi
  printf '%s\n' "$st" > "$map.tmp" && mv "$map.tmp" "$map"
}

case "${1:-}" in
  setup) shift; setup "$@" ;;
  sync)  shift; sync "$@" ;;
  watch) while :; do ( sync ) || true; sleep "${AWB_LARK_EVERY:-60}"; done ;;
  where) chat; [ -s "$AWB_DIR/lark.json" ] && cat "$AWB_DIR/lark.json" || echo "no topic yet" ;;
  *) cat <<EOF
$PROG setup CHAT_ID      use this Lark topic group for every board (the bot must be in it)
$PROG sync [--dry-run]   create or update this board's topic (AWB_DIR, default ./.awb);
                         --dry-run prints the card JSON and sends nothing
$PROG watch              sync every AWB_LARK_EVERY seconds (default 60)
$PROG where              the group, and this board's topic mapping
A board started with 'awb board' / 'awb up' syncs by itself once setup has run.
EOF
     [ -z "${1:-}" ] || [ "$1" = -h ] || [ "$1" = --help ] || exit 1 ;;
esac
